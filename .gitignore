# An unpacked Qt source tree in the repository root. Pinned to a root-level
# directory on purpose: git is case-insensitive here (core.ignorecase is true on
# Windows), so a bare `Qt-*` also swallows any file beginning with `qt-`, which
# silently hid cmake/qt6/qt-toolchain-*.cmake from being added at all. The
# tarballs themselves are matched by the qt-everywhere-* rules further down.
/Qt-*/

.claude

# Everything `make download-qt5` / `make download-qt5-macos-sdk` fetch - the Qt source
# archive and the macOS SDK - lands here. See DOWNLOAD_DIR in the Makefile.
# The SDK in particular must never be committed: Apple licenses it for use on
# Apple hardware, and this repository neither ships nor redistributes it.
downloads/

# Locally unpacked upstream source trees used for API research. These are large
# reference inputs, never project sources or distributable build artifacts.
/references/

# The same files in the repository root, from before DOWNLOAD_DIR existed. Kept
# so an older working copy does not suddenly show them as untracked.
qt-everywhere-*.tar.xz
qt-everywhere-*.tar.xz.part
MacOSX*.sdk.tar.*

# Regenerated by `make check-coverage` - derived output, not source.
scripts/tests/coverage-gap.txt
scripts/tests/coverage-gap-qt*.txt
scripts/tests/qt-api-inventory.txt
scripts/tests/qt-api-inventory-qt*.txt
scripts/tests/classes-used-by-examples.txt
scripts/tests/classes-used-by-examples-qt*.txt
scripts/tests/classes-not-covered.txt
scripts/tests/classes-not-covered-qt*.txt

# Progress notes and captured output from ad-hoc build/run batches. Useful while
# a long queue is running, of no value afterwards.
*-summary.txt
smoke-*.log
overnight-status.txt
migrate-status.txt
night-status.txt
qt6-status.txt


# Captured output from ad-hoc qt4-selftest runs, the Qt 4 counterpart of the
# smoke-*.log rule above. The numbers that matter are recorded in
# docs/platforms.md; the raw capture is scratch.
qt4-selftest-*.txt
probe-*.log
qt5-size-before.txt
qt5-win-before.txt

# Per-machine host list for scripts/run/run.py (addresses, keys, VM paths).
scripts/run/hosts.local.json
