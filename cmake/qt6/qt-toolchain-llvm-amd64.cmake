# CMake toolchain file for Qt 6 cross-compilation
# Target: Windows x86_64 (x86_64-w64-mingw32)
# Host: Linux x86_64
# Toolchain: LLVM-MinGW (Clang/LLVM)

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

# LLVM-MinGW toolchain paths
set(LLVM_MINGW_ROOT "/opt/llvm-mingw")
set(TOOLCHAIN_PREFIX x86_64-w64-mingw32)

set(CMAKE_C_COMPILER ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-clang)
set(CMAKE_CXX_COMPILER ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-clang++)
set(CMAKE_RC_COMPILER ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-windres)

set(CMAKE_AR ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-ar)
set(CMAKE_RANLIB ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-ranlib)
set(CMAKE_STRIP ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-strip)
set(CMAKE_NM ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-nm)
set(CMAKE_OBJCOPY ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-objcopy)
set(CMAKE_OBJDUMP ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-objdump)
set(CMAKE_LINKER ${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-ld)

# Target libraries and headers: LLVM-MinGW's and the installed Qt's.
set(CMAKE_FIND_ROOT_PATH ${LLVM_MINGW_ROOT} /opt/qt6-amd64)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Qt specific settings for x86_64
set(QT_COMPILER_FLAGS "-march=x86-64")
set(QT_COMPILER_FLAGS_RELEASE "-O2 -DNDEBUG")
set(QT_LINKER_FLAGS "-static-libgcc -static-libstdc++")

set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${QT_COMPILER_FLAGS}")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${QT_COMPILER_FLAGS}")
set(CMAKE_C_FLAGS_RELEASE "${QT_COMPILER_FLAGS_RELEASE}")
set(CMAKE_CXX_FLAGS_RELEASE "${QT_COMPILER_FLAGS_RELEASE}")
set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${QT_LINKER_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} ${QT_LINKER_FLAGS}")

# Disable checks that fail during cross-compilation
set(CMAKE_CROSSCOMPILING_EMULATOR "")
set(QT_FORCE_FIND_TOOLS ON)

# MinGW specific
set(MINGW TRUE)
set(WIN32 TRUE)
