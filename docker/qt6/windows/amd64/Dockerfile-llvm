# The Windows Qt SDK already uses LLVM-MinGW 19 (MSVCRT, Windows 7).
# This consumer profile adds tools for source-built C++20/23 applications.
ARG QT6_WINDOWS_BASE_IMAGE=qt6-win-amd64
FROM ${QT6_WINDOWS_BASE_IMAGE}

ARG APT_SNAPSHOT=20261019T000000Z
COPY scripts/build/apt-snapshot.sh /usr/local/bin/apt-snapshot
RUN sh /usr/local/bin/apt-snapshot "${APT_SNAPSHOT}" && \
    apt-get update && apt-get install -y --no-install-recommends \
        git python3 build-essential ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Use the existing pinned Kitware binary, not a new CMake source build.
RUN --mount=type=bind,source=downloads/cmake-3.28.6-linux-x86_64.tar.gz,target=/tmp/cmake.tar.gz \
    echo '931e3c0d546ee03ca72bb147ccd9b49e3b6252f765f66bf21b9d165519940458  /tmp/cmake.tar.gz' | sha256sum -c - && \
    mkdir /opt/cmake-3.28.6 && \
    tar -xzf /tmp/cmake.tar.gz -C /opt/cmake-3.28.6 --strip-components=1

ENV PATH=/opt/cmake-3.28.6/bin:${PATH}
WORKDIR /workspace
CMD ["sh", "-c", "cmake --version | head -1; x86_64-w64-mingw32-clang++ --version | head -1"]
