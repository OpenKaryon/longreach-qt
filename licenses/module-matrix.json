{
  "schema": 1,
  "profiles": {
    "lgpl-friendly": {
      "description": "Excludes Qt modules whose open-source option is GPL-only.",
      "maximum_copyleft": "LGPL",
      "proprietary_application_possible": true
    },
    "gpl-enabled": {
      "description": "Includes GPL-only Qt add-ons; a linked application must be GPL-compatible unless covered by a commercial Qt license.",
      "maximum_copyleft": "GPL-3.0",
      "proprietary_application_possible": false
    },
    "commercial-qt": {
      "description": "Module availability matches gpl-enabled, but downstream rights come from the user's commercial Qt agreement, not from this repository.",
