+static inline int posix_memalign(void **result, size_t alignment, size_t size)
+{
+    if (alignment < sizeof(void *) || alignment % sizeof(void *) != 0 ||
+        (alignment & (alignment - 1)) != 0)
+        return EINVAL;
+
+    const int saved_errno = errno;
+    void *pointer = memalign(alignment, size == 0 ? 1 : size);
+    errno = saved_errno;
+    if (!pointer)
+        return ENOMEM;
+
+    *result = pointer;
+    return 0;
+}
