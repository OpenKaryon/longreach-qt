# Sarge amd64 exports the same locale conversions under their older names.
--- a/libcxx/include/__locale_dir/support/linux.h
+++ b/libcxx/include/__locale_dir/support/linux.h
@@ -95,7 +95,14 @@
 }
 
+#if defined(LONGREACH_SARGE) && defined(__x86_64__)
+extern "C" long long __strtoll_l(const char*, char**, int, locale_t);
+extern "C" unsigned long long __strtoull_l(const char*, char**, int, locale_t);
+#endif
+
 inline _LIBCPP_HIDE_FROM_ABI long long __strtoll(const char* __nptr, char** __endptr, int __base, __locale_t __loc) {
-#if !_LIBCPP_HAS_MUSL_LIBC
+#if defined(LONGREACH_SARGE) && defined(__x86_64__)
+  return __strtoll_l(__nptr, __endptr, __base, __loc);
+#elif !_LIBCPP_HAS_MUSL_LIBC
   return ::strtoll_l(__nptr, __endptr, __base, __loc);
 #else
   (void)__loc;
@@ -105,7 +112,9 @@
 
 inline _LIBCPP_HIDE_FROM_ABI unsigned long long
 __strtoull(const char* __nptr, char** __endptr, int __base, __locale_t __loc) {
-#if !_LIBCPP_HAS_MUSL_LIBC
+#if defined(LONGREACH_SARGE) && defined(__x86_64__)
+  return __strtoull_l(__nptr, __endptr, __base, __loc);
+#elif !_LIBCPP_HAS_MUSL_LIBC
   return ::strtoull_l(__nptr, __endptr, __base, __loc);
 #else
   (void)__loc;
