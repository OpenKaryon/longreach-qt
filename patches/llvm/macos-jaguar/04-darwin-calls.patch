--- a/llvm/lib/Target/PowerPC/PPCAsmPrinter.cpp
+++ b/llvm/lib/Target/PowerPC/PPCAsmPrinter.cpp
@@ -214,6 +214,8 @@
 };
 
 class PPCDarwinAsmPrinter : public PPCAsmPrinter {
+  SmallSetVector<const MCSymbol *, 8> Stubs;
+
 public:
   static char ID;
 
@@ -222,5 +224,55 @@
 
   StringRef getPassName() const override {
     return "Darwin PowerPC Assembly Printer";
+  }
+
+  void emitInstruction(const MachineInstr *MI) override {
+    unsigned Opcode = MI->getOpcode();
+    if (Opcode != PPC::BL && Opcode != PPC::BL_RM &&
+        Opcode != PPC::TAILB) {
+      PPCAsmPrinter::emitInstruction(MI);
+      return;
+    }
+
+    const MachineOperand &Target = MI->getOperand(0);
+    const MCSymbol *Symbol = nullptr;
+    if (Target.isGlobal() && Target.getGlobal()->isDeclarationForLinker())
+      Symbol = getSymbol(Target.getGlobal());
+    else if (Target.isSymbol())
+      Symbol = GetExternalSymbolSymbol(Target.getSymbolName());
+
+    if (!Symbol) {
+      PPCAsmPrinter::emitInstruction(MI);
+      return;
+    }
+
+    Stubs.insert(Symbol);
+    MCSymbol *Stub = OutContext.getOrCreateSymbol(
+        Twine("L") + Symbol->getName() + "$stub");
+    EmitToStreamer(*OutStreamer,
+                   MCInstBuilder(Opcode == PPC::TAILB ? PPC::B : PPC::BL)
+                       .addExpr(MCSymbolRefExpr::create(Stub, OutContext)));
+  }
+
+  void emitEndOfAsmFile(Module &M) override {
+    for (const MCSymbol *Symbol : Stubs) {
+      StringRef Name = Symbol->getName();
+      std::string Prefix = (Twine("L") + Name).str();
+      std::string Body;
+      raw_string_ostream OS(Body);
+      OS << "\t.section __TEXT,__picsymbolstub1,symbol_stubs,pure_instructions,32\n"
+         << "\t.align 5\n" << Prefix << "$stub:\n"
+         << "\t.indirect_symbol " << Name << "\n"
+         << "\tmflr r0\n\tbcl 20,31," << Prefix << "$pb\n"
+         << Prefix << "$pb:\n\tmflr r11\n"
+         << "\taddis r11,r11,ha16(" << Prefix << "$lazy_ptr-" << Prefix << "$pb)\n"
+         << "\tmtlr r0\n\tlwzu r12,lo16(" << Prefix << "$lazy_ptr-"
+         << Prefix << "$pb)(r11)\n\tmtctr r12\n\tbctr\n"
+         << "\t.lazy_symbol_pointer\n" << Prefix << "$lazy_ptr:\n"
+         << "\t.indirect_symbol " << Name << "\n"
+         << "\t.long dyld_stub_binding_helper\n";
+      OutStreamer->emitRawText(OS.str());
+    }
+    PPCAsmPrinter::emitEndOfAsmFile(M);
   }
 };
