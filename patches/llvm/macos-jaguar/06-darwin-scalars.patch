+static bool CC_PPC32_DarwinScalar(unsigned ValNo, MVT ValVT, MVT LocVT,
+                                  CCValAssign::LocInfo LocInfo,
+                                  ISD::ArgFlagsTy ArgFlags, CCState &State) {
+  static const MCPhysReg GPRs[] = {PPC::R3, PPC::R4, PPC::R5, PPC::R6,
+                                 PPC::R7, PPC::R8, PPC::R9, PPC::R10};
+  static const MCPhysReg FPRs[] = {PPC::F1, PPC::F2,  PPC::F3,  PPC::F4,
+                                 PPC::F5, PPC::F6,  PPC::F7,  PPC::F8,
+                                 PPC::F9, PPC::F10, PPC::F11, PPC::F12,
+                                 PPC::F13};
+
+  if (LocVT == MVT::i1) {
+    LocVT = MVT::i32;
+    LocInfo = ArgFlags.isSExt() ? CCValAssign::SExt : CCValAssign::ZExt;
+  }
+  if (LocVT != MVT::i32 && LocVT != MVT::f32 && LocVT != MVT::f64)
+    return CC_PPC32_SVR4(ValNo, ValVT, LocVT, LocInfo, ArgFlags, State);
+
+  // Darwin numbers the GPRs by argument word, even when a fixed floating-point
+  // argument is passed in an FPR. A split i64 uses two consecutive words.
+  unsigned Size = LocVT == MVT::f64 ? 8 : 4;
+  unsigned Offset = State.AllocateStack(Size, Align(4));
+  MCRegister Reg = State.AllocateReg(GPRs);
+  if (LocVT != MVT::i32) {
+    if (Size == 8)
+      State.AllocateReg(GPRs);
+    Reg = State.AllocateReg(FPRs);
+  }
+
+  if (Reg)
+    State.addLoc(CCValAssign::getReg(ValNo, ValVT, Reg, LocVT, LocInfo));
+  else
+    State.addLoc(CCValAssign::getMem(ValNo, ValVT, Offset, LocVT, LocInfo));
+  return false;
+}
