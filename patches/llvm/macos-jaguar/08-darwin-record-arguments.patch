+
+ABIArgInfo PPC32_SVR4_ABIInfo::classifyArgumentType(QualType Ty) const {
+  if (getTarget().getTriple().isOSDarwin() && Ty->isRecordType() &&
+      !getRecordArgABI(Ty, getCXXABI())) {
+    uint64_t Size = getContext().getTypeSize(Ty);
+    // Trivial aggregates of whole words use the same argument slots as
+    // integers. Keep partial words and specially aligned types separate.
+    if (Size && Size % 32 == 0 &&
+        getContext().getTypeAlignInChars(Ty).getQuantity() <= 4 &&
+        !isSingleElementStruct(Ty, getContext()))
+      return ABIArgInfo::getDirect(
+          llvm::ArrayType::get(llvm::Type::getInt32Ty(getVMContext()), Size / 32));
+  }
+  return DefaultABIInfo::classifyArgumentType(Ty);
 }
 
