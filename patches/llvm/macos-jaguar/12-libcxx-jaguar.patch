+static steady_clock::time_point __libcpp_steady_clock_now() {
+  static const mach_timebase_info_data_t scale = [] {
+    mach_timebase_info_data_t value{};
+    if (mach_timebase_info(&value) != KERN_SUCCESS || value.denom == 0)
+      std::__throw_system_error(EINVAL, "mach_timebase_info failed");
+    return value;
+  }();
+  const uint64_t ticks = mach_absolute_time();
+  const uint64_t ns = (ticks / scale.denom) * scale.numer +
+                      ((ticks % scale.denom) * scale.numer) / scale.denom;
+  return steady_clock::time_point(nanoseconds(ns));
+}
