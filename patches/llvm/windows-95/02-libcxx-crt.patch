+#if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+static pthread_mutex_t locale_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+__locale_guard::__locale_guard(const __locale_t& loc) {
+  if (pthread_mutex_lock(&locale_mutex) != 0)
+    std::abort();
+  const char* name = loc.__get_locale();
+  const char* current = ::setlocale(LC_ALL, nullptr);
+  if (!name || (current && std::strcmp(current, name) == 0))
+    return;
+  __previous = current ? ::_strdup(current) : nullptr;
+  if (!__previous || !::setlocale(LC_ALL, name)) {
+    ::free(__previous);
+    pthread_mutex_unlock(&locale_mutex);
+    std::__throw_bad_alloc();
+  }
+}
+
+__locale_guard::~__locale_guard() {
+  if (__previous) {
+    if (!::setlocale(LC_ALL, __previous))
+      std::abort();
+    ::free(__previous);
+  }
+  pthread_mutex_unlock(&locale_mutex);
+}
