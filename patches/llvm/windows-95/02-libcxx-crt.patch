 // FIXME: base and mask currently unused. Needs manual work to construct the new locale
 __locale_t __newlocale(int /*mask*/, const char* locale, __locale_t /*base*/) {
+#if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+  if (pthread_mutex_lock(&locale_mutex) != 0)
+    std::abort();
+  const char* current = ::setlocale(LC_ALL, nullptr);
+  char* saved = current ? ::_strdup(current) : nullptr;
+  char* copy = nullptr;
+  if (saved) {
+    const char* selected = ::setlocale(LC_ALL, locale);
+    if (selected)
+      copy = ::_strdup(selected);
+    if (!::setlocale(LC_ALL, saved))
+      std::abort();
+    ::free(saved);
+  }
+  pthread_mutex_unlock(&locale_mutex);
+  return {reinterpret_cast<::_locale_t>(copy), copy};
+#else
   return {::_create_locale(LC_ALL, locale), locale};
+#endif
