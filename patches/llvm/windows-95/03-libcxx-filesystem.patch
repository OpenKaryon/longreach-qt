# Use ANSI directory queries and preserve Win95 filesystem errors.
--- a/libcxx/src/filesystem/posix_compat.h
+++ b/libcxx/src/filesystem/posix_compat.h
@@ -123,6 +123,23 @@
 
 #  define O_NONBLOCK 0
 
+#if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+inline bool win95_ansi_path(const wchar_t* path, char (&out)[MAX_PATH]) {
+  BOOL substituted = FALSE;
+  const UINT codepage = AreFileApisANSI() ? CP_ACP : CP_OEMCP;
+  wchar_t roundtrip[MAX_PATH];
+  const int size = WideCharToMultiByte(codepage, 0, path, -1, out, MAX_PATH, nullptr, &substituted);
+  if (!size)
+    return false;
+  if (substituted || !MultiByteToWideChar(codepage, 0, out, size, roundtrip, MAX_PATH) ||
+      wcscmp(roundtrip, path) != 0) {
+    SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+    return false;
+  }
+  return true;
+}
+#endif
+
