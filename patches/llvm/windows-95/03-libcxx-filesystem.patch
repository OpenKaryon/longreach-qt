 inline int stat_file(const wchar_t* path, StatT* buf, DWORD flags) {
+#if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+  (void)flags;
+  char ansi[MAX_PATH];
+  if (!win95_ansi_path(path, ansi))
+    return -1;
+  const DWORD attributes = GetFileAttributesA(ansi);
+  if (attributes == INVALID_FILE_ATTRIBUTES)
+    return -1;
+  if (attributes & FILE_ATTRIBUTE_DIRECTORY) {
+    memset(buf, 0, sizeof(*buf));
+    buf->st_mode = _S_IFDIR | 0555;
+    if (!(attributes & FILE_ATTRIBUTE_READONLY))
+      buf->st_mode |= 0222;
+    return 0;
+  }
+  HANDLE handle = CreateFileA(ansi, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                              nullptr, OPEN_EXISTING, 0, nullptr);
+  if (handle == INVALID_HANDLE_VALUE)
+    return -1;
+  const int result = stat_handle(handle, buf);
+  const DWORD error = result ? GetLastError() : NO_ERROR;
+  CloseHandle(handle);
+  if (result)
+    SetLastError(error);
+  return result;
+#else
   WinHandle h(path, FILE_READ_ATTRIBUTES, flags);
   if (!h)
     return -1;
   int ret = stat_handle(h, buf);
   return ret;
+#endif
 }
 
 inline int stat(const wchar_t* path, StatT* buf) { return stat_file(path, buf, 0); }
