 inline int rename(const wchar_t* from, const wchar_t* to) {
+#if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+  char ansi_from[MAX_PATH], ansi_to[MAX_PATH];
+  if (!std::__win95::__ansi_path(from, ansi_from) || !std::__win95::__ansi_path(to, ansi_to))
+    return -1;
+  if (MoveFileExA(ansi_from, ansi_to, MOVEFILE_COPY_ALLOWED | MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+    return 0;
+  // Win95's MoveFileExA is a stub. MoveFileA can rename to a free path.
+  // Preserve an existing destination if the OS cannot replace it atomically.
+  if (GetLastError() == ERROR_CALL_NOT_IMPLEMENTED && MoveFileA(ansi_from, ansi_to))
+    return 0;
+  return -1;
+#else
   if (!(MoveFileExW(from, to, MOVEFILE_COPY_ALLOWED | MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)))
     return -1;
   return 0;
+#endif
 }
 
