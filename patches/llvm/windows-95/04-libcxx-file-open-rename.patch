--- /dev/null
+++ b/libcxx/src/support/win32/win95_path.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (C) 2026 OpenKaryon
+
+#ifndef LIBCXX_SUPPORT_WIN32_WIN95_PATH_H
+#define LIBCXX_SUPPORT_WIN32_WIN95_PATH_H
+
+#include <__config>
+#include <windows.h>
+#include <wchar.h>
+
+_LIBCPP_BEGIN_NAMESPACE_STD
+namespace __win95 {
+inline bool __ansi_path(const wchar_t* path, char (&out)[MAX_PATH], UINT codepage) {
+  BOOL substituted = FALSE;
+  wchar_t roundtrip[MAX_PATH];
+  const int size = WideCharToMultiByte(codepage, 0, path, -1, out, MAX_PATH, nullptr, &substituted);
+  if (!size)
+    return false;
+  if (substituted || !MultiByteToWideChar(codepage, 0, out, size, roundtrip, MAX_PATH) ||
+      wcscmp(roundtrip, path) != 0) {
+    SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+    return false;
+  }
+  return true;
+}
+inline bool __ansi_path(const wchar_t* path, char (&out)[MAX_PATH]) {
+  return __ansi_path(path, out, AreFileApisANSI() ? CP_ACP : CP_OEMCP);
+}
+} // namespace __win95
+_LIBCPP_END_NAMESPACE_STD
+
+#endif // LIBCXX_SUPPORT_WIN32_WIN95_PATH_H
