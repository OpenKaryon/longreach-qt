 #if defined(_LIBCPP_WIN32API)
+
+#  if defined(__MINGW32__) && _WIN32_WINNT == 0x0400
+_LIBCPP_EXPORTED_FROM_ABI FILE* __win95_filebuf_open(const wchar_t* path, const char* mode) {
+  char ansi[MAX_PATH];
+  if (!std::__win95::__ansi_path(path, ansi, CP_ACP)) {
+    errno = GetLastError() == ERROR_INSUFFICIENT_BUFFER ? ENAMETOOLONG : EILSEQ;
+    return nullptr;
+  }
+  return fopen(ansi, mode);
+}
+#  endif
 
