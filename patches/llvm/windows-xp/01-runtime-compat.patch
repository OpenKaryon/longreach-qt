+#  if defined(__MINGW32__) && _WIN32_WINNT < 0x0600
+  // XP filesystem probe: keep the same file identity as the Vista branch.
+  BY_HANDLE_FILE_INFORMATION info;
+  if (!GetFileInformationByHandle(h, &info))
+    return -1;
+  memset(buf, 0, sizeof(*buf));
+  LARGE_INTEGER mtime, atime;
+  mtime.LowPart = info.ftLastWriteTime.dwLowDateTime;
+  mtime.HighPart = info.ftLastWriteTime.dwHighDateTime;
+  atime.LowPart = info.ftLastAccessTime.dwLowDateTime;
+  atime.HighPart = info.ftLastAccessTime.dwHighDateTime;
+  buf->st_mtim = filetime_to_timespec(mtime);
+  buf->st_atim = filetime_to_timespec(atime);
+  buf->st_mode = (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? _S_IFDIR | 0555 : _S_IFREG | 0555;
+  if (!(info.dwFileAttributes & FILE_ATTRIBUTE_READONLY))
+    buf->st_mode |= 0222;
+  if (info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {
+    alignas(DWORD) unsigned char reparse[MAXIMUM_REPARSE_DATA_BUFFER_SIZE];
+    DWORD length;
+    if (!DeviceIoControl(h, FSCTL_GET_REPARSE_POINT, nullptr, 0, reparse, sizeof(reparse), &length, nullptr))
+      return -1;
+    DWORD tag;
+    if (length < sizeof(tag)) {
+      SetLastError(ERROR_INVALID_DATA);
+      return -1;
+    }
+    memcpy(&tag, reparse, sizeof(tag));
+    if (tag == IO_REPARSE_TAG_SYMLINK)
+      buf->st_mode = (buf->st_mode & ~_S_IFMT) | _S_IFLNK;
+  }
+  buf->st_nlink = info.nNumberOfLinks;
+  buf->st_size = (uint64_t(info.nFileSizeHigh) << 32) | info.nFileSizeLow;
+  buf->st_dev = info.dwVolumeSerialNumber;
+  memcpy(&buf->st_ino.id[0], &info.nFileIndexHigh, 4);
+  memcpy(&buf->st_ino.id[4], &info.nFileIndexLow, 4);
+  return 0;
