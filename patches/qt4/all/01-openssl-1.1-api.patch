+// The accessors 1.1.0 introduced for the structs it made opaque.
+//
+// Direct macros rather than entries in Qt's resolved-symbol table, and
+// only for the linked build. Qt 4 has two ways of reaching OpenSSL: this
+// one, where every q_ name is a thin wrapper the compiler binds
+// directly, and a dlopen path where each is a function pointer filled in
+// by q_resolveOpenSslSymbols(). Covering the second means an ordinal per
+// symbol for the Windows resolver, which is version-specific data this
+// patch has no way to supply correctly.
+//
+// So the dlopen path is deliberately not ported. Building Qt 4 against
+// OpenSSL 1.1+ without -openssl-linked fails at compile time on these
+// names being undeclared, which is a loud and accurate way to say the
+// combination is unimplemented - far better than resolving to null
+// pointers and crashing on the first handshake. This kit always links.
+#if OPENSSL_VERSION_NUMBER >= 0x10100000L && defined(QT_LINKED_OPENSSL)
+#define q_X509_get_version(x)          X509_get_version(x)
+#define q_X509_get_serialNumber(x)     X509_get_serialNumber(x)
+#define q_X509_get_X509_PUBKEY(x)      X509_get_X509_PUBKEY(x)
+#define q_EVP_PKEY_base_id(k)          EVP_PKEY_base_id(k)
+#define q_RSA_bits(r)                  RSA_bits(r)
+#define q_DSA_bits(d)                  DSA_bits(d)
+#define q_SSL_CIPHER_get_bits(c, a)    SSL_CIPHER_get_bits((c), (a))
+#define q_SSL_CTX_get_cert_store(c)    SSL_CTX_get_cert_store(c)
+#endif
 #define q_SKM_sk_num(type, st) ((int (*)(const STACK_OF(type) *))q_sk_num)(st)
 #define q_SKM_sk_value(type, st,i) ((type * (*)(const STACK_OF(type) *, int))q_sk_value)(st, i)
 #define q_sk_GENERAL_NAME_num(st) q_SKM_sk_num(GENERAL_NAME, (st))
