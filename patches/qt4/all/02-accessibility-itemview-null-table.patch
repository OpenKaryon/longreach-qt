# Qt 4.8.7 / X11: accessibility activation may return a generic widget interface
# without QAccessibleTable2Interface (for example in a static SDK without a
# specialized accessibility plugin). Check both interfaces before notifying
# table changes and release the queried interface. Keep accessibility enabled.
--- a/src/gui/itemviews/qabstractitemview.cpp
+++ b/src/gui/itemviews/qabstractitemview.cpp
@@ -1066,7 +1066,11 @@
 #ifndef QT_NO_ACCESSIBILITY
 #ifdef Q_WS_X11
     if (QAccessible::isActive()) {
-        QAccessible::queryAccessibleInterface(this)->table2Interface()->modelReset();
+        QAccessibleInterface *accessible = QAccessible::queryAccessibleInterface(this);
+        QAccessibleTable2Interface *table = accessible ? accessible->table2Interface() : 0;
+        if (table)
+            table->modelReset();
+        delete accessible;
         QAccessible::updateAccessibility(this, 0, QAccessible::TableModelChanged);
     }
 #endif
@@ -3293,7 +3297,11 @@
 #ifndef QT_NO_ACCESSIBILITY
 #ifdef Q_WS_X11
     if (QAccessible::isActive()) {
-        QAccessible::queryAccessibleInterface(q)->table2Interface()->rowsRemoved(index, start, end);
+        QAccessibleInterface *accessible = QAccessible::queryAccessibleInterface(q);
+        QAccessibleTable2Interface *table = accessible ? accessible->table2Interface() : 0;
+        if (table)
+            table->rowsRemoved(index, start, end);
+        delete accessible;
         QAccessible::updateAccessibility(q, 0, QAccessible::TableModelChanged);
     }
 #endif
@@ -3373,7 +3381,11 @@
 #ifndef QT_NO_ACCESSIBILITY
 #ifdef Q_WS_X11
