 #ifndef QT_NO_ACCESSIBILITY
 #ifdef Q_WS_X11
     if (QAccessible::isActive()) {
-        QAccessible::queryAccessibleInterface(q)->table2Interface()->columnsInserted(index, start, end);
+        QAccessibleInterface *accessible = QAccessible::queryAccessibleInterface(q);
+        QAccessibleTable2Interface *table = accessible ? accessible->table2Interface() : 0;
+        if (table)
+            table->columnsInserted(index, start, end);
+        delete accessible;
         QAccessible::updateAccessibility(q, 0, QAccessible::TableModelChanged);
     }
 #endif
@@ -3448,7 +3468,11 @@
 #ifdef Q_WS_X11
     Q_Q(QAbstractItemView);
     if (QAccessible::isActive()) {
-        QAccessible::queryAccessibleInterface(q)->table2Interface()->modelReset();
+        QAccessibleInterface *accessible = QAccessible::queryAccessibleInterface(q);
