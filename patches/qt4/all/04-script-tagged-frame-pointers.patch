#
# Qt 4: keep tagged JavaScriptCore frame pointers out of member calls.
#
# Host frame links have bit zero set; noCaller() is the pointer value 1.
# Calling a member on such a pointer promises an aligned, non-null `this`
# to modern clang. At -Os it folds hasHostCallFrameFlag() to false and
# removeHostCallFrameFlag() to the identity. Exception unwinding then reads
# a host frame's null CodeBlock, and debugger GC can dereference sentinel 1.
#
# Tiger i386 evidence: script-gallery crashes at reparseForExceptionInfo
# reading null+0xb4, called from throwException's handler search. The binary
# has no bit test between loading callerFrame and its CodeBlock. Separately,
# scripttools-gallery dereferences 1-56 in QScriptEnginePrivate::mark().
#
# Static helpers perform integer operations on the raw pointer before any
# member call. Update every internal caller and reject noCaller() at the
# QtScript context boundary. No architecture/OS guard or disabled feature.
--- a/src/3rdparty/javascriptcore/JavaScriptCore/interpreter/CallFrame.h
+++ b/src/3rdparty/javascriptcore/JavaScriptCore/interpreter/CallFrame.h
@@ -135,9 +135,12 @@
         static CallFrame* noCaller() { return reinterpret_cast<CallFrame*>(HostCallFrameFlag); }
         int returnValueRegister() const { return this[RegisterFile::ReturnValueRegister].i(); }
 
-        bool hasHostCallFrameFlag() const { return reinterpret_cast<intptr_t>(this) & HostCallFrameFlag; }
-        CallFrame* addHostCallFrameFlag() const { return reinterpret_cast<CallFrame*>(reinterpret_cast<intptr_t>(this) | HostCallFrameFlag); }
-        CallFrame* removeHostCallFrameFlag() { return reinterpret_cast<CallFrame*>(reinterpret_cast<intptr_t>(this) & ~HostCallFrameFlag); }
+        // A host frame link is tagged, not an aligned ExecState object.
+        // Do not pass it as `this`: clang can otherwise fold away the bit
+        // test/mask using the implicit alignment of a member call.
+        static bool hasHostCallFrameFlag(const CallFrame* frame) { return reinterpret_cast<intptr_t>(frame) & HostCallFrameFlag; }
+        static CallFrame* addHostCallFrameFlag(const CallFrame* frame) { return reinterpret_cast<CallFrame*>(reinterpret_cast<intptr_t>(frame) | HostCallFrameFlag); }
+        static CallFrame* removeHostCallFrameFlag(CallFrame* frame) { return reinterpret_cast<CallFrame*>(reinterpret_cast<intptr_t>(frame) & ~HostCallFrameFlag); }
 
     private:
         void setArgumentCount(int count) { static_cast<Register*>(this)[RegisterFile::ArgumentCount] = Register::withInt(count); }
