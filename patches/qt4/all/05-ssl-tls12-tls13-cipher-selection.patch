#
# Qt 4 SSL with OpenSSL 1.1/3: map TLS 1.1-1.3 ciphers to QSsl::TlsV1, so
# setCiphers() can select them by name, and pass TLS 1.3 suites to their own
# call (SSL_CTX_set_ciphersuites); a selection without them limits the
# connection to TLS 1.2. Found by the TLS checks on every distribution.
#
--- a/src/network/ssl/qsslsocket_openssl.cpp
+++ b/src/network/ssl/qsslsocket_openssl.cpp
@@ -213,6 +213,11 @@
             ciph.d->protocol = QSsl::SslV2;
         else if (protoString == QLatin1String("TLSv1"))
             ciph.d->protocol = QSsl::TlsV1;
+        // Qt 4 has no enum values for the TLS versions after 1.0; without this,
+        // setCiphers() cannot select a TLS 1.2 or 1.3 cipher by name.
+        else if (protoString == QLatin1String("TLSv1.1") || protoString == QLatin1String("TLSv1.2")
+                 || protoString == QLatin1String("TLSv1.3"))
+            ciph.d->protocol = QSsl::TlsV1;
 
         if (descriptionList.at(2).startsWith(QLatin1String("Kx=")))
             ciph.d->keyExchangeMethod = descriptionList.at(2).mid(3);
@@ -333,7 +338,21 @@
     QList<QSslCipher> ciphers = configuration.ciphers;
     if (ciphers.isEmpty())
         ciphers = defaultCiphers();
+#if OPENSSL_VERSION_NUMBER >= 0x10101000L
+    // OpenSSL 1.1.1 configures the TLS 1.3 suites apart from the cipher list,
+    // which no longer restricts them. Each part goes to its own call, and a
+    // selection without TLS 1.3 suites limits the connection to TLS 1.2.
+    QByteArray tls13String;
+#endif
     foreach (const QSslCipher &cipher, ciphers) {
+#if OPENSSL_VERSION_NUMBER >= 0x10101000L
+        if (cipher.protocolString() == QLatin1String("TLSv1.3")) {
+            if (!tls13String.isEmpty())
+                tls13String.append(':');
+            tls13String.append(cipher.name().toLatin1());
+            continue;
+        }
+#endif
         if (first)
             first = false;
         else
@@ -341,7 +360,20 @@
         cipherString.append(cipher.name().toLatin1());
     }
 
+#if OPENSSL_VERSION_NUMBER >= 0x10101000L
+    // OpenSSL does not leave TLS 1.3 out by itself when no TLS 1.3 suite is
+    // left; the handshake then fails with "no ciphers available".
+    bool ciphersAccepted = tls13String.isEmpty()
+        ? SSL_CTX_set_max_proto_version(ctx, TLS1_2_VERSION)
+        : SSL_CTX_set_ciphersuites(ctx, tls13String.constData());
+    if (ciphersAccepted && cipherString.isEmpty() && !tls13String.isEmpty())
+        ciphersAccepted = SSL_CTX_set_min_proto_version(ctx, TLS1_3_VERSION);
+    else if (ciphersAccepted)
+        ciphersAccepted = q_SSL_CTX_set_cipher_list(ctx, cipherString.data());
+    if (!ciphersAccepted) {
+#else
     if (!q_SSL_CTX_set_cipher_list(ctx, cipherString.data())) {
+#endif
         // ### Bad error code
         q->setErrorString(QSslSocket::tr("Invalid or empty cipher list (%1)").arg(getErrorsFromOpenSsl()));
         q->setSocketError(QAbstractSocket::UnknownSocketError);
