-    return QStringList();
+    // The minimal backend does not read Android's system font aliases.
+    // Generic Helvetica/Times/monospace requests must not fall through to
+    // the first registered family (for example the digits-only Clockopia).
+    QStringList families;
+    if (styleHint == QFont::Times || styleHint == QFont::Serif)
+        families << QLatin1String("Noto Serif") << QLatin1String("Droid Serif");
+    else if (styleHint == QFont::Courier || styleHint == QFont::Monospace)
+        families << QLatin1String("Droid Sans Mono");
+    families << QLatin1String("Roboto") << QLatin1String("Droid Sans");
+    return families;
 }
 
