#
# Linux without futexes: QT_NO_LINUX_FUTEX (set by the Sarge mkspec) selects
# QMutex's and QThread's pthread paths, as on other Unix systems, for
# kernels and glibc versions older than Qt 4.8 assumes.
#
--- a/src/corelib/thread/qmutex_unix.cpp
+++ b/src/corelib/thread/qmutex_unix.cpp
@@ -56,7 +56,7 @@
 #if defined(Q_OS_MAC)
 # include <mach/mach.h>
 # include <mach/task.h>
-#elif defined(Q_OS_LINUX) && !defined(QT_LINUXBASE)
+#elif defined(Q_OS_LINUX) && !defined(QT_LINUXBASE) && !defined(QT_NO_LINUX_FUTEX)
 # include <linux/futex.h>
 # include <sys/syscall.h>
 # include <unistd.h>
@@ -65,7 +65,7 @@
 
 QT_BEGIN_NAMESPACE
 
-#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE)
+#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE) || defined(QT_NO_LINUX_FUTEX)
 static void report_error(int code, const char *where, const char *what)
 {
     if (code != 0)
@@ -77,7 +77,7 @@
 QMutexPrivate::QMutexPrivate(QMutex::RecursionMode mode)
     : QMutexData(mode), maximumSpinTime(MaximumSpinTimeThreshold), averageWaitTime(0), owner(0), count(0)
 {
-#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE)
+#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE) || defined(QT_NO_LINUX_FUTEX)
     wakeup = false;
     report_error(pthread_mutex_init(&mutex, NULL), "QMutex", "mutex init");
     report_error(pthread_cond_init(&cond, NULL), "QMutex", "cv init");
@@ -86,13 +86,13 @@
 
 QMutexPrivate::~QMutexPrivate()
 {
-#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE)
+#if !defined(Q_OS_LINUX) || defined(QT_LINUXBASE) || defined(QT_NO_LINUX_FUTEX)
     report_error(pthread_cond_destroy(&cond), "QMutex", "cv destroy");
     report_error(pthread_mutex_destroy(&mutex), "QMutex", "mutex destroy");
 #endif
 }
 
-#if defined(Q_OS_LINUX) && !defined(QT_LINUXBASE)
+#if defined(Q_OS_LINUX) && !defined(QT_LINUXBASE) && !defined(QT_NO_LINUX_FUTEX)
 
