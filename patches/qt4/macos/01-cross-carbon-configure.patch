# Recognize macx cross targets while retaining Linux host tools.
--- a/configure
+++ b/configure
@@ -273,6 +273,13 @@
 else
     PLATFORM_MAC=no
 fi
+
+# Cross-building a Carbon target must not depend on host frameworks.
+# BUILD_ON_MAC remains false: qmake/moc/uic are Linux host executables.
+XPLATFORM_MAC=no
+case " $* " in
+    *" -xplatform macx-"*) PLATFORM_MAC=yes; XPLATFORM_MAC=yes ;;
+esac
 
 #-----------------------------------------------------------------------------
 # Qt version detection
@@ -888,6 +895,8 @@
 MAC_CONFIG_TEST_COMMANDLINE=  # used to make the configure tests run with the correct arch's and SDK settings
 CFG_MAC_DWARF2=auto
 CFG_MAC_XARCH=auto
+# Target wrappers own architecture/deployment flags; do not leak them to host tools.
+[ "$XPLATFORM_MAC" = "yes" ] && CFG_MAC_XARCH=no
 CFG_MAC_CARBON=no
 CFG_MAC_COCOA=yes
 COMMANDLINE_MAC_CARBON=no
@@ -1583,6 +1592,9 @@
         # we are cross-compiling for MinGW
         if [ "$PLATFORM_MAC" = "yes" ] && [ "$VAL" != "windows" ]; then
             CFG_MAC_ARCHS="$CFG_MAC_ARCHS $VAL"
+            if [ "$XPLATFORM_MAC" = "yes" ]; then
+                case "$VAL" in x86|i386) CFG_ARCH=i386;; ppc|ppc64) CFG_ARCH=powerpc;; *) CFG_ARCH="$VAL";; esac
+            fi
         else
             CFG_ARCH=$VAL
         fi
@@ -3319,7 +3331,7 @@
     CFG_ARCH=integrity
 elif [ "$XPLATFORM_SYMBIAN" = "yes" ]; then
     CFG_ARCH=symbian
-elif [ "$PLATFORM_MAC" = "yes" ] || [ -z "$CFG_ARCH" ]; then
+elif [ "$PLATFORM_MAC" = "yes" -a "$XPLATFORM_MAC" != "yes" ] || [ -z "$CFG_ARCH" ]; then
     CFG_ARCH=$CFG_HOST_ARCH
 fi
 
