@@ -54,6 +54,15 @@
 
 #include <sys/types.h>
 #include <sys/event.h>
+#ifdef Q_OS_MAC
+// Mac OS X 10.2 Jaguar: libSystem gained kqueue() and kevent() in 10.3. With
+// weak references create() fails on 10.2 and QFileSystemWatcher polls.
+extern "C" {
+int kqueue(void) __attribute__((weak_import));
+int kevent(int, const struct kevent *, int, struct kevent *, int, const struct timespec *)
+    __attribute__((weak_import));
+}
+#endif
 #include <sys/stat.h>
 #include <sys/time.h>
 #include <fcntl.h>
@@ -69,6 +78,10 @@ QT_BEGIN_NAMESPACE
 
 QKqueueFileSystemWatcherEngine *QKqueueFileSystemWatcherEngine::create()
 {
+#ifdef Q_OS_MAC
+    if (!&kqueue)
+        return 0;
+#endif
     int kqfd = kqueue();
     if (kqfd == -1)
         return 0;
