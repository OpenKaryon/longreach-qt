#
# Mac OS X 10.2 Jaguar: QtCore without the libSystem functions of 10.3.
#
# The first QtCore run on Jaguar stopped in dyld: "undefined reference to
# _dlopen expected to be defined in /usr/lib/libSystem.B.dylib". The 10.4u
# headers do not mark dlopen, dlsym, dlclose, dlerror, kqueue, kevent,
# nl_langinfo or strerror_r as 10.3 APIs, so they were strong imports. Each
# is now declared weak where Qt uses it, with a fallback: QLibrary reports
# that run-time loading needs 10.3, QFileSystemWatcher polls, the locale
# codec comes from the environment and strerror() replaces strerror_r().
# The Jaguar build is configured with -no-iconv (libiconv arrived in 10.3
# and Qt loads it through QLibrary); the locale codec then defaults to UTF-8
# on the Mac instead of ISO 8859-1.
# Part of the Jaguar port, docs/targets/qt4-macos.md. Applies to pristine
# Qt 4.8.7 with patch -p1.
diff --git a/src/corelib/plugin/qlibrary_unix.cpp b/src/corelib/plugin/qlibrary_unix.cpp
index 90797a4..d0d1f06 100644
--- a/src/corelib/plugin/qlibrary_unix.cpp
+++ b/src/corelib/plugin/qlibrary_unix.cpp
@@ -65,6 +65,17 @@ QT_BEGIN_NAMESPACE
 #if !defined(QT_HPUX_LD) && !defined(QT_NO_DYNAMIC_LIBRARY)
 QT_BEGIN_INCLUDE_NAMESPACE
 #include <dlfcn.h>
+#ifdef Q_OS_MAC
+// Mac OS X 10.2 Jaguar: dlopen() and its companions arrived in libSystem with
+// 10.3. Weak references keep the image loadable on 10.2, where loading a
+// library at run time then fails with an explanation.
+extern "C" {
+void *dlopen(const char *, int) __attribute__((weak_import));
+void *dlsym(void *, const char *) __attribute__((weak_import));
+int dlclose(void *) __attribute__((weak_import));
+char *dlerror(void) __attribute__((weak_import));
+}
+#endif
 QT_END_INCLUDE_NAMESPACE
 #endif
 
@@ -73,6 +84,10 @@ static QString qdlerror()
 #if defined(QT_NO_DYNAMIC_LIBRARY)
     const char *err = "This platform does not support dynamic libraries.";
 #elif !defined(QT_HPUX_LD)
+#  ifdef Q_OS_MAC
+    if (!&dlerror)
+        return QString();
+#  endif
     const char *err = dlerror();
 #else
     const char *err = strerror(errno);
@@ -83,6 +98,13 @@ static QString qdlerror()
 bool QLibraryPrivate::load_sys()
 {
     QString attempt;
+#if defined(Q_OS_MAC) && !defined(QT_NO_DYNAMIC_LIBRARY)
+    if (!&dlopen) {
+        errorString = QLibrary::tr("Cannot load library %1: %2").arg(fileName)
+                .arg(QLatin1String("(loading libraries at run time needs Mac OS X 10.3 or later)"));
+        return false;
+    }
+#endif
 #if !defined(QT_NO_DYNAMIC_LIBRARY)
     QFileSystemEntry fsEntry(fileName);
 
@@ -286,6 +308,8 @@ bool QLibraryPrivate::unload_sys()
 #ifdef Q_OS_MAC
 Q_CORE_EXPORT void *qt_mac_resolve_sys(void *handle, const char *symbol)
 {
+    if (!&dlsym) // Mac OS X 10.2
+        return 0;
     return dlsym(handle, symbol);
 }
 #endif
