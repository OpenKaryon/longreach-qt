+class QtJaguarRectPart : public QtJaguarAppearance
+{
+public:
+    enum Kind { Tab, TabPane, PopupArrow, MenuBackground, MenuBarBackground, MenuItem, MenuSeparator,
+                EditTextFrame, ListBoxFrame, PrimaryGroup, SecondaryGroup };
+    QtJaguarRectPart(Kind k, const HIRect &r) : kind(k), rect(r), container(r), a(0), b(0), c(0), d(0) {}
+    void draw()
+    {
+        const Rect bounds = map(rect);
+        switch (kind) {
+        case Tab: DrawThemeTab(&bounds, ThemeTabStyle(a), ThemeTabDirection(b), 0, 0); break;
+        case TabPane: DrawThemeTabPane(&bounds, ThemeDrawState(a)); break;
+        case PopupArrow: DrawThemePopupArrow(&bounds, ThemeArrowOrientation(a), ThemePopupArrowSize(b), ThemeDrawState(c), 0, 0); break;
+        case MenuBackground: DrawThemeMenuBackground(&bounds, ThemeMenuType(a)); break;
+        case MenuBarBackground: DrawThemeMenuBarBackground(&bounds, ThemeMenuBarState(a), UInt32(b)); break;
+        case MenuItem: {
+            const Rect menu = map(container);
+            DrawThemeMenuItem(&menu, &bounds, menu.top, menu.bottom, ThemeMenuState(a), ThemeMenuItemType(b), 0, 0);
+            break; }
+        case MenuSeparator: DrawThemeMenuSeparator(&bounds); break;
+        case EditTextFrame: DrawThemeEditTextFrame(&bounds, ThemeDrawState(a)); break;
+        case ListBoxFrame: DrawThemeListBoxFrame(&bounds, ThemeDrawState(a)); break;
+        case PrimaryGroup: DrawThemePrimaryGroup(&bounds, ThemeDrawState(a)); break;
+        case SecondaryGroup: DrawThemeSecondaryGroup(&bounds, ThemeDrawState(a)); break;
+        }
+    }
+    Kind kind;
+    HIRect rect;
+    HIRect container;
+    UInt32 a, b, c, d;
+};
