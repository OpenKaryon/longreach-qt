+/****************************************************************************
+**
+** Mac OS X 10.2 (Jaguar) support for the Carbon port of QtGui; see
+** qt_jaguar_mac_p.h. A weak import is NULL when the running system does not
+** export it, so each wrapper first checks the address of the real function.
+**
+****************************************************************************/
+
+#include <QtCore/qglobal.h>
+
+#define QT_JAGUAR_MAC_IMPLEMENTATION
+#include "qt_jaguar_mac_p.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+// Private HIToolbox call that Qt declares itself in qwidget_mac.mm.
+extern "C" OSStatus _HIViewScrollRectWithOptions(HIViewRef, const HIRect *, float, float, OptionBits)
+    __attribute__((weak_import));
+// AppKit string constants, both Mac OS X 10.3.
+extern "C" const CFStringRef NSMenuDidEndTrackingNotification __attribute__((weak_import));
+extern "C" const CFStringRef NSStrikethroughStyleAttributeName __attribute__((weak_import));
+
+
+static Rect qt_jaguar_qdRect(const HIRect &r)
+{
+    Rect qd;
+    qd.left = short(floorf(r.origin.x));
+    qd.top = short(floorf(r.origin.y));
+    qd.right = short(ceilf(r.origin.x + r.size.width));
+    qd.bottom = short(ceilf(r.origin.y + r.size.height));
+    return qd;
+}
+
+// ---- CoreGraphics ---------------------------------------------------------
+
+// The byte order flags of CGBitmapInfo are Mac OS X 10.4; 10.2 and 10.3
+// reject a bitmap that sets them. Big endian, the PowerPC host order Qt asks
+// for, is what those systems use anyway.
+static CGBitmapInfo qt_jaguar_bitmapInfo(CGBitmapInfo info)
+{
+    if (&CGBitmapContextCreateImage)
+        return info;
+    const CGBitmapInfo order = info & kCGBitmapByteOrderMask;
+    if (order == kCGBitmapByteOrder32Big || order == kCGBitmapByteOrder16Big)
+        return info & ~kCGBitmapByteOrderMask;
+    return info;
+}
+
+CGContextRef qt_jaguar_CGBitmapContextCreate(void *data, size_t width, size_t height, size_t bitsPerComponent,
+                                             size_t bytesPerRow, CGColorSpaceRef colorspace, CGBitmapInfo bitmapInfo)
+{
+    return CGBitmapContextCreate(data, width, height, bitsPerComponent, bytesPerRow, colorspace,
+                                 qt_jaguar_bitmapInfo(bitmapInfo));
+}
+
+CGImageRef qt_jaguar_CGImageCreate(size_t width, size_t height, size_t bitsPerComponent, size_t bitsPerPixel,
+                                   size_t bytesPerRow, CGColorSpaceRef colorspace, CGBitmapInfo bitmapInfo,
+                                   CGDataProviderRef provider, const float decode[], bool shouldInterpolate,
+                                   CGColorRenderingIntent intent)
+{
+    return CGImageCreate(width, height, bitsPerComponent, bitsPerPixel, bytesPerRow, colorspace,
+                         qt_jaguar_bitmapInfo(bitmapInfo), provider, decode, shouldInterpolate, intent);
+}
+
+static void qt_jaguar_releaseData(void *, const void *data, size_t)
+{
+    free(const_cast<void *>(data));
+}
+
+CGImageRef qt_jaguar_CGBitmapContextCreateImage(CGContextRef c)
+{
+    if (&CGBitmapContextCreateImage)
+        return CGBitmapContextCreateImage(c);
+    // 10.2: copy the pixels into a new image, as the 10.4 call does.
+    void *pixels = CGBitmapContextGetData(c);
+    if (!pixels)
+        return 0;
+    const size_t width = CGBitmapContextGetWidth(c);
+    const size_t height = CGBitmapContextGetHeight(c);
+    const size_t bytesPerRow = CGBitmapContextGetBytesPerRow(c);
+    void *copy = malloc(bytesPerRow * height);
+    if (!copy)
+        return 0;
+    memcpy(copy, pixels, bytesPerRow * height);
+    CGDataProviderRef provider = CGDataProviderCreateWithData(0, copy, bytesPerRow * height,
+                                                              qt_jaguar_releaseData);
+    CGImageRef image = CGImageCreate(width, height, CGBitmapContextGetBitsPerComponent(c),
+                                     CGBitmapContextGetBitsPerPixel(c), bytesPerRow,
+                                     CGBitmapContextGetColorSpace(c), CGBitmapContextGetAlphaInfo(c),
+                                     provider, 0, false, kCGRenderingIntentDefault);
+    CGDataProviderRelease(provider);
+    return image;
+}
+
+void qt_jaguar_CGContextSetBlendMode(CGContextRef c, CGBlendMode mode)
+{
+    // 10.2 composites with source-over only.
+    if (&CGContextSetBlendMode)
+        CGContextSetBlendMode(c, mode);
+}
+
+void qt_jaguar_CGContextSetFillColorWithColor(CGContextRef c, CGColorRef color)
+{
+    if (&CGContextSetFillColorWithColor) {
+        CGContextSetFillColorWithColor(c, color);
+    } else if (color) {
+        CGContextSetFillColorSpace(c, CGColorGetColorSpace(color));
+        CGContextSetFillColor(c, CGColorGetComponents(color));
+    }
+}
+
+void qt_jaguar_CGContextSetStrokeColorWithColor(CGContextRef c, CGColorRef color)
+{
+    if (&CGContextSetStrokeColorWithColor) {
+        CGContextSetStrokeColorWithColor(c, color);
+    } else if (color) {
+        CGContextSetStrokeColorSpace(c, CGColorGetColorSpace(color));
+        CGContextSetStrokeColor(c, CGColorGetComponents(color));
+    }
+}
+
+CGError qt_jaguar_CGDisplayRegisterReconfigurationCallback(CGDisplayReconfigurationCallBack proc, void *userInfo)
+{
+    // 10.2 sends no display reconfiguration notices; Qt then keeps its
+    // desktop geometry until the next QDesktopWidget query.
+    if (&CGDisplayRegisterReconfigurationCallback)
+        return CGDisplayRegisterReconfigurationCallback(proc, userInfo);
+    return kCGErrorSuccess;
+}
+
+CGError qt_jaguar_CGDisplayRemoveReconfigurationCallback(CGDisplayReconfigurationCallBack proc, void *userInfo)
+{
+    if (&CGDisplayRemoveReconfigurationCallback)
+        return CGDisplayRemoveReconfigurationCallback(proc, userInfo);
+    return kCGErrorSuccess;
+}
+
+CGImageRef qt_jaguar_CGImageCreateWithImageInRect(CGImageRef image, CGRect rect)
+{
+    if (&CGImageCreateWithImageInRect)
+        return CGImageCreateWithImageInRect(image, rect);
+    // 10.2: draw the part into a bitmap of its size. The rectangle is in
+    // image pixels with the origin at the top left; CoreGraphics draws with
+    // the origin at the bottom left.
+    if (!image)
+        return 0;
+    const float imageWidth = CGImageGetWidth(image);
+    const float imageHeight = CGImageGetHeight(image);
+    rect = CGRectIntegral(CGRectIntersection(rect, CGRectMake(0, 0, imageWidth, imageHeight)));
+    if (CGRectIsEmpty(rect))
+        return 0;
+    const size_t width = size_t(rect.size.width);
+    const size_t height = size_t(rect.size.height);
+    void *pixels = calloc(height, width * 4);
+    if (!pixels)
+        return 0;
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGContextRef bitmap = CGBitmapContextCreate(pixels, width, height, 8, width * 4, colorSpace,
+                                                kCGImageAlphaPremultipliedFirst);
+    CGColorSpaceRelease(colorSpace);
+    if (!bitmap) {
+        free(pixels);
+        return 0;
+    }
+    CGContextDrawImage(bitmap, CGRectMake(-rect.origin.x,
+                                          rect.origin.y + rect.size.height - imageHeight,
+                                          imageWidth, imageHeight), image);
+    CGImageRef part = qt_jaguar_CGBitmapContextCreateImage(bitmap);
+    CGContextRelease(bitmap);
+    free(pixels);
+    return part;
+}
+
+// ImageIO is Mac OS X 10.4. Without it the clipboard and the wizard fall
+// back to Qt's own image handlers or show no native image.
+void qt_jaguar_CGImageDestinationAddImage(CGImageDestinationRef idst, CGImageRef image, CFDictionaryRef properties)
+{
+    if (&CGImageDestinationAddImage && idst)
+        CGImageDestinationAddImage(idst, image, properties);
+}
+
+CGImageDestinationRef qt_jaguar_CGImageDestinationCreateWithData(CFMutableDataRef data, CFStringRef type, size_t count, CFDictionaryRef options)
+{
+    if (&CGImageDestinationCreateWithData)
+        return CGImageDestinationCreateWithData(data, type, count, options);
+    return 0;
+}
+
+bool qt_jaguar_CGImageDestinationFinalize(CGImageDestinationRef idst)
+{
+    if (&CGImageDestinationFinalize && idst)
+        return CGImageDestinationFinalize(idst);
+    return false;
+}
+
+CGImageRef qt_jaguar_CGImageSourceCreateImageAtIndex(CGImageSourceRef isrc, size_t index, CFDictionaryRef options)
+{
+    if (&CGImageSourceCreateImageAtIndex && isrc)
+        return CGImageSourceCreateImageAtIndex(isrc, index, options);
+    return 0;
+}
+
+CGImageSourceRef qt_jaguar_CGImageSourceCreateWithData(CFDataRef data, CFDictionaryRef options)
+{
+    if (&CGImageSourceCreateWithData)
+        return CGImageSourceCreateWithData(data, options);
+    return 0;
+}
+
+CGImageSourceRef qt_jaguar_CGImageSourceCreateWithURL(CFURLRef url, CFDictionaryRef options)
+{
+    if (&CGImageSourceCreateWithURL)
+        return CGImageSourceCreateWithURL(url, options);
+    return 0;
+}
+
+CFStringRef qt_jaguar_kCGImagePropertyPixelWidth()
+{
+    return &kCGImagePropertyPixelWidth ? kCGImagePropertyPixelWidth : CFSTR("PixelWidth");
+}
+
+CFStringRef qt_jaguar_kCGImagePropertyPixelHeight()
+{
+    return &kCGImagePropertyPixelHeight ? kCGImagePropertyPixelHeight : CFSTR("PixelHeight");
+}
