+// ---- HIToolbox ------------------------------------------------------------
+
+OSStatus qt_jaguar_CancelMenuTracking(MenuRef inRootMenu, Boolean inImmediate, UInt32 inDismissalReason)
+{
+    if (&CancelMenuTracking)
+        return CancelMenuTracking(inRootMenu, inImmediate, inDismissalReason);
+    return noErr;
+}
+
+OSStatus qt_jaguar_DisableSecureEventInput()
+{
+    if (&DisableSecureEventInput)
+        return DisableSecureEventInput();
+    return noErr;
+}
+
+OSStatus qt_jaguar_EnableSecureEventInput()
+{
+    // 10.2 has no secure event input; password fields work without it.
+    if (&EnableSecureEventInput)
+        return EnableSecureEventInput();
+    return noErr;
+}
+
+EventTargetRef qt_jaguar_GetEventMonitorTarget()
+{
+    // The monitor target (10.3) also sees events for other applications;
+    // on 10.2 Qt hears only its own.
+    if (&GetEventMonitorTarget)
+        return GetEventMonitorTarget();
+    return GetApplicationEventTarget();
+}
+
+OSStatus qt_jaguar_GetWindowGroupLevelOfType(WindowGroupRef inGroup, UInt32 inLevelType, CGWindowLevel *outLevel)
+{
+    if (&GetWindowGroupLevelOfType)
+        return GetWindowGroupLevelOfType(inGroup, inLevelType, outLevel);
+    SInt32 level = 0;
+    const OSStatus err = GetWindowGroupLevel(inGroup, &level);
+    if (outLevel)
+        *outLevel = level;
+    return err;
+}
+
+float qt_jaguar_HIGetScaleFactor()
+{
+    if (&HIGetScaleFactor)
+        return HIGetScaleFactor();
+    return 1.0f;
+}
+
+OSStatus qt_jaguar_HIMenuGetContentView(MenuRef inMenu, ThemeMenuType inMenuType, HIViewRef *outView)
+{
+    if (&HIMenuGetContentView)
+        return HIMenuGetContentView(inMenu, inMenuType, outView);
+    if (outView)
+        *outView = 0;
+    return eventNotHandledErr;
+}
+
+OSStatus qt_jaguar_HIViewChangeFeatures(HIViewRef inView, HIViewFeatures inFeaturesToSet, HIViewFeatures inFeaturesToClear)
+{
+    // 10.2 views keep the features they were created with; opacity is a
+    // drawing hint and Qt handles clicks for transparent widgets itself.
+    if (&HIViewChangeFeatures)
+        return HIViewChangeFeatures(inView, inFeaturesToSet, inFeaturesToClear);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIViewGetFeatures(HIViewRef inView, HIViewFeatures *outFeatures)
+{
+    if (&HIViewGetFeatures)
+        return HIViewGetFeatures(inView, outFeatures);
+    UInt32 features = 0;
+    const OSStatus err = GetControlFeatures(inView, &features);
+    if (outFeatures)
+        *outFeatures = features;
+    return err;
+}
+
+WindowRef qt_jaguar_HIViewGetWindow(HIViewRef inView)
+{
+    if (&HIViewGetWindow)
+        return HIViewGetWindow(inView);
+    return inView ? GetControlOwner(inView) : 0;
+}
+
+OSStatus qt_jaguar_HIViewRender(HIViewRef inView)
+{
+    if (&HIViewRender)
+        return HIViewRender(inView);
+    Draw1Control(inView);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIViewSetNeedsDisplayInRect(HIViewRef inView, const HIRect *inRect, Boolean inNeedsDisplay)
+{
+    if (&HIViewSetNeedsDisplayInRect)
+        return HIViewSetNeedsDisplayInRect(inView, inRect, inNeedsDisplay);
+    if (!inRect)
+        return HIViewSetNeedsDisplay(inView, inNeedsDisplay);
+    const Rect qd = qt_jaguar_qdRect(*inRect);
+    RgnHandle region = NewRgn();
+    RectRgn(region, &qd);
+    const OSStatus err = HIViewSetNeedsDisplayInRegion(inView, region, inNeedsDisplay);
+    DisposeRgn(region);
+    return err;
+}
+
+OSStatus qt_jaguar__HIViewScrollRectWithOptions(HIViewRef inView, const HIRect *inRect, float inDX, float inDY, OptionBits inOptions)
+{
+    if (&_HIViewScrollRectWithOptions)
+        return _HIViewScrollRectWithOptions(inView, inRect, inDX, inDY, inOptions);
+    return HIViewScrollRect(inView, inRect, inDX, inDY);
+}
+
+OSStatus qt_jaguar_HIWindowChangeAvailability(HIWindowRef inWindow, HIWindowAvailability inSet, HIWindowAvailability inClear)
+{
+    // Expose (10.3) does not exist on 10.2.
+    if (&HIWindowChangeAvailability)
+        return HIWindowChangeAvailability(inWindow, inSet, inClear);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIWindowChangeClass(HIWindowRef inWindow, WindowClass inWindowClass)
+{
+    // 10.2 cannot change the class of an existing window; it keeps the one
+    // it was created with.
+    if (&HIWindowChangeClass)
+        return HIWindowChangeClass(inWindow, inWindowClass);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIWindowChangeFeatures(WindowRef inWindow, UInt64 inSetThese, UInt64 inClearThese)
+{
+    if (&HIWindowChangeFeatures)
+        return HIWindowChangeFeatures(inWindow, inSetThese, inClearThese);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIWindowFlush(HIWindowRef inWindow)
+{
+    if (&HIWindowFlush)
+        return HIWindowFlush(inWindow);
+    QDFlushPortBuffer(GetWindowPort(inWindow), 0);
+    return noErr;
+}
+
+OSStatus qt_jaguar_HIWindowSetProxyFSRef(WindowRef window, const FSRef *inRef)
+{
+    if (&HIWindowSetProxyFSRef)
+        return HIWindowSetProxyFSRef(window, inRef);
+    FSSpec spec;
+    OSStatus err = FSGetCatalogInfo(inRef, kFSCatInfoNone, 0, 0, &spec, 0);
+    if (err == noErr)
+        err = SetWindowProxyFSSpec(window, &spec);
+    return err;
+}
+
+OSStatus qt_jaguar_TransformProcessType(const ProcessSerialNumber *psn, ProcessApplicationTransformState transformState)
+{
+    // An application outside a bundle stays a background process on 10.2.
+    if (&TransformProcessType)
+        return TransformProcessType(psn, transformState);
+    return unimpErr;
+}
+
+OSStatus qt_jaguar_TransitionWindowWithOptions(WindowRef inWindow, WindowTransitionEffect inEffect, WindowTransitionAction inAction,
+                                               const HIRect *inBounds, Boolean inAsync, TransitionWindowOptions *inOptions)
+{
+    if (&TransitionWindowWithOptions)
+        return TransitionWindowWithOptions(inWindow, inEffect, inAction, inBounds, inAsync, inOptions);
+    Rect qd;
+    if (inBounds)
+        qd = qt_jaguar_qdRect(*inBounds);
+    return TransitionWindow(inWindow, inEffect, inAction, inBounds ? &qd : 0);
+}
+
+// ---- HITheme --------------------------------------------------------------
+//
+// HITheme is Mac OS X 10.3. The 10.2 HIToolbox exports part of it, unannounced
+// and with a different interface: its HIThemeDrawButton crashes when called
+// as documented. Before 10.3 the drawing therefore goes to the Appearance
+// Manager, as in Qt 4.1. That draws into a QuickDraw port, not into a
+// CGContext, so the part is drawn twice into an offscreen GWorld, once over
+// white and once over black; the difference gives the coverage of each
+// pixel, and the result is drawn into the context as an image.
+
+static bool qt_jaguar_hasHITheme();
+
+class QtJaguarAppearance
+{
+public:
+    QtJaguarAppearance() : originX(0), originY(0), height(0), inverted(false) {}
+    virtual ~QtJaguarAppearance() {}
+    // Draws into the current port, in which (0, 0) is the top left of the area.
+    virtual void draw() = 0;
+
+    // Maps a rectangle of the context to QuickDraw coordinates in the area.
+    Rect map(const HIRect &r) const
+    {
+        HIRect local = r;
+        local.origin.x -= originX;
+        local.origin.y = inverted ? (originY + height) - (r.origin.y + r.size.height) : r.origin.y - originY;
+        return qt_jaguar_qdRect(local);
+    }
+
+    float originX;
+    float originY;
+    float height;
+    bool inverted;
+};
+
+static void qt_jaguar_releasePixels(void *, const void *data, size_t)
+{
+    free(const_cast<void *>(data));
+}
+
+static OSStatus qt_jaguar_render(CGContextRef context, HIThemeOrientation orientation, HIRect area,
+                                 QtJaguarAppearance &part)
+{
+    if (!context)
+        return paramErr;
+    area = CGRectIntegral(area);
+    const int width = int(area.size.width);
+    const int height = int(area.size.height);
+    if (width <= 0 || height <= 0 || width > 4096 || height > 4096)
+        return noErr;
+    part.originX = area.origin.x;
+    part.originY = area.origin.y;
+    part.height = height;
+    part.inverted = orientation == kHIThemeOrientationInverted;
+
+    const size_t rowBytes = size_t(width) * 4;
+    const size_t pixelCount = size_t(width) * size_t(height);
+    UInt32 *onWhite = static_cast<UInt32 *>(malloc(pixelCount * 4));
+    UInt32 *onBlack = static_cast<UInt32 *>(malloc(pixelCount * 4));
+    if (!onWhite || !onBlack) {
+        free(onWhite);
+        free(onBlack);
+        return memFullErr;
+    }
+    for (int pass = 0; pass < 2; ++pass) {
+        UInt32 *pixels = pass ? onBlack : onWhite;
+        const UInt32 fill = pass ? 0xff000000u : 0xffffffffu;
+        for (size_t i = 0; i < pixelCount; ++i)
+            pixels[i] = fill;
+        Rect bounds = { 0, 0, short(height), short(width) };
+        GWorldPtr world = 0;
+        if (NewGWorldFromPtr(&world, k32ARGBPixelFormat, &bounds, 0, 0, 0,
+                             reinterpret_cast<Ptr>(pixels), long(rowBytes)) != noErr || !world) {
+            free(onWhite);
+            free(onBlack);
+            return memFullErr;
+        }
+        CGrafPtr oldPort;
+        GDHandle oldDevice;
+        GetGWorld(&oldPort, &oldDevice);
+        SetGWorld(world, 0);
+        RGBColor back;
+        back.red = back.green = back.blue = pass ? 0 : 0xffff;
+        RGBBackColor(&back);
+        part.draw();
+        SetGWorld(oldPort, oldDevice);
+        DisposeGWorld(world);
+    }
+    // Over black a pixel shows its premultiplied color; over white the same
+    // color plus the white that shines through, (1 - alpha) * 255.
+    for (size_t i = 0; i < pixelCount; ++i) {
+        const UInt32 w = onWhite[i];
+        const UInt32 b = onBlack[i];
+        int through = 0;
+        for (int shift = 0; shift <= 16; shift += 8) {
+            const int d = int((w >> shift) & 0xff) - int((b >> shift) & 0xff);
+            if (d > through)
+                through = d;
+        }
+        const UInt32 alpha = UInt32(255 - through);
+        UInt32 out = alpha << 24;
+        for (int shift = 0; shift <= 16; shift += 8) {
+            UInt32 c = (b >> shift) & 0xff;
+            if (c > alpha)
+                c = alpha;
+            out |= c << shift;
+        }
+        onBlack[i] = out;
+    }
+    free(onWhite);
+
+    CGDataProviderRef provider = CGDataProviderCreateWithData(0, onBlack, pixelCount * 4, qt_jaguar_releasePixels);
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGImageRef image = CGImageCreate(width, height, 8, 32, rowBytes, colorSpace, kCGImageAlphaPremultipliedFirst,
+                                     provider, 0, false, kCGRenderingIntentDefault);
+    CGColorSpaceRelease(colorSpace);
+    CGDataProviderRelease(provider);
+    if (!image)
+        return memFullErr;
+    CGContextSaveGState(context);
+    if (part.inverted) {
+        CGContextDrawImage(context, area, image);
+    } else {
+        // A context in the HIView orientation is flipped; draw the image upright.
+        CGContextTranslateCTM(context, area.origin.x, area.origin.y + height);
+        CGContextScaleCTM(context, 1, -1);
+        CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+    }
+    CGContextRestoreGState(context);
+    CGImageRelease(image);
+    return noErr;
+}
+
+static ThemeTrackDrawInfo qt_jaguar_trackInfo(const HIThemeTrackDrawInfo &info, const Rect &bounds)
+{
+    ThemeTrackDrawInfo track;
+    track.kind = info.kind;
+    track.bounds = bounds;
+    track.min = info.min;
+    track.max = info.max;
+    track.value = info.value;
+    track.reserved = 0;
+    track.attributes = info.attributes;
+    track.enableState = info.enableState;
+    track.filler1 = 0;
+    memcpy(&track.trackInfo, &info.trackInfo, sizeof(track.trackInfo));
+    return track;
+}
