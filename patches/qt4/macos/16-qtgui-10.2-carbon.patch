+OSStatus qt_jaguar_HIThemeGetTrackThumbShape(const HIThemeTrackDrawInfo *inDrawInfo, HIShapeRef *outThumbShape)
+{
+    if (&HIThemeGetTrackThumbShape)
+        return HIThemeGetTrackThumbShape(inDrawInfo, outThumbShape);
+    if (!inDrawInfo || !outThumbShape)
+        return paramErr;
+    // The Appearance Manager track description has the same fields with a
+    // QuickDraw rectangle.
+    ThemeTrackDrawInfo track;
+    track.kind = inDrawInfo->kind;
+    track.bounds = qt_jaguar_qdRect(inDrawInfo->bounds);
+    track.min = inDrawInfo->min;
+    track.max = inDrawInfo->max;
+    track.value = inDrawInfo->value;
+    track.reserved = 0;
+    track.attributes = inDrawInfo->attributes;
+    track.enableState = inDrawInfo->enableState;
+    track.filler1 = 0;
+    memcpy(&track.trackInfo, &inDrawInfo->trackInfo, sizeof(track.trackInfo));
+    RgnHandle region = NewRgn();
+    OSStatus err = GetThemeTrackThumbRgn(&track, region);
+    *outThumbShape = err == noErr ? HIShapeCreateWithQDRgn(region) : 0;
+    DisposeRgn(region);
+    if (err == noErr && !*outThumbShape)
+        err = memFullErr;
+    return err;
+}
