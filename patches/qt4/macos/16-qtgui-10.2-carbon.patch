+static OSStatus qt_jaguar_appearanceButtonBounds(const HIRect *inBounds, const HIThemeButtonDrawInfo *inDrawInfo,
+                                                 HIRect *outBounds, bool background)
+{
+    if (!inBounds || !inDrawInfo || !outBounds)
+        return paramErr;
+    const Rect bounds = qt_jaguar_qdRect(*inBounds);
+    ThemeButtonDrawInfo info;
+    info.state = inDrawInfo->state;
+    info.value = inDrawInfo->value;
+    info.adornment = inDrawInfo->adornment;
+    Rect result;
+    const OSStatus err = background
+        ? GetThemeButtonBackgroundBounds(&bounds, inDrawInfo->kind, &info, &result)
+        : GetThemeButtonContentBounds(&bounds, inDrawInfo->kind, &info, &result);
+    if (err == noErr)
+        *outBounds = CGRectMake(result.left, result.top, result.right - result.left, result.bottom - result.top);
+    return err;
+}
