+// CGColor became a Core Foundation type in Mac OS X 10.3. On 10.2 CFRetain
+// and CFRelease treat a CGColor as an Objective-C object and crash, so the
+// color wrapper uses CGColorRetain and CGColorRelease, which work on all.
+template <>
+class QCFType<CGColorRef>
+{
+public:
+    inline QCFType(const CGColorRef &t = 0) : type(t) {}
+    inline QCFType(const QCFType &helper) : type(helper.type) { if (type) CGColorRetain(type); }
+    inline ~QCFType() { if (type) CGColorRelease(type); }
+    inline operator CGColorRef() { return type; }
+    inline QCFType operator =(const QCFType &helper)
+    {
+        if (helper.type)
+            CGColorRetain(helper.type);
+        CGColorRef type2 = type;
+        type = helper.type;
+        if (type2)
+            CGColorRelease(type2);
+        return *this;
+    }
+    inline CGColorRef *operator&() { return &type; }
+    template <typename X> X as() const { return reinterpret_cast<X>(type); }
+    static QCFType constructFromGet(const CGColorRef &t)
+    {
+        CGColorRetain(t);
+        return QCFType<CGColorRef>(t);
+    }
+protected:
+    CGColorRef type;
+};
+QT_END_NAMESPACE
