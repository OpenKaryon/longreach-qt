+OSStatus qt_jaguar_HIThemeGetWindowShape(const HIRect *inContRect, const HIThemeWindowDrawInfo *inDrawInfo, WindowRegionCode inWinRegion, HIShapeRef *outShape)
+{
+    if (&HIThemeGetWindowShape)
+        return HIThemeGetWindowShape(inContRect, inDrawInfo, inWinRegion, outShape);
+    return qt_jaguar_rectShape(inContRect, outShape);
+}
+
+static const int qt_jaguar_tileSize = 16;
+
+static void qt_jaguar_drawTile(void *info, CGContextRef context)
+{
+    CGContextDrawImage(context, CGRectMake(0, 0, qt_jaguar_tileSize, qt_jaguar_tileSize), static_cast<CGImageRef>(info));
+}
+
+static void qt_jaguar_releaseTile(void *info)
+{
+    CGImageRelease(static_cast<CGImageRef>(info));
+}
+
+static CGPatternRef qt_jaguar_brushPattern(ThemeBrush brush)
+{
+    // Theme brushes are small negative or positive numbers; keep the
+    // patterns of the ones Qt asks for for the life of the process.
+    static CGPatternRef patterns[128];
+    const int slot = (brush + 64) & 127;
+    if (patterns[slot])
+        return patterns[slot];
+
+    const int size = qt_jaguar_tileSize;
+    UInt32 *pixels = static_cast<UInt32 *>(malloc(size * size * 4));
+    if (!pixels)
+        return 0;
+    Rect bounds = { 0, 0, short(size), short(size) };
+    GWorldPtr world = 0;
+    if (NewGWorldFromPtr(&world, k32ARGBPixelFormat, &bounds, 0, 0, 0, reinterpret_cast<Ptr>(pixels), size * 4) != noErr) {
+        free(pixels);
+        return 0;
+    }
+    CGrafPtr oldPort;
+    GDHandle oldDevice;
+    GetGWorld(&oldPort, &oldDevice);
+    SetGWorld(world, 0);
+    const OSStatus err = SetThemeBackground(brush, 32, true);
+    if (err == noErr)
+        EraseRect(&bounds);
+    SetGWorld(oldPort, oldDevice);
+    DisposeGWorld(world);
+    if (err != noErr) {
+        free(pixels);
+        return 0;
+    }
+    for (int i = 0; i < size * size; ++i)
+        pixels[i] |= 0xff000000u;
+    CGDataProviderRef provider = CGDataProviderCreateWithData(0, pixels, size * size * 4, qt_jaguar_releasePixels);
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGImageRef tile = CGImageCreate(size, size, 8, 32, size * 4, colorSpace, kCGImageAlphaNoneSkipFirst,
+                                    provider, 0, false, kCGRenderingIntentDefault);
+    CGColorSpaceRelease(colorSpace);
+    CGDataProviderRelease(provider);
+    if (!tile)
+        return 0;
+    const CGPatternCallbacks callbacks = { 0, qt_jaguar_drawTile, qt_jaguar_releaseTile };
+    patterns[slot] = CGPatternCreate(tile, CGRectMake(0, 0, size, size), CGAffineTransformIdentity, size, size,
+                                     kCGPatternTilingConstantSpacing, true, &callbacks);
+    if (!patterns[slot])
+        CGImageRelease(tile);
+    return patterns[slot];
+}
+
+OSStatus qt_jaguar_HIThemeSetFill(ThemeBrush inBrush, void *inInfo, CGContextRef inContext, HIThemeOrientation inOrientation)
+{
+    if (&HIThemeSetFill)
+        return HIThemeSetFill(inBrush, inInfo, inContext, inOrientation);
+    if (!inContext)
+        return paramErr;
+    // A brush can be a pattern, such as the pinstripes of Jaguar dialogs.
+    // Render a tile of it once and fill with that as a CoreGraphics pattern.
+    CGPatternRef pattern = qt_jaguar_brushPattern(inBrush);
+    if (!pattern) {
+        qt_jaguar_setThemeColor(inContext, inBrush, true);
+        return noErr;
+    }
+    CGColorSpaceRef patternSpace = CGColorSpaceCreatePattern(0);
+    CGContextSetFillColorSpace(inContext, patternSpace);
+    CGColorSpaceRelease(patternSpace);
+    const float alpha = 1.0f;
+    CGContextSetFillPattern(inContext, pattern, &alpha);
+    return noErr;
+}
+
+// ---- Uniform Type Identifiers ---------------------------------------------
+//
+// 10.2 has no UTI database. The fallback knows the types Qt's clipboard
+// converters use and otherwise follows the 10.3 convention of
+// "CorePasteboardFlavorType 0x<OSType>" for unknown OSTypes.
+
+struct QtJaguarTypeName { OSType type; const char *uti; const char *extension; };
+static const QtJaguarTypeName qt_jaguar_types[] = {
+    { 'utxt', "public.utf16-plain-text", "txt" },
+    { 'TEXT', "com.apple.traditional-mac-plain-text", 0 },
+    { 'TIFF', "public.tiff", "tiff" },
+    { 'PICT', "com.apple.pict", "pict" },
+    { 'PNGf', "public.png", "png" },
+    { 'JPEG', "public.jpeg", "jpeg" },
+    { 'url ', "public.url", 0 },
+    { 'furl', "public.file-url", 0 },
+    { 'hfs ', "com.apple.hfs", 0 },
+    { 0, 0, 0 }
+};
+
+static const char qt_jaguar_flavorPrefix[] = "CorePasteboardFlavorType 0x";
+
+static CFStringRef qt_jaguar_utiForType(OSType type)
+{
+    for (const QtJaguarTypeName *t = qt_jaguar_types; t->uti; ++t) {
+        if (t->type == type)
+            return CFStringCreateWithCString(0, t->uti, kCFStringEncodingASCII);
+    }
+    return CFStringCreateWithFormat(0, 0, CFSTR("%s%08lX"), qt_jaguar_flavorPrefix, (unsigned long)type);
+}
+
+static OSType qt_jaguar_typeForUti(CFStringRef uti)
+{
+    char name[128];
+    if (!uti || !CFStringGetCString(uti, name, sizeof(name), kCFStringEncodingASCII))
+        return 0;
+    for (const QtJaguarTypeName *t = qt_jaguar_types; t->uti; ++t) {
+        if (!strcmp(t->uti, name))
+            return t->type;
+    }
+    const size_t prefix = sizeof(qt_jaguar_flavorPrefix) - 1;
+    if (!strncmp(name, qt_jaguar_flavorPrefix, prefix))
+        return OSType(strtoul(name + prefix, 0, 16));
+    return 0;
+}
+
+static bool qt_jaguar_isTagClass(CFStringRef tagClass, const char *name)
+{
+    char buffer[64];
+    return tagClass && CFStringGetCString(tagClass, buffer, sizeof(buffer), kCFStringEncodingASCII)
+        && !strcmp(buffer, name);
+}
+
+CFStringRef qt_jaguar_kUTTagClassOSType()
+{
+    return &kUTTagClassOSType ? kUTTagClassOSType : CFSTR("com.apple.ostype");
+}
+
+CFStringRef qt_jaguar_kUTTypeTIFF()
+{
+    return &kUTTypeTIFF ? kUTTypeTIFF : CFSTR("public.tiff");
+}
+
+CFStringRef qt_jaguar_UTCreateStringForOSType(OSType inOSType)
+{
+    if (&UTCreateStringForOSType)
+        return UTCreateStringForOSType(inOSType);
+    const UInt8 bytes[4] = { UInt8(inOSType >> 24), UInt8(inOSType >> 16), UInt8(inOSType >> 8), UInt8(inOSType) };
+    return CFStringCreateWithBytes(0, bytes, 4, kCFStringEncodingMacRoman, false);
+}
+
+OSType qt_jaguar_UTGetOSTypeFromString(CFStringRef inString)
+{
+    if (&UTGetOSTypeFromString)
+        return UTGetOSTypeFromString(inString);
+    UInt8 bytes[4];
+    CFIndex used = 0;
+    if (!inString || CFStringGetLength(inString) != 4
+        || CFStringGetBytes(inString, CFRangeMake(0, 4), kCFStringEncodingMacRoman, 0, false, bytes, 4, &used) != 4)
+        return 0;
+    return (OSType(bytes[0]) << 24) | (OSType(bytes[1]) << 16) | (OSType(bytes[2]) << 8) | OSType(bytes[3]);
+}
+
+CFStringRef qt_jaguar_UTTypeCopyPreferredTagWithClass(CFStringRef inUTI, CFStringRef inTagClass)
+{
+    if (&UTTypeCopyPreferredTagWithClass)
+        return UTTypeCopyPreferredTagWithClass(inUTI, inTagClass);
+    if (qt_jaguar_isTagClass(inTagClass, "com.apple.ostype")) {
+        const OSType type = qt_jaguar_typeForUti(inUTI);
+        return type ? qt_jaguar_UTCreateStringForOSType(type) : 0;
+    }
+    if (qt_jaguar_isTagClass(inTagClass, "public.filename-extension")) {
+        const OSType type = qt_jaguar_typeForUti(inUTI);
+        for (const QtJaguarTypeName *t = qt_jaguar_types; t->uti; ++t) {
+            if (t->type == type && t->extension)
+                return CFStringCreateWithCString(0, t->extension, kCFStringEncodingASCII);
+        }
+    }
+    return 0;
+}
+
+CFStringRef qt_jaguar_UTTypeCreatePreferredIdentifierForTag(CFStringRef inTagClass, CFStringRef inTag, CFStringRef inConformingToUTI)
+{
+    if (&UTTypeCreatePreferredIdentifierForTag)
+        return UTTypeCreatePreferredIdentifierForTag(inTagClass, inTag, inConformingToUTI);
+    if (qt_jaguar_isTagClass(inTagClass, "com.apple.ostype"))
+        return qt_jaguar_utiForType(qt_jaguar_UTGetOSTypeFromString(inTag));
+    char extension[32];
+    if (qt_jaguar_isTagClass(inTagClass, "public.filename-extension")
+        && CFStringGetCString(inTag, extension, sizeof(extension), kCFStringEncodingASCII)) {
+        for (const QtJaguarTypeName *t = qt_jaguar_types; t->uti; ++t) {
+            if (t->extension && !strcasecmp(t->extension, extension))
+                return CFStringCreateWithCString(0, t->uti, kCFStringEncodingASCII);
+        }
+    }
+    return 0;
+}
+
+CFArrayRef qt_jaguar_UTTypeCreateAllIdentifiersForTag(CFStringRef inTagClass, CFStringRef inTag, CFStringRef inConformingToUTI)
+{
+    if (&UTTypeCreateAllIdentifiersForTag)
+        return UTTypeCreateAllIdentifiersForTag(inTagClass, inTag, inConformingToUTI);
+    CFStringRef uti = qt_jaguar_UTTypeCreatePreferredIdentifierForTag(inTagClass, inTag, inConformingToUTI);
+    if (!uti)
+        return CFArrayCreate(0, 0, 0, &kCFTypeArrayCallBacks);
+    const void *values[] = { uti };
+    CFArrayRef result = CFArrayCreate(0, values, 1, &kCFTypeArrayCallBacks);
+    CFRelease(uti);
+    return result;
+}
+
+// ---- Pasteboard and drag --------------------------------------------------
+//
+// The Pasteboard Manager is Mac OS X 10.3; 10.2 has the Scrap Manager. Before
+// 10.3 the pasteboard calls work on a store in the process. The clipboard
+// and find pasteboards mirror it to the scrap of the same purpose, flavor by
+// flavor for the types the scrap knows by OSType (see qt_jaguar_types), so
+// text copied in Qt pastes in other applications and the other way round.
+// Promised flavors are kept at once: the promise keeper is called while the
+// flavor is put. Drags have no pasteboard on 10.2.
+
+struct QtJaguarPasteboard
+{
+    CFStringRef name;            // 0 for a unique pasteboard
+    CFStringRef scrapName;       // the scrap it mirrors, or 0
+    CFMutableArrayRef items;     // CFMutableDictionary per item: flavor -> CFData or kCFNull
+    CFMutableArrayRef itemIds;   // CFNumber per item
+    PasteboardPromiseKeeperProcPtr keeper;
+    void *keeperContext;
+    ScrapRef scrap;              // the scrap as last written or read
+};
+
+// Qt releases a pasteboard with CFRelease, so the emulated one is a CFData
+// that holds the store and frees it through its deallocator.
+static QtJaguarPasteboard *qt_jaguar_pasteboard(PasteboardRef ref)
+{
+    return ref ? reinterpret_cast<QtJaguarPasteboard *>(const_cast<UInt8 *>(
+               CFDataGetBytePtr(reinterpret_cast<CFDataRef>(ref)))) : 0;
+}
+
+static void *qt_jaguar_allocatePasteboard(CFIndex size, CFOptionFlags, void *)
+{
+    return malloc(size);
+}
+
+static void qt_jaguar_freePasteboard(void *pointer, void *)
+{
+    QtJaguarPasteboard *pb = static_cast<QtJaguarPasteboard *>(pointer);
+    if (pb->name)
+        CFRelease(pb->name);
+    CFRelease(pb->items);
+    CFRelease(pb->itemIds);
+    delete pb;
+}
+
+static CFAllocatorRef qt_jaguar_pasteboardDeallocator()
+{
+    static CFAllocatorRef allocator = 0;
+    if (!allocator) {
+        CFAllocatorContext context = { 0, 0, 0, 0, 0, qt_jaguar_allocatePasteboard, 0, qt_jaguar_freePasteboard, 0 };
+        allocator = CFAllocatorCreate(0, &context);
+    }
+    return allocator;
+}
+
+static bool qt_jaguar_hasPasteboard()
+{
+    return &PasteboardCreate != 0;
+}
+
+static CFMutableDictionaryRef qt_jaguar_item(QtJaguarPasteboard *pb, PasteboardItemID id, bool create)
+{
+    const long wanted = long(id);
+    for (CFIndex i = 0; i < CFArrayGetCount(pb->itemIds); ++i) {
+        long value = 0;
+        CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(pb->itemIds, i)), kCFNumberLongType, &value);
+        if (value == wanted)
+            return static_cast<CFMutableDictionaryRef>(const_cast<void *>(CFArrayGetValueAtIndex(pb->items, i)));
+    }
+    if (!create)
+        return 0;
+    CFNumberRef number = CFNumberCreate(0, kCFNumberLongType, &wanted);
+    CFMutableDictionaryRef item = CFDictionaryCreateMutable(0, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                            &kCFTypeDictionaryValueCallBacks);
+    CFArrayAppendValue(pb->itemIds, number);
+    CFArrayAppendValue(pb->items, item);
+    CFRelease(number);
+    CFRelease(item);
+    return item;
+}
+
+static void qt_jaguar_clearStore(QtJaguarPasteboard *pb)
+{
+    CFArrayRemoveAllValues(pb->items);
+    CFArrayRemoveAllValues(pb->itemIds);
+}
+
+// Reads the scrap into the store as one item with id 1.
+static void qt_jaguar_readScrap(QtJaguarPasteboard *pb, ScrapRef scrap)
+{
+    qt_jaguar_clearStore(pb);
+    pb->scrap = scrap;
+    UInt32 count = 0;
+    if (GetScrapFlavorCount(scrap, &count) != noErr || !count)
+        return;
+    ScrapFlavorInfo *infos = static_cast<ScrapFlavorInfo *>(malloc(count * sizeof(ScrapFlavorInfo)));
+    if (!infos)
+        return;
+    if (GetScrapFlavorInfoList(scrap, &count, infos) == noErr) {
+        CFMutableDictionaryRef item = qt_jaguar_item(pb, PasteboardItemID(1), true);
+        for (UInt32 i = 0; i < count; ++i) {
+            Size size = 0;
+            if (GetScrapFlavorSize(scrap, infos[i].flavorType, &size) != noErr || size < 0)
+                continue;
+            CFMutableDataRef data = CFDataCreateMutable(0, size);
+            CFDataSetLength(data, size);
+            if (GetScrapFlavorData(scrap, infos[i].flavorType, &size, CFDataGetMutableBytePtr(data)) == noErr) {
+                CFDataSetLength(data, size);
+                CFStringRef flavor = qt_jaguar_utiForType(infos[i].flavorType);
+                CFDictionarySetValue(item, flavor, data);
+                CFRelease(flavor);
+            }
+            CFRelease(data);
+        }
+    }
+    free(infos);
+}
+
+OSStatus qt_jaguar_PasteboardCreate(CFStringRef inName, PasteboardRef *outPasteboard)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardCreate(inName, outPasteboard);
+    if (!outPasteboard)
+        return paramErr;
+    QtJaguarPasteboard *pb = new QtJaguarPasteboard;
+    pb->name = inName ? CFStringCreateCopy(0, inName) : 0;
+    pb->scrapName = 0;
+    if (inName && CFStringCompare(inName, CFSTR("com.apple.pasteboard.clipboard"), 0) == kCFCompareEqualTo)
+        pb->scrapName = kScrapClipboardScrap;
+    else if (inName && CFStringCompare(inName, CFSTR("com.apple.pasteboard.find"), 0) == kCFCompareEqualTo)
+        pb->scrapName = kScrapFindScrap;
+    pb->items = CFArrayCreateMutable(0, 0, &kCFTypeArrayCallBacks);
+    pb->itemIds = CFArrayCreateMutable(0, 0, &kCFTypeArrayCallBacks);
+    pb->keeper = 0;
+    pb->keeperContext = 0;
+    pb->scrap = 0;
+    CFDataRef holder = CFDataCreateWithBytesNoCopy(0, reinterpret_cast<const UInt8 *>(pb), sizeof(*pb),
+                                                   qt_jaguar_pasteboardDeallocator());
+    *outPasteboard = reinterpret_cast<PasteboardRef>(const_cast<__CFData *>(holder));
+    return holder ? noErr : memFullErr;
+}
+
+PasteboardSyncFlags qt_jaguar_PasteboardSynchronize(PasteboardRef inPasteboard)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardSynchronize(inPasteboard);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb || !pb->scrapName)
+        return kPasteboardClientIsOwner;
+    ScrapRef current = 0;
+    if (GetScrapByName(pb->scrapName, kScrapGetNamedScrap, &current) != noErr)
+        return 0;
+    if (current == pb->scrap)
+        return kPasteboardClientIsOwner;
+    // Another application cleared the scrap since this process wrote or
+    // read it; the scrap gets a new reference each time it is cleared.
+    qt_jaguar_readScrap(pb, current);
+    return kPasteboardModified;
+}
+
+OSStatus qt_jaguar_PasteboardClear(PasteboardRef inPasteboard)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardClear(inPasteboard);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb)
+        return paramErr;
+    qt_jaguar_clearStore(pb);
+    if (pb->scrapName)
+        return GetScrapByName(pb->scrapName, kScrapClearNamedScrap, &pb->scrap);
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardPutItemFlavor(PasteboardRef inPasteboard, PasteboardItemID inItem, CFStringRef inFlavorType,
+                                           CFDataRef inData, PasteboardFlavorFlags inFlags)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardPutItemFlavor(inPasteboard, inItem, inFlavorType, inData, inFlags);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb || !inFlavorType)
+        return paramErr;
+    CFMutableDictionaryRef item = qt_jaguar_item(pb, inItem, true);
+    if (!inData) {
+        // A promise: ask for the data now. The keeper puts it with a second
+        // call, which lands in the branch below.
+        CFDictionarySetValue(item, inFlavorType, kCFNull);
+        if (pb->keeper)
+            pb->keeper(inPasteboard, inItem, inFlavorType, pb->keeperContext);
+        return noErr;
+    }
+    CFDictionarySetValue(item, inFlavorType, inData);
+    // Only the first item reaches the scrap, which holds one item.
+    long first = 0;
+    if (pb->scrapName && CFArrayGetCount(pb->itemIds)) {
+        CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(pb->itemIds, 0)), kCFNumberLongType, &first);
+        const OSType type = qt_jaguar_typeForUti(inFlavorType);
+        if (type && long(inItem) == first && pb->scrap)
+            PutScrapFlavor(pb->scrap, type, kScrapFlavorMaskNone, CFDataGetLength(inData), CFDataGetBytePtr(inData));
+    }
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardSetPromiseKeeper(PasteboardRef inPasteboard, PasteboardPromiseKeeperProcPtr inPromiseKeeper, void *inContext)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardSetPromiseKeeper(inPasteboard, inPromiseKeeper, inContext);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb)
+        return paramErr;
+    pb->keeper = inPromiseKeeper;
+    pb->keeperContext = inContext;
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardGetItemCount(PasteboardRef inPasteboard, ItemCount *outItemCount)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardGetItemCount(inPasteboard, outItemCount);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb || !outItemCount)
+        return paramErr;
+    *outItemCount = ItemCount(CFArrayGetCount(pb->items));
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardGetItemIdentifier(PasteboardRef inPasteboard, UInt32 inIndex, PasteboardItemID *outItem)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardGetItemIdentifier(inPasteboard, inIndex, outItem);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    if (!pb || !outItem || inIndex < 1 || CFIndex(inIndex) > CFArrayGetCount(pb->itemIds))
+        return paramErr;
+    long value = 0;
+    CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(pb->itemIds, inIndex - 1)), kCFNumberLongType, &value);
+    *outItem = PasteboardItemID(value);
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardCopyItemFlavors(PasteboardRef inPasteboard, PasteboardItemID inItem, CFArrayRef *outFlavorTypes)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardCopyItemFlavors(inPasteboard, inItem, outFlavorTypes);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    CFMutableDictionaryRef item = pb ? qt_jaguar_item(pb, inItem, false) : 0;
+    if (!item || !outFlavorTypes)
+        return badPasteboardItemErr;
+    const CFIndex count = CFDictionaryGetCount(item);
+    const void **keys = static_cast<const void **>(malloc(sizeof(void *) * (count ? count : 1)));
+    CFDictionaryGetKeysAndValues(item, keys, 0);
+    *outFlavorTypes = CFArrayCreate(0, keys, count, &kCFTypeArrayCallBacks);
+    free(keys);
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardGetItemFlavorFlags(PasteboardRef inPasteboard, PasteboardItemID inItem, CFStringRef inFlavorType,
+                                                PasteboardFlavorFlags *outFlags)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardGetItemFlavorFlags(inPasteboard, inItem, inFlavorType, outFlags);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    CFMutableDictionaryRef item = pb ? qt_jaguar_item(pb, inItem, false) : 0;
+    if (!item || !CFDictionaryContainsKey(item, inFlavorType))
+        return badPasteboardFlavorErr;
+    if (outFlags)
+        *outFlags = kPasteboardFlavorNoFlags;
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardCopyItemFlavorData(PasteboardRef inPasteboard, PasteboardItemID inItem, CFStringRef inFlavorType,
+                                                CFDataRef *outData)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardCopyItemFlavorData(inPasteboard, inItem, inFlavorType, outData);
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(inPasteboard);
+    CFMutableDictionaryRef item = pb ? qt_jaguar_item(pb, inItem, false) : 0;
+    if (!item || !outData)
+        return badPasteboardItemErr;
+    CFTypeRef value = CFDictionaryGetValue(item, inFlavorType);
+    if (!value || value == kCFNull)
+        return badPasteboardFlavorErr;
+    *outData = static_cast<CFDataRef>(CFRetain(value));
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardCopyName(PasteboardRef inPasteboard, CFStringRef *outName)
+{
+    if (&PasteboardCopyName)
+        return PasteboardCopyName(inPasteboard, outName);
+    QtJaguarPasteboard *pb = qt_jaguar_hasPasteboard() ? 0 : qt_jaguar_pasteboard(inPasteboard);
+    if (!pb || !outName)
+        return paramErr;
+    *outName = pb->name ? CFStringCreateCopy(0, pb->name) : CFSTR("");
+    return noErr;
+}
+
+OSStatus qt_jaguar_PasteboardCopyPasteLocation(PasteboardRef inPasteboard, CFURLRef *outPasteLocation)
+{
+    if (qt_jaguar_hasPasteboard())
+        return PasteboardCopyPasteLocation(inPasteboard, outPasteLocation);
+    return paramErr;
+}
+
+// Drags before 10.3 are classic Drag Manager drags. A drag made from a
+// pasteboard carries the pasteboard's flavors that have an OSType, so other
+// applications can take text from it; the drag also remembers the pasteboard,
+// and a drop in this process gets it back with every flavor, Qt's own ones
+// included. A drag from another application is read into a new pasteboard.
+
+static const int qt_jaguar_maxDrags = 8;
+static DragRef qt_jaguar_drags[qt_jaguar_maxDrags];
+static PasteboardRef qt_jaguar_dragBoards[qt_jaguar_maxDrags];
+
+static void qt_jaguar_rememberDrag(DragRef drag, PasteboardRef board)
+{
+    for (int i = 0; i < qt_jaguar_maxDrags; ++i) {
+        if (!qt_jaguar_drags[i]) {
+            qt_jaguar_drags[i] = drag;
+            qt_jaguar_dragBoards[i] = board;
+            CFRetain(board);
+            return;
+        }
+    }
+}
+
+static PasteboardRef qt_jaguar_boardForDrag(DragRef drag)
+{
+    for (int i = 0; i < qt_jaguar_maxDrags; ++i) {
+        if (drag && qt_jaguar_drags[i] == drag)
+            return qt_jaguar_dragBoards[i];
+    }
+    return 0;
+}
+
+static void qt_jaguar_forgetDrag(DragRef drag)
+{
+    for (int i = 0; i < qt_jaguar_maxDrags; ++i) {
+        if (drag && qt_jaguar_drags[i] == drag) {
+            CFRelease(qt_jaguar_dragBoards[i]);
+            qt_jaguar_drags[i] = 0;
+            qt_jaguar_dragBoards[i] = 0;
+        }
+    }
+}
+
+OSStatus qt_jaguar_NewDragWithPasteboard(PasteboardRef inPasteboard, DragRef *outDrag)
+{
+    if (&NewDragWithPasteboard)
+        return NewDragWithPasteboard(inPasteboard, outDrag);
+    const OSStatus err = NewDrag(outDrag);
+    QtJaguarPasteboard *pb = qt_jaguar_hasPasteboard() ? 0 : qt_jaguar_pasteboard(inPasteboard);
+    if (err != noErr || !pb)
+        return err;
+    for (CFIndex i = 0; i < CFArrayGetCount(pb->items); ++i) {
+        long id = 0;
+        CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(pb->itemIds, i)), kCFNumberLongType, &id);
+        CFDictionaryRef item = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(pb->items, i));
+        const CFIndex count = CFDictionaryGetCount(item);
+        const void **keys = static_cast<const void **>(malloc(sizeof(void *) * (count ? count : 1)));
+        const void **values = static_cast<const void **>(malloc(sizeof(void *) * (count ? count : 1)));
+        CFDictionaryGetKeysAndValues(item, keys, values);
+        bool added = false;
+        for (CFIndex f = 0; f < count; ++f) {
+            const OSType type = qt_jaguar_typeForUti(static_cast<CFStringRef>(keys[f]));
+            if (!type || values[f] == kCFNull)
+                continue;
+            CFDataRef data = static_cast<CFDataRef>(values[f]);
+            if (AddDragItemFlavor(*outDrag, DragItemRef(id), type, CFDataGetBytePtr(data),
+                                  CFDataGetLength(data), 0) == noErr)
+                added = true;
+        }
+        if (!added) {
+            // Every item needs a flavor; this one only marks Qt's own data.
+            AddDragItemFlavor(*outDrag, DragItemRef(id), 'QtDd', 0, 0, flavorSenderOnly);
+        }
+        free(keys);
+        free(values);
+    }
+    qt_jaguar_rememberDrag(*outDrag, inPasteboard);
+    return noErr;
+}
+
+OSStatus qt_jaguar_GetDragPasteboard(DragRef inDrag, PasteboardRef *outPasteboard)
+{
+    if (&GetDragPasteboard)
+        return GetDragPasteboard(inDrag, outPasteboard);
+    if (!outPasteboard)
+        return paramErr;
+    *outPasteboard = qt_jaguar_boardForDrag(inDrag);
+    if (*outPasteboard)
+        return noErr;
+    PasteboardRef board = 0;
+    OSStatus err = qt_jaguar_PasteboardCreate(0, &board);
+    if (err != noErr)
+        return err;
+    QtJaguarPasteboard *pb = qt_jaguar_pasteboard(board);
+    UInt16 items = 0;
+    CountDragItems(inDrag, &items);
+    for (UInt16 i = 1; i <= items; ++i) {
+        DragItemRef ref = 0;
+        UInt16 flavors = 0;
+        if (GetDragItemReferenceNumber(inDrag, i, &ref) != noErr
+            || CountDragItemFlavors(inDrag, ref, &flavors) != noErr)
+            continue;
+        CFMutableDictionaryRef item = qt_jaguar_item(pb, PasteboardItemID(ref), true);
+        for (UInt16 f = 1; f <= flavors; ++f) {
+            FlavorType type = 0;
+            Size size = 0;
+            if (GetFlavorType(inDrag, ref, f, &type) != noErr
+                || GetFlavorDataSize(inDrag, ref, type, &size) != noErr || size < 0)
+                continue;
+            CFMutableDataRef data = CFDataCreateMutable(0, size);
+            CFDataSetLength(data, size);
+            if (GetFlavorData(inDrag, ref, type, CFDataGetMutableBytePtr(data), &size, 0) == noErr) {
+                CFDataSetLength(data, size);
+                CFStringRef uti = qt_jaguar_utiForType(type);
+                CFDictionarySetValue(item, uti, data);
+                CFRelease(uti);
+            }
+            CFRelease(data);
+        }
+    }
+    qt_jaguar_rememberDrag(inDrag, board);
+    CFRelease(board);
+    *outPasteboard = board;
+    return noErr;
+}
+
+OSErr qt_jaguar_DisposeDrag(DragRef theDrag)
+{
+    qt_jaguar_forgetDrag(theDrag);
+    return DisposeDrag(theDrag);
+}
