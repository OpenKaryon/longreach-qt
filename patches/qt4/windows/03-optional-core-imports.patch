+#ifndef Q_OS_WINCE
+static BOOL qt_win95_set_file_pointer(HANDLE file, LARGE_INTEGER distance, PLARGE_INTEGER position, DWORD method)
+{
+    typedef BOOL (WINAPI *PtrSetPointer)(HANDLE, LARGE_INTEGER, PLARGE_INTEGER, DWORD);
+    PtrSetPointer setPointer = (PtrSetPointer)GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetFilePointerEx");
+    if (setPointer)
+        return setPointer(file, distance, position, method);
+    // Win9x supports positions below 4 GiB; retain NT's high word when available.
+    if ((QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based) && distance.HighPart != 0) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    LONG high = distance.HighPart;
+    SetLastError(NO_ERROR);
+    DWORD low = SetFilePointer(file, distance.LowPart, &high, method);
+    if (low == INVALID_SET_FILE_POINTER && GetLastError() != NO_ERROR)
+        return FALSE;
+    if (position) {
+        position->LowPart = low;
+        position->HighPart = high;
+    }
+    return TRUE;
+}
+#endif
