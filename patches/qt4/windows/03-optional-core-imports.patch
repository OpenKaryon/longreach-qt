 QT_BEGIN_NAMESPACE
+
+#ifndef Q_OS_WINCE
+static BOOL qt_win95_get_file_attributes(LPCWSTR path, WIN32_FILE_ATTRIBUTE_DATA *data)
+{
+    typedef BOOL (WINAPI *PtrAttributes)(LPCWSTR, GET_FILEEX_INFO_LEVELS, LPVOID);
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based)) {
+        PtrAttributes attributes = (PtrAttributes)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetFileAttributesExW");
+        if (attributes) {
+            if (attributes(path, GetFileExInfoStandard, data))
+                return TRUE;
+            if (GetLastError() != ERROR_CALL_NOT_IMPLEMENTED)
+                return FALSE;
+        }
+    }
+    QString name = QString::fromWCharArray(path);
+    if (name.startsWith(QLatin1String("\\\\?\\UNC\\")))
+        name = QLatin1String("\\\\") + name.mid(8);
+    else if (name.startsWith(QLatin1String("\\\\?\\")))
+        name.remove(0, 4);
+    if (name.contains(QLatin1Char('*')) || name.contains(QLatin1Char('?'))) {
+        SetLastError(ERROR_INVALID_NAME);
+        return FALSE;
+    }
+    QByteArray ansi = name.toLocal8Bit();
+    HANDLE file = QT_WA_INLINE(CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                         0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0),
+                              CreateFileA(ansi.constData(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                         0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0));
+    BY_HANDLE_FILE_INFORMATION info;
+    if (file != INVALID_HANDLE_VALUE) {
+        BOOL ok = GetFileInformationByHandle(file, &info);
+        CloseHandle(file);
+        if (ok) {
+            data->dwFileAttributes = info.dwFileAttributes;
+            data->ftCreationTime = info.ftCreationTime;
+            data->ftLastAccessTime = info.ftLastAccessTime;
+            data->ftLastWriteTime = info.ftLastWriteTime;
+            data->nFileSizeHigh = info.nFileSizeHigh;
+            data->nFileSizeLow = info.nFileSizeLow;
+            return TRUE;
+        }
+    }
+    WIN32_FIND_DATAW wide;
+    WIN32_FIND_DATAA narrow;
+    HANDLE find = QT_WA_INLINE(FindFirstFileW(path, &wide), FindFirstFileA(ansi.constData(), &narrow));
+    if (find == INVALID_HANDLE_VALUE)
+        return FALSE;
+    QT_WA({ memcpy(data, &wide, sizeof(*data)); }, { memcpy(data, &narrow, sizeof(*data)); });
+    FindClose(find);
+    return TRUE;
+}
+#endif
 
