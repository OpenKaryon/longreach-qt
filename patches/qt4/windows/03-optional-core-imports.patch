+static DWORD qt_win95_wait_for_events(DWORD count, const HANDLE *handles, DWORD timeout, DWORD flags)
+{
+#ifndef Q_OS_WINCE
+    typedef DWORD (WINAPI *PtrWait)(DWORD, const HANDLE *, DWORD, DWORD, DWORD);
+    PtrWait wait = (PtrWait)GetProcAddress(GetModuleHandleA("user32.dll"), "MsgWaitForMultipleObjectsEx");
+    if (wait)
+        return wait(count, handles, timeout, QS_ALLINPUT, flags);
+    return MsgWaitForMultipleObjects(count, handles, FALSE, timeout, QS_ALLINPUT);
+#else
+    return MsgWaitForMultipleObjectsEx(count, handles, timeout, QS_ALLINPUT, flags);
+#endif
+}
+
+static BOOL qt_win95_peek_message(MSG *msg, HWND wnd, UINT first, UINT last, UINT remove)
+{
+    return QT_WA_INLINE(PeekMessageW(msg, wnd, first, last, remove), PeekMessageA(msg, wnd, first, last, remove));
+}
+static BOOL qt_win95_get_message(MSG *msg, HWND wnd, UINT first, UINT last)
+{
+    return QT_WA_INLINE(GetMessageW(msg, wnd, first, last), GetMessageA(msg, wnd, first, last));
+}
+static BOOL qt_win95_post_message(HWND wnd, UINT msg, WPARAM wp, LPARAM lp)
+{
