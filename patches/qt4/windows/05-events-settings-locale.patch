 QT_BEGIN_NAMESPACE
 
+static int qt_win95_copy_locale_string(const QByteArray &bytes, wchar_t *buffer, int capacity)
+{
+    const QString text = QString::fromLocal8Bit(bytes.constData());
+    const int required = text.size() + 1;
+    if (capacity == 0)
+        return required;
+    if (!buffer || capacity < required) {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return 0;
+    }
+    memcpy(buffer, text.utf16(), required * sizeof(wchar_t));
+    return required;
+}
+
+static int qt_win95_locale_info(LCID locale, LCTYPE type, wchar_t *buffer, int capacity)
+{
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based))
+        return GetLocaleInfoW(locale, type, buffer, capacity);
+    if (type & LOCALE_RETURN_NUMBER) {
+        const int result = GetLocaleInfoA(locale, type, (LPSTR)buffer, capacity * sizeof(wchar_t));
+        return result ? result / sizeof(wchar_t) : 0;
+    }
+    const int required = GetLocaleInfoA(locale, type, 0, 0);
+    if (!required)
+        return 0;
+    QByteArray bytes(required, '\0');
+    if (!GetLocaleInfoA(locale, type, bytes.data(), bytes.size()))
+        return 0;
+    return qt_win95_copy_locale_string(bytes, buffer, capacity);
+}
+
+static int qt_win95_date_format(LCID locale, DWORD flags, const SYSTEMTIME *time,
+        const wchar_t *format, wchar_t *buffer, int capacity)
+{
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based))
+        return GetDateFormatW(locale, flags, time, format, buffer, capacity);
+    const QByteArray pattern = format ? QString::fromWCharArray(format).toLocal8Bit() : QByteArray();
+    const char *nativePattern = format ? pattern.constData() : 0;
+    int required = GetDateFormatA(locale, flags, time, nativePattern, 0, 0);
+    if (!required)
+        return 0;
+    QByteArray bytes(required, '\0');
+    if (!GetDateFormatA(locale, flags, time, nativePattern, bytes.data(), bytes.size()))
+        return 0;
+    return qt_win95_copy_locale_string(bytes, buffer, capacity);
+}
+
+static int qt_win95_time_format(LCID locale, DWORD flags, const SYSTEMTIME *time,
+        const wchar_t *format, wchar_t *buffer, int capacity)
+{
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based))
+        return GetTimeFormatW(locale, flags, time, format, buffer, capacity);
+    const QByteArray pattern = format ? QString::fromWCharArray(format).toLocal8Bit() : QByteArray();
+    const char *nativePattern = format ? pattern.constData() : 0;
+    int required = GetTimeFormatA(locale, flags, time, nativePattern, 0, 0);
+    if (!required)
+        return 0;
+    QByteArray bytes(required, '\0');
+    if (!GetTimeFormatA(locale, flags, time, nativePattern, bytes.data(), bytes.size()))
+        return 0;
+    return qt_win95_copy_locale_string(bytes, buffer, capacity);
+}
+
+static int qt_win95_currency_format(LCID locale, DWORD flags, const wchar_t *value,
+        const CURRENCYFMTW *format, wchar_t *buffer, int capacity)
+{
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based))
+        return GetCurrencyFormatW(locale, flags, value, format, buffer, capacity);
+    const QByteArray number = QString::fromWCharArray(value).toLocal8Bit();
+    QByteArray decimal, thousand, symbol;
+    CURRENCYFMTA ansi;
+    if (format) {
+        decimal = QString::fromWCharArray(format->lpDecimalSep).toLocal8Bit();
+        thousand = QString::fromWCharArray(format->lpThousandSep).toLocal8Bit();
+        symbol = QString::fromWCharArray(format->lpCurrencySymbol).toLocal8Bit();
+        ansi.NumDigits = format->NumDigits;
+        ansi.LeadingZero = format->LeadingZero;
+        ansi.Grouping = format->Grouping;
+        ansi.lpDecimalSep = decimal.data();
+        ansi.lpThousandSep = thousand.data();
+        ansi.NegativeOrder = format->NegativeOrder;
+        ansi.PositiveOrder = format->PositiveOrder;
+        ansi.lpCurrencySymbol = symbol.data();
+    }
+    const int required = GetCurrencyFormatA(locale, flags, number.constData(), format ? &ansi : 0, 0, 0);
+    if (!required)
+        return 0;
+    QByteArray bytes(required, '\0');
+    if (!GetCurrencyFormatA(locale, flags, number.constData(), format ? &ansi : 0, bytes.data(), bytes.size()))
+        return 0;
+    return qt_win95_copy_locale_string(bytes, buffer, capacity);
+}
