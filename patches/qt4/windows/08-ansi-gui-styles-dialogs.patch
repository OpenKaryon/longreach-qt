+{
+    if (!(QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based)) {
+        typedef DWORD_PTR (WINAPI *ShellFileInfoW)(LPCWSTR, DWORD, SHFILEINFOW *, UINT, UINT);
+        static ShellFileInfoW wide = (ShellFileInfoW)QSystemLibrary::resolve(QLatin1String("shell32"), "SHGetFileInfoW");
+        if (wide)
+            return wide(path, attributes, info, size, flags);
+    }
+    SHFILEINFOA ansi;
+    memset(&ansi, 0, sizeof(ansi));
+    const QByteArray name = QString::fromWCharArray(path).toLocal8Bit();
+    flags &= ~(SHGFI_ADDOVERLAYS | SHGFI_OVERLAYINDEX);
+    DWORD_PTR result = SHGetFileInfoA(name.constData(), attributes, &ansi, sizeof(ansi), flags);
+    if (result) {
+        memset(info, 0, sizeof(*info));
+        info->hIcon = ansi.hIcon;
+        info->iIcon = ansi.iIcon;
+        info->dwAttributes = ansi.dwAttributes;
+    }
+    return result;
+}
