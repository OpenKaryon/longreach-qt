# Windows 9x: Qt3Support's dialogs - ExtractIconExA on Win9x with the W form
# resolved on NT; the directory picker through QFileDialog, so there are no
# static SHBrowseForFolderW/SHGetPathFromIDListW imports.
#
--- a/src/qt3support/dialogs/q3filedialog.cpp
+++ b/src/qt3support/dialogs/q3filedialog.cpp
@@ -4838,6 +4838,23 @@
 
 
 #if defined(Q_WS_WIN)
+
+#ifdef QT_WIN95_SUPPORT
+static UINT qt3_win95_ExtractIconEx(LPCWSTR path, int index,
+                                  HICON *large, HICON *small, UINT count)
+{
+    if (QSysInfo::WindowsVersion & QSysInfo::WV_DOS_based) {
+        const QByteArray local = QString::fromWCharArray(path).toLocal8Bit();
+        return ExtractIconExA(local.constData(), index, large, small, count);
+    }
+    typedef UINT (WINAPI *ExtractIconsW)(LPCWSTR, int, HICON *, HICON *, UINT);
+    ExtractIconsW extract = reinterpret_cast<ExtractIconsW>(
+        GetProcAddress(GetModuleHandleA("shell32.dll"), "ExtractIconExW"));
+    return extract ? extract(path, index, large, small, count) : 0;
+}
+#undef ExtractIconEx
+#define ExtractIconEx qt3_win95_ExtractIconEx
+#endif
 
