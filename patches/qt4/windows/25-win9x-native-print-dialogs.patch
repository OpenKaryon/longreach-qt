+
+// Qt 4.5 used PRINTDLGA/W. Keep this path for Win9x and NT systems whose
+// comdlg32 has no PrintDlgExW. The extended dialog remains available on NT.
+template <class PrintDialog, class DeviceMode>
+static bool qt_win_legacyPrintDialog(QWidget *parent, QPrintDialog *pdlg,
+                                    QPrintDialogPrivate *d,
+                                    BOOL (WINAPI *showDialog)(PrintDialog *))
+{
+    PrintDialog pd;
+    memset(&pd, 0, sizeof(pd));
+    pd.lStructSize = sizeof(pd);
+    const DeviceMode *mode = static_cast<const DeviceMode *>(d->ep->devMode);
+    if (mode) {
+        const int size = mode->dmSize + mode->dmDriverExtra;
+        pd.hDevMode = GlobalAlloc(GHND, size);
+        if (!pd.hDevMode) return false;
+        void *copy = GlobalLock(pd.hDevMode);
+        if (!copy) { GlobalFree(pd.hDevMode); return false; }
+        memcpy(copy, mode, size);
+        GlobalUnlock(pd.hDevMode);
+    }
+    pd.hDevNames = reinterpret_cast<HGLOBAL>(d->ep->createDevNames());
+    if (!pd.hDevNames) { GlobalFree(pd.hDevMode); return false; }
+    pd.hwndOwner = parent ? parent->winId() : 0;
+    pd.Flags = PD_RETURNDC | PD_USEDEVMODECOPIESANDCOLLATE;
+    if (!pdlg->isOptionEnabled(QPrintDialog::PrintSelection)) pd.Flags |= PD_NOSELECTION;
+    if (!pdlg->isOptionEnabled(QPrintDialog::PrintToFile)) pd.Flags |= PD_DISABLEPRINTTOFILE;
+    if (pdlg->isOptionEnabled(QPrintDialog::PrintPageRange)) {
+        pd.nMinPage = qBound(0, pdlg->minPage(), 65535);
+        pd.nMaxPage = qBound(0, pdlg->maxPage(), 65535);
+    }
+    if (!pd.nMinPage && !pd.nMaxPage) pd.Flags |= PD_NOPAGENUMS;
+    if (pdlg->isOptionEnabled(QPrintDialog::PrintSelection)
+            && pdlg->printRange() == QPrintDialog::Selection) pd.Flags |= PD_SELECTION;
+    else if (pdlg->isOptionEnabled(QPrintDialog::PrintPageRange)
+             && pdlg->printRange() == QPrintDialog::PageRange) pd.Flags |= PD_PAGENUMS;
+    if (d->ep->printToFile) pd.Flags |= PD_PRINTTOFILE;
+    pd.nFromPage = qBound(0, qMax(pdlg->fromPage(), pdlg->minPage()), 65535);
+    pd.nToPage = pdlg->toPage() > 0 ? qBound(0, qMin(pdlg->toPage(), pdlg->maxPage()), 65535) : 1;
+    pd.nCopies = qBound(1, d->ep->num_copies, 65535);
+
+    const bool result = showDialog(&pd) && pd.hDC;
+    if (result) {
+        if (pd.Flags & PD_SELECTION) { pdlg->setPrintRange(QPrintDialog::Selection); pdlg->setFromTo(0, 0); }
+        else if (pd.Flags & PD_PAGENUMS) { pdlg->setPrintRange(QPrintDialog::PageRange); pdlg->setFromTo(pd.nFromPage, pd.nToPage); }
+        else { pdlg->setPrintRange(QPrintDialog::AllPages); pdlg->setFromTo(0, 0); }
+        d->ep->printToFile = (pd.Flags & PD_PRINTTOFILE) != 0;
+        d->ep->readDevnames(pd.hDevNames);
+        d->ep->readDevmode(pd.hDevMode); // engine adopts this handle
+        d->ep->updateCustomPaperSize();
+        if (d->ep->printToFile && d->ep->fileName.isEmpty()) d->ep->fileName = d->ep->port;
+        else if (!d->ep->printToFile && d->ep->fileName == QLatin1String("FILE:")) d->ep->fileName.clear();
+    } else if (pd.hDevMode) {
+        GlobalFree(pd.hDevMode);
+    }
+    if (pd.hDC) DeleteDC(pd.hDC);
+    GlobalFree(pd.hDevNames);
+    return result;
+}
