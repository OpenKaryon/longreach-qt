+
+template <class PageDialog, class DeviceMode>
+static bool qt_win_pageSetupDialog(QWin32PrintEnginePrivate *ep, QWidget *parent,
+                                  BOOL (WINAPI *showDialog)(PageDialog *))
+{
+    PageDialog psd;
+    memset(&psd, 0, sizeof(psd));
+    psd.lStructSize = sizeof(psd);
+    const DeviceMode *mode = static_cast<const DeviceMode *>(ep->devMode);
+    if (mode) {
+        const int size = mode->dmSize + mode->dmDriverExtra;
+        psd.hDevMode = GlobalAlloc(GHND, size);
+        if (!psd.hDevMode) return false;
+        void *copy = GlobalLock(psd.hDevMode);
+        if (!copy) { GlobalFree(psd.hDevMode); return false; }
+        memcpy(copy, mode, size);
+        GlobalUnlock(psd.hDevMode);
+    }
+    psd.hDevNames = reinterpret_cast<HGLOBAL>(ep->createDevNames());
+    if (!psd.hDevNames) { GlobalFree(psd.hDevMode); return false; }
+    psd.hwndOwner = parent ? parent->winId() : 0;
+    psd.Flags = PSD_MARGINS;
+    const bool metric = QLocale::system().measurementSystem() == QLocale::MetricSystem;
+    psd.Flags |= metric ? PSD_INHUNDREDTHSOFMILLIMETERS : PSD_INTHOUSANDTHSOFINCHES;
+    const double multiplier = metric ? 1 : 25.4 / 10;
+    const QRect margins = ep->getPageMargins();
+    psd.rtMargin.left = margins.left() / multiplier;
+    psd.rtMargin.top = margins.top() / multiplier;
+    psd.rtMargin.right = margins.width() / multiplier;
+    psd.rtMargin.bottom = margins.height() / multiplier;
+    const bool result = showDialog(&psd);
+    if (result) {
+        ep->readDevnames(psd.hDevNames);
+        ep->readDevmode(psd.hDevMode); // engine adopts the returned handle
+        ep->setPageMargins(psd.rtMargin.left * multiplier, psd.rtMargin.top * multiplier,
+                           psd.rtMargin.right * multiplier, psd.rtMargin.bottom * multiplier);
+        ep->updateCustomPaperSize();
+    } else if (psd.hDevMode) {
+        GlobalFree(psd.hDevMode);
+    }
+    GlobalFree(psd.hDevNames);
+    return result;
+}
