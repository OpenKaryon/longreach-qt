 bool QSystemTrayIconSys::trayMessage(DWORD msg)
 {
+    if (qt_win_trayIsWin9x()) {
+        NOTIFYICONDATAA data;
+        memset(&data, 0, sizeof(data));
+        data.cbSize = notifyIconSize;
+        data.hWnd = winId();
+        data.uID = q_uNOTIFYICONID;
+        if (msg == NIM_ADD || msg == NIM_MODIFY) {
+            data.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP;
+            data.uCallbackMessage = MYWM_NOTIFYICON;
+            data.hIcon = hIcon;
+            QString tip = q->toolTip();
+            QByteArray encoded = tip.toLocal8Bit();
+            while (encoded.size() >= maxTipLength && !tip.isEmpty()) {
+                tip.chop(1); // don't split a multibyte local-codepage character
+                encoded = tip.toLocal8Bit();
+            }
+            memcpy(data.szTip, encoded.constData(), encoded.size() + 1);
+        }
+        // NIM_SETVERSION/NIF_SHOWTIP were introduced after the Win95 shell.
+        return Shell_NotifyIconA(msg, &data);
+    }
     NOTIFYICONDATA tnd;
     memset(&tnd, 0, notifyIconSize);
 
