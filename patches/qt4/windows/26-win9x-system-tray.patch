# callbacks; no balloons there. The Unicode export stays optional.
#
--- a/src/gui/util/qsystemtrayicon_win.cpp
+++ b/src/gui/util/qsystemtrayicon_win.cpp
@@ -101,6 +101,24 @@
 typedef HRESULT (WINAPI *PtrShell_NotifyIconGetRect)(const Q_NOTIFYICONIDENTIFIER* identifier, RECT* iconLocation);
 typedef BOOL (WINAPI *PtrChangeWindowMessageFilter)(UINT message, DWORD dwFlag);
 typedef BOOL (WINAPI *PtrChangeWindowMessageFilterEx)(HWND hWnd, UINT message, DWORD action, void* pChangeFilterStruct);
+
+typedef BOOL (WINAPI *PtrShell_NotifyIconW)(DWORD, PNOTIFYICONDATAW);
+typedef LPVOID (WINAPI *PtrVirtualAllocEx)(HANDLE, LPVOID, SIZE_T, DWORD, DWORD);
+typedef BOOL (WINAPI *PtrVirtualFreeEx)(HANDLE, LPVOID, SIZE_T, DWORD);
+
+static bool qt_win_trayIsWin9x()
+{
+    return QSysInfo::windowsVersion() & QSysInfo::WV_DOS_based;
+}
+
+static BOOL qt_win_notifyIconW(DWORD message, PNOTIFYICONDATAW data)
+{
+    // The Unicode export is absent in the original Win95 shell. Keep it
+    // optional even though the Win9x branch below always calls the ANSI API.
+    static PtrShell_NotifyIconW notify = reinterpret_cast<PtrShell_NotifyIconW>(
+        QSystemLibrary::resolve(QLatin1String("shell32"), "Shell_NotifyIconW"));
+    return notify ? notify(message, data) : FALSE;
+}
 
