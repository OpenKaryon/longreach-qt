@@ -305,6 +308,32 @@ void Abstract3DRenderer::initVolumeTextureShaders(const QString &vertexShader,
                                                   const QString &sliceFrameVertexShader,
                                                   const QString &sliceFrameShader)
 {
+    // A renderer is re-initialised whenever the shadow quality changes, and on
+    // some drivers - Windows XP under VMware, where the graph window's surface
+    // is destroyed and rebuilt on every tab switch - that happens over and over
+    // for the life of the process. Compiling four programs that are already
+    // known not to link, and printing the reason again each time, is how one
+    // unsupported feature turned into a scrolling wall of warnings. The driver
+    // will not have changed its mind, so ask it once.
+    if (volumeShadersUnsupportedForProcess || m_volumeShadersUnsupported) {
+        clearVolumeTextureShaders();
+        return;
+    }
+
+    GLint maxFragmentUniformComponents = 0;
+    glGetIntegerv(GL_MAX_FRAGMENT_UNIFORM_COMPONENTS, &maxFragmentUniformComponents);
+    if (maxFragmentUniformComponents > 0
+            && maxFragmentUniformComponents < minVolumeFragmentUniformComponents) {
+        // The texture shaders need colorIndex[256] plus the other uniforms.
+        // Linking them on old Mesa/VMware XP drivers fails noisily and can
+        // disturb other graph renderers that do not use volume rendering.
+        qWarning("Volume rendering is not available on this driver; volume items "
+                 "will be drawn as plain custom items.");
+        m_volumeShadersUnsupported = true;
+        volumeShadersUnsupportedForProcess = true;
+        clearVolumeTextureShaders();
+        return;
+    }
 
     delete m_volumeTextureShader;
     m_volumeTextureShader = new ShaderHelper(this, vertexShader, fragmentShader);
@@ -321,6 +349,38 @@ void Abstract3DRenderer::initVolumeTextureShaders(const QString &vertexShader,
     delete m_volumeSliceFrameShader;
     m_volumeSliceFrameShader = new ShaderHelper(this, sliceFrameVertexShader, sliceFrameShader);
     m_volumeSliceFrameShader->initialize();
+
+    // Volume rendering asks for more than some drivers have. The three texture
+    // shaders declare "uniform highp vec4 colorIndex[256]", which is 1024
+    // fragment uniform components in that one array, and a driver only has to
+    // offer GL_MAX_FRAGMENT_UNIFORM_COMPONENTS of them - Mesa 10.0 on VMware's
+    // SVGA3D, for one, offers 896, so the link fails no matter what else the
+    // program contains.
+    //
+    // These four are built for every graph whether or not it will ever hold a
+    // QCustom3DVolume, so on such a driver a graph that renders bars perfectly
+    // well still drags four dead programs behind it. Drop them: a null shader
+    // is what the draw path checks for, and a volume item now renders as an
+    // ordinary custom item instead of through a program that cannot run.
+    if (!m_volumeTextureShader->isInitialized()) {
+        qWarning("Volume rendering is not available on this driver; volume items "
+                 "will be drawn as plain custom items.");
+        m_volumeShadersUnsupported = true;
+        volumeShadersUnsupportedForProcess = true;
+        clearVolumeTextureShaders();
+    }
+}
+
+void Abstract3DRenderer::clearVolumeTextureShaders()
+{
+    delete m_volumeTextureShader;
+    delete m_volumeTextureLowDefShader;
+    delete m_volumeTextureSliceShader;
+    delete m_volumeSliceFrameShader;
+    m_volumeTextureShader = 0;
+    m_volumeTextureLowDefShader = 0;
+    m_volumeTextureSliceShader = 0;
+    m_volumeSliceFrameShader = 0;
 }
 
