#
# QtLocation: mapbox-gl-native's unique_any.hpp uses std::move and
# std::forward without including <utility>. Older libc++ headers pulled it in
# through <type_traits> or <stdexcept>; libc++ 14 (the static runtime of the
# OS X 10.6 target) does not.
#
# Apply: git apply, from the Qt source root
diff --git a/qtlocation/src/3rdparty/mapbox-gl-native/include/mbgl/util/unique_any.hpp b/qtlocation/src/3rdparty/mapbox-gl-native/include/mbgl/util/unique_any.hpp
--- a/qtlocation/src/3rdparty/mapbox-gl-native/include/mbgl/util/unique_any.hpp
+++ b/qtlocation/src/3rdparty/mapbox-gl-native/include/mbgl/util/unique_any.hpp
@@ -1,6 +1,7 @@
 #pragma once
 
 #include <typeinfo>
+#include <utility>
 #include <type_traits>
 #include <stdexcept>
 namespace mbgl {
