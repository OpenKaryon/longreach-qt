--- a/qtbase/src/plugins/platforms/android/androidjnimain.cpp
+++ b/qtbase/src/plugins/platforms/android/androidjnimain.cpp
@@ -61,6 +61,7 @@
 #include <android/api-level.h>
 
 #include <QtCore/private/qjnihelpers_p.h>
+#include <QtCore/qatomic.h>
 #include <QtCore/private/qjni_p.h>
 #include <QtCore/qbasicatomic.h>
 #include <QtCore/qresource.h>
@@ -357,6 +358,16 @@
 
     jint generateViewId()
     {
+        if (QtAndroidPrivate::androidSdkVersion() < 17) {
+            // Same non-resource ID range as View.generateViewId().
+            static QAtomicInt nextId(1);
+            for (;;) {
+                const int id = nextId.loadRelaxed();
+                const int next = id == 0x00ffffff ? 1 : id + 1;
+                if (nextId.testAndSetRelaxed(id, next))
+                    return id;
+            }
+        }
         return QJNIObjectPrivate::callStaticMethod<jint>("android/view/View","generateViewId",
                                                          "()I");
     }
