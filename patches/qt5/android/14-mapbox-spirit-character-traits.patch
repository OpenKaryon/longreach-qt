# Keep Spirit's C wide-character classifier compilable when libc++ wide
# iostreams and their std::char_traits<wchar_t> specialization are disabled.

--- a/qtlocation/src/3rdparty/mapbox-gl-native/deps/boost/1.65.1/include/boost/spirit/home/support/char_encoding/standard_wide.hpp
+++ b/qtlocation/src/3rdparty/mapbox-gl-native/deps/boost/1.65.1/include/boost/spirit/home/support/char_encoding/standard_wide.hpp
@@ -35,6 +35,24 @@
 
 namespace boost { namespace spirit { namespace char_encoding
 {
+
+    namespace detail {
+        template <typename Char>
+        struct standard_wide_traits : std::char_traits<Char> {};
+
+#if defined(_LIBCPP_HAS_WIDE_CHARACTERS) && !_LIBCPP_HAS_WIDE_CHARACTERS
+        template <>
+        struct standard_wide_traits<wchar_t>
+        {
+            typedef ::wint_t int_type;
+            static int_type to_int_type(wchar_t value)
+            { return static_cast<int_type>(value); }
+            static wchar_t to_char_type(int_type value)
+            { return static_cast<wchar_t>(value); }
+        };
+#endif
+    }
+
     ///////////////////////////////////////////////////////////////////////////
     //  Test characters for specified conditions (using std wchar_t functions)
     ///////////////////////////////////////////////////////////////////////////
@@ -44,17 +62,17 @@
         typedef wchar_t char_type;
 
         template <typename Char>
-        static typename std::char_traits<Char>::int_type
+        static typename detail::standard_wide_traits<Char>::int_type
         to_int_type(Char ch)
         {
-            return std::char_traits<Char>::to_int_type(ch);
+            return detail::standard_wide_traits<Char>::to_int_type(ch);
         }
 
         template <typename Char>
         static Char
-        to_char_type(typename std::char_traits<Char>::int_type ch)
-        {
-            return std::char_traits<Char>::to_char_type(ch);
+        to_char_type(typename detail::standard_wide_traits<Char>::int_type ch)
+        {
+            return detail::standard_wide_traits<Char>::to_char_type(ch);
         }
 
         static bool
