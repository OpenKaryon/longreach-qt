@@ -103,6 +106,24 @@
 QT_BEGIN_NAMESPACE
 
 #if QT_CONFIG(thread)
+
+#ifdef Q_OS_ANDROID
+// Old Bionic requires a page-aligned allocation; preserve the public request.
+static int qt_android_set_stack_size(pthread_attr_t *attr, size_t requested)
+{
+    const long pageSize = sysconf(_SC_PAGESIZE);
+    if (pageSize <= 0 || requested < PTHREAD_STACK_MIN)
+        return pthread_attr_setstacksize(attr, requested);
+
+    const size_t remainder = requested % size_t(pageSize);
+    const size_t padding = remainder ? size_t(pageSize) - remainder : 0;
+    const size_t rounded = requested + padding;
+    if (rounded < requested)
+        return EINVAL;
+    return pthread_attr_setstacksize(attr, rounded);
+}
+#endif
+
 
 Q_STATIC_ASSERT(sizeof(pthread_t) <= sizeof(Qt::HANDLE));
 
