# Load long bundled library paths on Android API21/22.

--- a/qtbase/src/corelib/plugin/qlibrary_unix.cpp
+++ b/qtbase/src/corelib/plugin/qlibrary_unix.cpp
@@ -237,6 +237,14 @@
 
             hnd = dlopen(QFile::encodeName(attempt), dlFlags);
 #ifdef Q_OS_ANDROID
+            // API21/22 LP64 rejects long full paths; LP32 normally uses basenames.
+            // Retain the basename retry across ABIs for existing bundled plugins.
+            if (!hnd && QtAndroidPrivate::androidSdkVersion() <= 22
+                    && attempt.startsWith(QLatin1Char('/'))
+                    && QFile::encodeName(attempt).size() >= 128 && QFile::exists(attempt)) {
+                const auto bundledName = attempt.mid(attempt.lastIndexOf(QLatin1Char('/')) + 1);
+                hnd = dlopen(QFile::encodeName(bundledName), dlFlags);
+            }
             // Preserve the actual linker error for an existing native file.
             // Flattening is only useful for paths to bundled/extracted plugins.
             if (!hnd && !(attempt.startsWith(QLatin1Char('/')) && QFile::exists(attempt))) {
