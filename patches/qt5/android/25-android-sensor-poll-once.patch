# Keep the sensor loop responsive with NDK r27 and older Android runtimes.

--- a/qtsensors/src/plugins/sensors/android/sensormanager.cpp
+++ b/qtsensors/src/plugins/sensors/android/sensormanager.cpp
@@ -114,7 +114,7 @@
     m_looper = ALooper_prepare(0);
     m_waitForStart.release();
     do {
-        if (ALooper_pollAll(5 /*ms*/, nullptr, nullptr, nullptr) == ALOOPER_POLL_TIMEOUT)
+        if (ALooper_pollOnce(5 /*ms*/, nullptr, nullptr, nullptr) == ALOOPER_POLL_TIMEOUT)
             QThread::yieldCurrentThread();
     } while (!m_quit.load());
 }
