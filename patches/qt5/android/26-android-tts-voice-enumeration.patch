+    public synchronized boolean usesLegacyVoices()
+    {
+        if (Build.VERSION.SDK_INT < 21)
+            return true;
+        if (!mVoiceModeKnown && mInitialized && mTts != null) {
+            // Decide once, after initialization. An empty/null/throwing first
+            // enumeration selects language-based voices for this instance.
+            // Later enumeration failures must not reinterpret a voice name as
+            // a locale (or switch language-based voices to named voices).
+            mLegacyVoices = getAvailableVoices().isEmpty();
+            mVoiceModeKnown = true;
+        }
+        // Before initialization no API21 voices have been published; do not
+        // freeze the mode from an unavailable engine. Recreate to choose again.
+        return mLegacyVoices;
+    }
