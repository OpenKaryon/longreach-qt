# Select the Android condition clock by runtime capability, not API10 headers.

--- a/qtbase/src/corelib/thread/qwaitcondition_unix.cpp
+++ b/qtbase/src/corelib/thread/qwaitcondition_unix.cpp
@@ -80,14 +80,14 @@
     pthread_condattr_t condattr;
 
     pthread_condattr_init(&condattr);
-#if (_POSIX_MONOTONIC_CLOCK-0 >= 0)
 #if defined(Q_OS_ANDROID)
+    // The API10 headers do not advertise _POSIX_MONOTONIC_CLOCK, even when
+    // this same binary runs on API21. Match wait_relative's runtime choice.
     if (local_condattr_setclock && QElapsedTimer::clockType() == QElapsedTimer::MonotonicClock)
         local_condattr_setclock(&condattr, CLOCK_MONOTONIC);
-#elif !defined(Q_OS_MAC)
+#elif (_POSIX_MONOTONIC_CLOCK-0 >= 0) && !defined(Q_OS_MAC)
     if (QElapsedTimer::clockType() == QElapsedTimer::MonotonicClock)
         pthread_condattr_setclock(&condattr, CLOCK_MONOTONIC);
-#endif
 #endif
     report_error(pthread_cond_init(cond, &condattr), where, "cv init");
     pthread_condattr_destroy(&condattr);
