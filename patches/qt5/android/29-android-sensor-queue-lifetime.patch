+// Backends never wait for the looper during QObject destruction. Keep the
+// queue and callback context alive until a complete dispatch has returned.
+void SensorManager::retireQueue(const std::function<void()> &cleanup)
+{
+    auto retired = new RetiredQueue{cleanup, nullptr};
+    auto head = m_retiredQueues.load(std::memory_order_relaxed);
+    do {
+        retired->next = head;
+    } while (!m_retiredQueues.compare_exchange_weak(head, retired,
+                 std::memory_order_release, std::memory_order_relaxed));
+    // Backends can outlive aboutToQuit. Once dispatch has stopped, there is
+    // no native callback to wait for and no worker left to drain this list.
+    if (m_dispatchStopped.load(std::memory_order_acquire))
+        drainRetiredQueues();
+}
+
+void SensorManager::drainRetiredQueues()
+{
+    auto retired = m_retiredQueues.exchange(nullptr, std::memory_order_acquire);
+    while (retired) {
+        auto next = retired->next;
+        retired->cleanup();
+        delete retired;
+        retired = next;
+    }
 }
 
