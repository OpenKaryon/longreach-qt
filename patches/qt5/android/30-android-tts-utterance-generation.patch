+// SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-or-later
+// Copyright (C) 2026 OpenKaryon
+#ifndef QANDROIDTTSUTTERANCE_P_H
+#define QANDROIDTTSUTTERANCE_P_H
+
+#include <limits>
+
+// Owned by the engine's Qt thread. Check tokens on delivery, not on a Binder
+// thread: an old completion may already be queued when the next say starts.
+class QAndroidTtsUtterance
+{
+public:
+    typedef long long Token;
+    QAndroidTtsUtterance() : m_generation(0), m_active(false) {}
+
+    Token begin()
+    {
+        invalidate();
+        m_active = true;
+        return m_generation;
+    }
+
+    Token invalidate()
+    {
+        m_active = false;
+        if (m_generation == (std::numeric_limits<Token>::max)())
+            m_generation = 0;
+        return ++m_generation;
+    }
+
+    bool isCurrent(Token generation) const { return generation == m_generation; }
+    bool accepts(Token generation) const { return m_active && isCurrent(generation); }
+    bool isActive() const { return m_active; }
+
+    bool finish(Token generation)
+    {
+        if (!accepts(generation))
+            return false;
+        m_active = false;
+        return true;
+    }
+
+private:
+    Token m_generation;
+    bool m_active;
+};
+
+#endif
