# Complete existing Qt cleanup after explicit main return on API10.
--- a/qtbase/src/android/jar/src/org/qtproject/qt5/android/QtActivityDelegate.java
+++ b/qtbase/src/android/jar/src/org/qtproject/qt5/android/QtActivityDelegate.java
@@ -143,6 +143,7 @@
     private QtEditText m_editText = null;
     private InputMethodManager m_imm = null;
     private boolean m_quitApp = true;
+    private boolean m_applicationTerminating = false;
     private View m_dummyView = null;
     private boolean m_keyboardIsVisible = false;
     public boolean m_backKeyPressedSent = false;
@@ -1018,12 +1019,21 @@
 
     public void onDestroy()
     {
-        if (m_quitApp) {
-            QtNative.terminateQt();
-            QtNative.setActivity(null, null);
-            QtNative.m_qtThread.exit();
-            System.exit(0);
-        }
+        if (m_quitApp)
+            terminateApplication();
+    }
+
+    // Called on Android's UI thread, either by onDestroy or after an explicit
+    // native main return on API10. Keep the existing native/JNI/thread cleanup.
+    public void terminateApplication()
+    {
+        if (m_applicationTerminating)
+            return;
+        m_applicationTerminating = true;
+        QtNative.terminateQt();
+        QtNative.setActivity(null, null);
+        QtNative.m_qtThread.exit();
+        System.exit(0);
     }
 
     public void onPause()
--- a/qtbase/src/android/jar/src/org/qtproject/qt5/android/QtNative.java
+++ b/qtbase/src/android/jar/src/org/qtproject/qt5/android/QtNative.java
@@ -512,6 +512,13 @@
                      m_service.stopSelf();
 
                  m_started = false;
+                 // API10 can leave an explicitly finishing Activity in
+                 // STOPPING without delivering onDestroy (also without Qt).
+                 // Native main already returned: complete our existing cleanup
+                 // instead of keeping the native exit semaphore waiting forever.
+                 if (Build.VERSION.SDK_INT < 11 && m_activity != null
+                         && m_activity.isFinishing() && m_activityDelegate != null)
+                     m_activityDelegate.terminateApplication();
             }
         });
     }
