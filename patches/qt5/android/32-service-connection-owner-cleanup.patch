# Detach owned service callbacks without changing the C++ object layout.
--- a/qtandroidextras/src/androidextras/android/qandroidserviceconnection.cpp
+++ b/qtandroidextras/src/androidextras/android/qandroidserviceconnection.cpp
@@ -80,7 +80,16 @@
 
 QAndroidServiceConnection::~QAndroidServiceConnection()
 {
-    m_handle.callMethod<void>("setId", "(J)V", jlong(this));
+    if (!m_handle.isValid())
+        return;
+    QAndroidJniExceptionCleaner cleaner;
+    QAndroidJniEnvironment env;
+    const jclass connectionClass = env.findClass("org/qtproject/qt5/android/extras/QtAndroidServiceConnection");
+    if (connectionClass && env->IsInstanceOf(m_handle.object(), connectionClass)) {
+        const jmethodID clearId = env->GetMethodID(connectionClass, "clearId", "(J)V");
+        if (clearId)
+            env->CallNonvirtualVoidMethod(m_handle.object(), connectionClass, clearId, jlong(this));
+    }
 }
 
