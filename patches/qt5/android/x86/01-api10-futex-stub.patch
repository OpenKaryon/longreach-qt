# API10 i386: use the exported six-argument Bionic stub for Qt futex results.

--- a/qtbase/src/corelib/thread/qfutex_p.h
+++ b/qtbase/src/corelib/thread/qfutex_p.h
@@ -76,6 +76,11 @@
 #  include <unistd.h>
 #  include <asm/unistd.h>
 #  include <linux/futex.h>
+#  if defined(Q_OS_ANDROID) && defined(__i386__) && __ANDROID_API__ < 21
+// Gingerbread's variadic syscall() restores EAX instead of returning its result.
+// The exported Bionic futex stub preserves the kernel result and errno.
+extern "C" int futex(void *, int, int, void *, void *, int);
+#  endif
 #  define QT_ALWAYS_USE_FUTEX
 
 // if not defined in linux/futex.h
@@ -113,7 +118,12 @@
 
         // we use __NR_futex because some libcs (like Android's bionic) don't
         // provide SYS_futex etc.
+#  if defined(Q_OS_ANDROID) && defined(__i386__) && __ANDROID_API__ < 21
+        int result = ::futex(addr, op | FUTEX_PRIVATE_FLAG, val,
+                             reinterpret_cast<void *>(val2), addr2, val3);
+#  else
         int result = syscall(__NR_futex, addr, op | FUTEX_PRIVATE_FLAG, val, val2, addr2, val3);
+#  endif
 
         _q_tsan_acquire(addr, addr2);
 
