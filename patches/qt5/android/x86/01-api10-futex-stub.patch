# API10 i386: bypass the broken variadic syscall() without importing libc futex.
# Preserve PIC registers and libc error semantics for Qt's WAIT/WAKE operations.
# QSemaphore's six-argument WAKE_OP path is disabled when QT_POINTER_SIZE == 4.
# Checked against Qt 5.15.19 qfutex_p.h/qsemaphore.cpp and Bionic 2.3.7 x86 ABI.

--- a/qtbase/src/corelib/thread/qfutex_p.h
+++ b/qtbase/src/corelib/thread/qfutex_p.h
@@ -113,7 +113,38 @@
 
         // we use __NR_futex because some libcs (like Android's bionic) don't
         // provide SYS_futex etc.
+#  if defined(Q_OS_ANDROID) && defined(__i386__) && __ANDROID_API__ < 21
+        // Only WAIT/WAKE reach this 32-bit path. QSemaphore uses WAKE_OP only
+        // when QT_POINTER_SIZE > 4; reject extra arguments instead of passing
+        // the PIC register/frame pointer as the fifth/sixth syscall argument.
+        const bool supported = !addr2 && !val3 && (op == FUTEX_WAIT || op == FUTEX_WAKE);
+        Q_ASSERT_X(supported, "QtLinuxFutex::_q_futex", "unexpected legacy x86 futex operation");
+        int result;
+        if (Q_UNLIKELY(!supported)) {
+            errno = ENOSYS;
+            result = -1;
+        } else {
+            // Gingerbread's variadic syscall() loses EAX. Its libc futex()
+            // stub disappears on newer Android, so issue the kernel call
+            // directly. Swap EBX with EDI around the trap to preserve PIC;
+            // ESI supplies the fourth argument without touching EBP or ESP.
+            asm volatile("xchgl %%ebx, %%edi\n\t"
+                         "int $0x80\n\t"
+                         "xchgl %%ebx, %%edi"
+                         : "=a"(result)
+                         : "0"(__NR_futex), "D"(addr), "c"(op | FUTEX_PRIVATE_FLAG),
+                           "d"(val), "S"(val2)
+                         : "memory", "cc");
+            // Match libc's -1/errno contract. On success leave errno alone;
+            // a preceding timeout must not turn a successful wakeup into one.
+            if (uint(result) > uint(-4096)) {
+                errno = -result;
+                result = -1;
+            }
+        }
+#  else
         int result = syscall(__NR_futex, addr, op | FUTEX_PRIVATE_FLAG, val, val2, addr2, val3);
+#  endif
 
         _q_tsan_acquire(addr, addr2);
 
