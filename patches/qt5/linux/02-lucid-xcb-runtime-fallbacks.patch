# Lucid (Ubuntu 10.04, libxcb 1.5, libX11 1.3.2): run-time fallbacks in the
# xcb plugin. Each newer facility is used when the system provides it.
#
# - xcb_poll_for_queued_event (libxcb 1.8) is looked up with dlsym; without
#   it the event reader takes one event per xcb_wait_for_event instead of
#   draining with xcb_poll_for_event, which on libxcb 1.5 can steal a reply
#   the GUI thread waits for (intermittent hang, e.g. QSystemTrayIcon).
# - libX11-xcb is not on a stock Lucid install. The target links a stub
#   (scripts/build/qt5-lucid/x11-xcb-stub.c) that loads libX11-xcb.so.1 when
#   present; otherwise XGetXCBConnection returns null and the plugin opens a
#   plain xcb connection without Xlib. The few Xlib calls (XFlush, XSync,
#   XSetWMName, Xcursor, font cursors) are then skipped, the GLX integration
#   reports OpenGL as unavailable so Qt Quick picks its software renderer,
#   and the connection is closed with xcb_disconnect. With libx11-xcb1
#   installed, Xlib and GLX work as usual.
#
--- a/qtbase/src/plugins/platforms/xcb/gl_integrations/xcb_glx/qxcbglxintegration.cpp
+++ b/qtbase/src/plugins/platforms/xcb/gl_integrations/xcb_glx/qxcbglxintegration.cpp
@@ -106,6 +106,10 @@
 bool QXcbGlxIntegration::initialize(QXcbConnection *connection)
 {
     m_connection = connection;
+    // GLX goes through Xlib; without libX11-xcb (stock Ubuntu 10.04) there is
+    // no Xlib display and OpenGL is reported as unavailable.
+    if (!connection->xlib_display())
+        return false;
 #if QT_CONFIG(xcb_glx)
 
     const xcb_query_extension_reply_t *reply = xcb_get_extension_data(m_connection->xcb_connection(), &xcb_glx_id);
