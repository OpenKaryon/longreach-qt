--- a/qtbase/src/plugins/platforms/xcb/qxcbeventqueue.cpp
+++ b/qtbase/src/plugins/platforms/xcb/qxcbeventqueue.cpp
@@ -37,6 +37,8 @@
 **
 ****************************************************************************/
 #include "qxcbeventqueue.h"
+
+#include <dlfcn.h>
 #include "qxcbconnection.h"
 
 #include <QtCore/QObject>
@@ -47,6 +49,21 @@
 
 QT_BEGIN_NAMESPACE
 
+// xcb_poll_for_queued_event appeared in libxcb 1.8; Ubuntu 10.04 has 1.5.
+// Use the system's function when it has one. Without it, drain nothing:
+// xcb_poll_for_event would read the socket, and on libxcb 1.5 that can
+// consume a reply the GUI thread is waiting for in xcb_wait_for_reply, which
+// then blocks for good (the race libxcb 1.8 added the function to avoid).
+// The loop below then takes one event per xcb_wait_for_event, which returns
+// already queued events at once.
+static xcb_generic_event_t *pollForQueuedEvent(xcb_connection_t *connection)
+{
+    typedef xcb_generic_event_t *(*PollForQueued)(xcb_connection_t *);
+    static const PollForQueued pollForQueued =
+            reinterpret_cast<PollForQueued>(dlsym(RTLD_DEFAULT, "xcb_poll_for_queued_event"));
+    return pollForQueued ? pollForQueued(connection) : nullptr;
+}
+
 static QBasicMutex qAppExiting;
 static bool dispatcherOwnerDestructing = false;
 
@@ -230,7 +247,7 @@
         // Currently only the clipboard implementation relies on it.
         m_newEventsMutex.lock();
         enqueueEvent(event);
-        while (!m_closeConnectionDetected && (event = xcb_poll_for_queued_event(connection)))
+        while (!m_closeConnectionDetected && (event = pollForQueuedEvent(connection)))
             enqueueEvent(event);
 
         m_newEventsCondition.wakeOne();
