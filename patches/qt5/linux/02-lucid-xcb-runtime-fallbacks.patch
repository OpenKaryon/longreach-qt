 #if QT_CONFIG(xcb_xlib)
-    qt_XFlush(static_cast<Display *>(xlib_display()));
+    if (xlib_display())
+        qt_XFlush(static_cast<Display *>(xlib_display()));
 #endif
 
     xcb_flush(xcb_connection());
