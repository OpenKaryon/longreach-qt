# Lucid (glibc 2.11): QtLocation's bundled mapbox-gl-native names its threads
# with pthread_setname_np/pthread_getname_np (glibc 2.12) and lowers priority
# with SCHED_IDLE, which glibc 2.11's headers do not define. Use the pthread
# functions when the C library has them (looked up at run time), else
# prctl(PR_SET_NAME/PR_GET_NAME); define SCHED_IDLE (kernel 2.6.23+) if missing.
#
--- a/qtlocation/src/3rdparty/mapbox-gl-native/platform/default/thread.cpp
+++ b/qtlocation/src/3rdparty/mapbox-gl-native/platform/default/thread.cpp
@@ -3,25 +3,42 @@
 
 #include <string>
 
+#include <dlfcn.h>
 #include <pthread.h>
 #include <sched.h>
+#include <sys/prctl.h>
+
+// glibc 2.11 (Ubuntu 10.04) has neither pthread_getname_np/pthread_setname_np
+// (2.12) nor SCHED_IDLE in its headers. The kernel has had PR_SET_NAME since
+// 2.6.9 and SCHED_IDLE since 2.6.23. Use the pthread functions when the C
+// library provides them; these calls only ever name the calling thread.
+#ifndef SCHED_IDLE
+#define SCHED_IDLE 5
+#endif
 
 namespace mbgl {
 namespace platform {
 
 std::string getCurrentThreadName() {
     char name[32] = "unknown";
-    pthread_getname_np(pthread_self(), name, sizeof(name));
+    typedef int (*GetName)(pthread_t, char *, size_t);
+    static const GetName getName = reinterpret_cast<GetName>(dlsym(RTLD_DEFAULT, "pthread_getname_np"));
+    if (getName)
+        getName(pthread_self(), name, sizeof(name));
+    else
+        prctl(PR_GET_NAME, name, 0, 0, 0);
 
     return name;
 }
 
 void setCurrentThreadName(const std::string& name) {
-    if (name.size() > 15) { // Linux hard limit (see manpages).
-        pthread_setname_np(pthread_self(), name.substr(0, 15).c_str());
-    } else {
-        pthread_setname_np(pthread_self(), name.c_str());
-    }
+    const std::string limited = name.size() > 15 ? name.substr(0, 15) : name; // Linux hard limit (see manpages).
+    typedef int (*SetName)(pthread_t, const char *);
+    static const SetName setName = reinterpret_cast<SetName>(dlsym(RTLD_DEFAULT, "pthread_setname_np"));
+    if (setName)
+        setName(pthread_self(), limited.c_str());
+    else
+        prctl(PR_SET_NAME, limited.c_str(), 0, 0, 0);
 }
 
