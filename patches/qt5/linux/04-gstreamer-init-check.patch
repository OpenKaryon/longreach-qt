#
# Linux: no GStreamer services where GStreamer cannot be initialized.
#
# The Lucid build links GStreamer through stubs that load it at run time
# (scripts/build/dlopen); Lucid itself, and many a later system, has no
# GStreamer 1.0. Qt's GStreamer plugins call gst_init and then go on as if it
# had worked. QGstUtils::initializeGst now calls gst_init_check and reports
# the result; the service plugins create no service when it failed, so
# QMediaPlayer, QCamera and QAudioDecoder report the service missing, and the
# supported MIME types are empty.
diff --git a/qtmultimedia/src/gsttools/qgstutils.cpp b/qtmultimedia/src/gsttools/qgstutils.cpp
--- a/qtmultimedia/src/gsttools/qgstutils.cpp
+++ b/qtmultimedia/src/gsttools/qgstutils.cpp
@@ -465,13 +465,10 @@ GstCaps *QGstUtils::capsForAudioFormat(const QAudioFormat &format)
 #endif
 }
 
-void QGstUtils::initializeGst()
+bool QGstUtils::initializeGst()
 {
-    static bool initialized = false;
-    if (!initialized) {
-        initialized = true;
-        gst_init(nullptr, nullptr);
-    }
+    static const bool initialized = gst_init_check(nullptr, nullptr, nullptr);
+    return initialized;
 }
 
 namespace {
@@ -807,7 +804,8 @@ QSet<QString> QGstUtils::supportedMimeTypes(bool (*isValidFactory)(GstElementFac
     QSet<QString> supportedMimeTypes;
 
     //enumerate supported mime types
-    gst_init(nullptr, nullptr);
+    if (!initializeGst())
+        return supportedMimeTypes;
 
 #if GST_CHECK_VERSION(1,0,0)
     GstRegistry *registry = gst_registry_get();
diff --git a/qtmultimedia/src/gsttools/qgstutils_p.h b/qtmultimedia/src/gsttools/qgstutils_p.h
--- a/qtmultimedia/src/gsttools/qgstutils_p.h
+++ b/qtmultimedia/src/gsttools/qgstutils_p.h
@@ -106,7 +106,7 @@ namespace QGstUtils {
     Q_GSTTOOLS_EXPORT QAudioFormat audioFormatForBuffer(GstBuffer *buffer);
 #endif
     Q_GSTTOOLS_EXPORT GstCaps *capsForAudioFormat(const QAudioFormat &format);
-    Q_GSTTOOLS_EXPORT void initializeGst();
+    Q_GSTTOOLS_EXPORT bool initializeGst();
     Q_GSTTOOLS_EXPORT QMultimedia::SupportEstimate hasSupport(const QString &mimeType,
                                              const QStringList &codecs,
                                              const QSet<QString> &supportedMimeTypeSet);
