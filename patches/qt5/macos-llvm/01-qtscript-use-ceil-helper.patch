# Preserve JavaScript negative zero without redefining ceil in libc++ headers.
--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/wtf/MathExtras.h
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/wtf/MathExtras.h
@@ -68,14 +68,15 @@
 const float piOverFourFloat = static_cast<float>(M_PI_4);
 #endif
 
+inline double wtf_ceil(double x)
+{
 #if OS(DARWIN)
-
-// Work around a bug in the Mac OS X libc where ceil(-0.1) return +0.
-inline double wtf_ceil(double x) { return copysign(ceil(x), x); }
-
-#define ceil(x) wtf_ceil(x)
-
-#endif
+    // Preserve negative zero on systems whose libc returns positive zero.
+    return copysign(ceil(x), x);
+#else
+    return ceil(x);
+#endif
+}
 
 #if OS(SOLARIS) && __cplusplus < 201103L
 
--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/MathObject.cpp
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/MathObject.cpp
@@ -139,7 +139,7 @@
 
 JSValue JSC_HOST_CALL mathProtoFuncCeil(ExecState* exec, JSObject*, JSValue, const ArgList& args)
 {
-    return jsNumber(exec, ceil(args.at(0).toNumber(exec)));
+    return jsNumber(exec, wtf_ceil(args.at(0).toNumber(exec)));
 }
 
 JSValue JSC_HOST_CALL mathProtoFuncCos(ExecState* exec, JSObject*, JSValue, const ArgList& args)
@@ -218,7 +218,7 @@
     double arg = args.at(0).toNumber(exec);
     if (std::signbit(arg) && arg >= -0.5)
          return jsNumber(exec, -0.0);
-    double integer = ceil(arg);
+    double integer = wtf_ceil(arg);
     return jsNumber(exec, integer - (integer - arg > 0.5));
 }
 
--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/NumberPrototype.cpp
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/NumberPrototype.cpp
@@ -335,7 +335,7 @@
         x /= pow(10.0, logx);
         const double tenToTheF = pow(10.0, fractionalDigits);
         double fx = floor(x * tenToTheF) / tenToTheF;
-        double cx = ceil(x * tenToTheF) / tenToTheF;
+        double cx = wtf_ceil(x * tenToTheF) / tenToTheF;
 
         if (fabs(fx - x) < fabs(cx - x))
             x = fx;
--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/JSGlobalObjectFunctions.cpp
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/JSGlobalObjectFunctions.cpp
@@ -310,7 +310,7 @@
     if (value.isDouble()) {
         double d = value.asDouble();
         if (std::isfinite(d))
-            return jsNumber(exec, (d > 0) ? floor(d) : ceil(d));
+            return jsNumber(exec, (d > 0) ? floor(d) : wtf_ceil(d));
         if (std::isnan(d) || std::isinf(d))
             return jsNaN(exec);
         return jsNumber(exec, 0);
