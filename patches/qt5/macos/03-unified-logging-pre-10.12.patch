#
# macOS: no Apple unified logging below a 10.12 deployment target.
#
# AppleUnifiedLogger routes Qt's messages into Apple's unified logging system.
# os_log itself is 10.11, but the backend calls os_log_type_enabled to ask
# whether a level is being captured, and that one is 10.12:
#
#   error: 'os_log_type_enabled' is only available on macOS 10.12 or newer
#
# The whole feature hangs off a single macro, QT_USE_APPLE_UNIFIED_LOGGING,
# defined in exactly one place. Leaving it undefined below 10.12 removes
# AppleUnifiedLogger from qcore_mac.mm, makes qlogging.cpp fall back to its
# ordinary stderr output, and takes testlib's os_log plumbing with it. Guarding
# the individual calls instead means meeting the same symbol again in every
# module that happens to log - which is how this was first attempted.
#
# Nothing is lost but the Console.app integration: messages still reach stderr,
# exactly as they do on every non-Apple platform.
#
# Not Intel-specific: Apple Silicon starts at 11.0, above 10.12, so the guard is
# never taken there and one file serves both targets.
#
# Changes:
#   qtbase/src/corelib/kernel/qcore_mac_p.h
#       define QT_USE_APPLE_UNIFIED_LOGGING only from 10.12
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
diff --git a/qtbase/src/corelib/kernel/qcore_mac_p.h b/qtbase/src/corelib/kernel/qcore_mac_p.h
--- a/qtbase/src/corelib/kernel/qcore_mac_p.h
+++ b/qtbase/src/corelib/kernel/qcore_mac_p.h
@@ -208,7 +208,11 @@
 
 // --------------------------------------------------------------------------
 
-#if !defined(QT_BOOTSTRAPPED)
+// Unified logging is macOS 10.11, but os_log_type_enabled - which the backend
+// in qcore_mac.mm calls - is 10.12. This single macro gates the whole facility
+// across qtbase, so leaving it undefined below 10.12 is all that is needed.
+#if !defined(QT_BOOTSTRAPPED) && (!defined(__MAC_OS_X_VERSION_MIN_REQUIRED) \
+    || __MAC_OS_X_VERSION_MIN_REQUIRED >= 101200)
 #define QT_USE_APPLE_UNIFIED_LOGGING
 
 QT_END_NAMESPACE
