#
# macOS: QtGui and its font support below a 10.8 deployment target (the OS X
# 10.7 port).
#
#   NSColor.CGColor                             10.8    qt_mac_toQBrush()
#   CTFontCopyDefaultCascadeListForLanguages    10.8    font fallbacks
#
# qt_mac_toQBrush() reads two gradient-pattern system colors through CGColor.
# Qt's own comment there names the solid color they wrap,
# [NSColor colorWithCalibratedWhite:0.909804 alpha:1.0], so below 10.8 that
# color is converted instead.
#
# Font fallbacks: 10.7 keeps CoreText's cascade lists in
# DefaultFontFallbacks.plist inside the CoreText bundle, which is where Qt 5.5
# and earlier read them. The Lion 10.7.5 copy has one list per generic family
# (default, sans-serif, serif, monospace, cursive, fantasy); an entry is a
# PostScript name, or for the CJK fonts a list of [language, PostScript name]
# pairs. Below 10.8 the monospace list serves monospaced fonts, the default
# list everything else, and each name becomes a CTFontDescriptor just as the
# 10.8 call returns them. Nothing changes on 10.8 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/gui/painting/qcoregraphics.mm b/qtbase/src/gui/painting/qcoregraphics.mm
--- a/qtbase/src/gui/painting/qcoregraphics.mm
+++ b/qtbase/src/gui/painting/qcoregraphics.mm
@@ -346,7 +346,10 @@
     if (qt_mac_isSystemColorOrInstance(color, @"controlColor", @"NSGradientPatternColor") ||
         qt_mac_isSystemColorOrInstance(color, @"windowBackgroundColor", @"NSGradientPatternColor")) {
         qtBrush.setStyle(Qt::SolidPattern);
-        qtBrush.setColor(qt_mac_toQColor(color.CGColor));
+        if (@available(macOS 10.8, *))
+            qtBrush.setColor(qt_mac_toQColor(color.CGColor));
+        else // NSColor.CGColor is 10.8; use the internal color named above
+            qtBrush.setColor(qt_mac_toQColor([NSColor colorWithCalibratedWhite:0.909804 alpha:1.0]));
         return qtBrush;
     }
 
