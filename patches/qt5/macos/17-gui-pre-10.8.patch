+#ifdef Q_OS_MACOS
+// OS X 10.7 has no CTFontCopyDefaultCascadeListForLanguages. CoreText keeps
+// its cascade lists in DefaultFontFallbacks.plist instead: one list per
+// generic family, each entry a PostScript name or a list of
+// [language, PostScript name] pairs for the CJK fonts.
+static CFArrayRef fallbacksFromCoreTextPlist(CTFontRef font)
+{
+    NSString *path = [[NSBundle bundleWithIdentifier:@"com.apple.CoreText"]
+                      pathForResource:@"DefaultFontFallbacks" ofType:@"plist"];
+    NSDictionary *lists = path ? [NSDictionary dictionaryWithContentsOfFile:path] : nil;
+    const bool monospace = CTFontGetSymbolicTraits(font) & kCTFontMonoSpaceTrait;
+    NSArray *list = [lists objectForKey:monospace ? @"monospace" : @"default"];
+    if (![list isKindOfClass:[NSArray class]])
+        return nullptr;
+
+    CFMutableArrayRef cascadeList = CFArrayCreateMutable(kCFAllocatorDefault, 0, &kCFTypeArrayCallBacks);
+    auto append = [cascadeList](id name) {
+        if (![name isKindOfClass:[NSString class]])
+            return;
+        QCFType<CTFontDescriptorRef> fallback = CTFontDescriptorCreateWithNameAndSize(CFStringRef(name), 0.0);
+        if (fallback)
+            CFArrayAppendValue(cascadeList, fallback);
+    };
+    for (id entry in list) {
+        if ([entry isKindOfClass:[NSArray class]]) {
+            for (id pair in (NSArray *)entry) {
+                if ([pair isKindOfClass:[NSArray class]] && [(NSArray *)pair count] > 1)
+                    append([(NSArray *)pair objectAtIndex:1]);
+            }
+        } else {
+            append(entry);
+        }
+    }
+    return cascadeList;
+}
+#endif
