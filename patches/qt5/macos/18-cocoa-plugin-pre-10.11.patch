# macOS: the Cocoa platform plugin and QMacStyle below 10.11 (the OS X 10.7
# port).
#
# Each API newer than 10.7 is chosen at runtime with @available. Where the
# older system has the same thing under its earlier name, that is used
# (deprecated APIs wrapped in QT_WARNING_DISABLE_DEPRECATED); where it has
# nothing, the feature is skipped.
#
#   ObjC subscripting                       10.8    objectForKey:/objectAtIndex:
#   NSStatusItem.button                     10.10   the status item's own
#                                                   target/action/image/toolTip
#   NSUserNotification(Center)              10.8    supportsMessages() is false,
#                                                   QSystemTrayIcon uses its
#                                                   own balloon
#   NSUserNotification.contentImage         10.9    no image
#   status item window (geometry())         10.10   empty rectangle
#   NSModalResponseContinue                 10.9    its value, -1002
#   NSOpenPanel.accessoryViewDisclosed      10.11   panels show it anyway
#   NSOpenGLContext.pixelFormat             10.10   CGLGetPixelFormat, wrapped
#   NSOpenGLProfileVersion4_1Core           10.10   3.2 Core (10.9 gives 4.1
#                                                   for it; 10.7/10.8 stop at 3.2)
#   LSCopyApplicationURLsForBundleIdentifier 10.10  LSFindApplicationForInfo
#   CGEventTapCreateForPid                  10.11   no live-resize event tap
#   performWindowDragWithEvent:             10.11   startSystemMove() is false
#   -[NSWindow beginSheet:...], endSheet:   10.9    -[NSApplication beginSheet:...]
#                                                   and endSheet:; no critical
#                                                   sheets
#   NSWindowStyleMaskFullSizeContentView    10.10   not carried over
#   NSWindow.occlusionState                 10.9    AppKit sends the
#                                                   notification only from 10.9
#   titlebarAppearsTransparent              10.10   textured background only,
#                                                   border counted as in Qt 5.6
#   labelColor, linkColor                   10.10   controlTextColor, blueColor
#   NSColor.CGColor                         10.8    the NSColor conversion
#   Metal layer                             10.11   the warning Qt prints when
#                                                   Metal is missing
#   NSAppearance (QMacStyle)                10.9    @available(10.14) replaces
#                                                   the QOperatingSystemVersion
#                                                   check it already had
#   NSControl.controlSize                   10.10   the cell's controlSize
#   NSGraphicsContext.CGContext             10.10   graphicsPort
#   graphicsContextWithCGContext:flipped:   10.10   graphicsContextWithGraphicsPort:
#   quaternaryLabelColor                    10.10   black at 10% opacity
#   CGPathCreateWithRoundedRect             10.9    the same outline from arcs
#   -[NSSliderCell barRectFlipped:]         10.9    the cell frame for drawing
#                                                   (what older AppKit passed
#                                                   to drawBarInside:); a 4 pt
#                                                   bar for geometry
#   -[NSSliderCell drawTickMarks]           10.9    called as is: the 10.7.5
#                                                   AppKit has it, only not
#                                                   public
#
# Accessibility: QMacAccessibilityElement implements the 10.10 NSAccessibility
# protocol, which AppKit does not call before 10.10. The two calls that
# blocked compiling are fixed, but VoiceOver support below 10.10 would need
# the older attribute-based API and is not provided.
#
# Nothing changes on 10.11 and newer.
#
# Apply: git apply, from the Qt source root
