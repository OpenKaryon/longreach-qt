#
# macOS: QtBluetooth below 10.9 (the OS X 10.7 port).
#
# Classic Bluetooth goes through IOBluetooth and is unchanged. Qt's Bluetooth
# LE code is written against the CoreBluetooth API of 10.9 (NSUUID
# identifiers, CBPeripheralManager, -retrievePeripheralsWithIdentifiers:);
# 10.7 and 10.8 had an earlier CFUUID-based API that this code does not use.
# So below 10.9 LE is reported as unsupported:
#
#   - device discovery: startLE() goes straight to LEnotSupported(), the
#     existing path for hosts without LE (with Classic requested too, the
#     scan simply finishes); supportedDiscoveryMethods() drops
#     LowEnergyMethod;
#   - QLowEnergyController: init() warns and creates no manager, the same
#     state as a manager that failed to initialise.
#
# The LE classes are then only created on 10.9 and newer, so their files and
# declarations carry one -Wunguarded-availability suppression each instead
# of per-call guards.
#
# Linking: in the 11.3 SDK IOBluetooth re-exports
# /System/Library/Frameworks/CoreBluetooth.framework, and ld64 then loads that
# framework directly. On 10.7 CoreBluetooth only exists inside IOBluetooth
# (IOBluetooth.framework/Frameworks/CoreBluetooth.framework), so a strong
# load would stop every application using QtBluetooth at launch. The
# framework is weak-linked instead.
#
# Also: one ObjC subscript (10.8) is spelled out as objectForKey:.
#
# Nothing changes on 10.9 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtconnectivity/src/bluetooth/bluetooth.pro b/qtconnectivity/src/bluetooth/bluetooth.pro
--- a/qtconnectivity/src/bluetooth/bluetooth.pro
+++ b/qtconnectivity/src/bluetooth/bluetooth.pro
@@ -165,6 +165,11 @@
     QT_PRIVATE = concurrent
     DEFINES += QT_OSX_BLUETOOTH
     LIBS_PRIVATE += -framework Foundation -framework IOBluetooth
+    # IOBluetooth re-exports CoreBluetooth, and the linker then loads
+    # /System/Library/Frameworks/CoreBluetooth.framework directly. Before
+    # 10.8 that framework only exists inside IOBluetooth, so it is
+    # weak-linked; Bluetooth LE needs 10.9 anyway.
+    LIBS_PRIVATE += -weak_framework CoreBluetooth
 
     include(osx/osxbt.pri)
     OBJECTIVE_SOURCES += \
diff --git a/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager.mm b/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager.mm
--- a/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager.mm
+++ b/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager.mm
@@ -52,6 +52,12 @@
 
 Q_DECLARE_METATYPE(QLowEnergyHandle)
 
+// Bluetooth LE below macOS 10.9 is not supported (see the LE entry points in
+// qbluetoothdevicediscoveryagent_darwin.mm and qlowenergycontroller_darwin.mm),
+// so this code only runs where its CoreBluetooth API exists.
+QT_WARNING_PUSH
+QT_WARNING_DISABLE_CLANG("-Wunguarded-availability")
+
 QT_BEGIN_NAMESPACE
 
 namespace OSXBluetooth {
@@ -1857,3 +1863,5 @@
 }
 
 @end
+
+QT_WARNING_POP
