     QScopedPointer<LECBManagerNotifier> notifier(new LECBManagerNotifier);
     // Connections:
     using ErrMemFunPtr = void (LECBManagerNotifier::*)(QBluetoothDeviceDiscoveryAgent::Error);
@@ -564,7 +573,9 @@
