 @end
@@ -336,6 +338,7 @@
 @interface CBCentral (UnguardedWorkaround)
 @property (readonly, nonatomic) NSUUID *identifier NS_AVAILABLE(10_7, 5_0);
 @end
+QT_WARNING_POP
 
