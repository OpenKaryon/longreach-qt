#
# macOS: the QtMultimedia AVFoundation plugin below 10.9 (the OS X 10.7 port).
#
#   AVPlayerItemVideoOutput, item outputs   10.8    no video frames for
#                                                   QAbstractVideoSurface; audio
#                                                   and playback control work
#   AVAssetResourceLoader                   10.9    no playback from a
#                                                   QIODevice stream; URLs work
#   maximum frame duration (camera)         10.9    no minimum frame rate;
#                                                   the maximum still applies
#   NSOpenGLContext.pixelFormat             10.10   CGLGetPixelFormat on the
#                                                   context, the same object
#
# Qt 5.6 rendered frames on 10.7 through an AVPlayerLayer and CARenderer;
# that path is not brought back here, so video output below 10.8 is empty.
# The resource-loader delegate methods are only called where the loader
# exists and carry a -Wunguarded-availability suppression.
#
# Nothing changes on 10.9 and newer (on 10.10 and newer for the texture cache,
# where the call returns the same pixel format).
#
# Apply: git apply, from the Qt source root
diff --git a/qtmultimedia/src/plugins/avfoundation/camera/avfcamerautility.mm b/qtmultimedia/src/plugins/avfoundation/camera/avfcamerautility.mm
--- a/qtmultimedia/src/plugins/avfoundation/camera/avfcamerautility.mm
+++ b/qtmultimedia/src/plugins/avfoundation/camera/avfcamerautility.mm
@@ -67,11 +67,13 @@
         }
     }
 
-    if (videoConnection.supportsVideoMaxFrameDuration) {
-        const CMTime cmMax = videoConnection.videoMaxFrameDuration;
-        if (CMTimeCompare(cmMax, kCMTimeInvalid)) {
-            if (const Float64 maxSeconds = CMTimeGetSeconds(cmMax))
-                newRange.first = 1. / maxSeconds;
+    if (@available(macOS 10.9, *)) { // the maximum frame duration is 10.9
+        if (videoConnection.supportsVideoMaxFrameDuration) {
+            const CMTime cmMax = videoConnection.videoMaxFrameDuration;
+            if (CMTimeCompare(cmMax, kCMTimeInvalid)) {
+                if (const Float64 maxSeconds = CMTimeGetSeconds(cmMax))
+                    newRange.first = 1. / maxSeconds;
+            }
         }
     }
 
@@ -451,15 +453,21 @@
     if (videoConnection.supportsVideoMinFrameDuration)
         videoConnection.videoMinFrameDuration = minDuration;
 
+    // The maximum frame duration (minimum frame rate) is 10.9.
+    bool maxDurationSupported = false;
+    if (@available(macOS 10.9, *))
+        maxDurationSupported = videoConnection.supportsVideoMaxFrameDuration;
     CMTime maxDuration = kCMTimeInvalid;
     if (minFPS > 0.) {
-        if (!videoConnection.supportsVideoMaxFrameDuration)
+        if (!maxDurationSupported)
             qDebugCamera() << Q_FUNC_INFO << "minimum framerate is not supported";
         else
             maxDuration = CMTimeMake(1, minFPS);
     }
-    if (videoConnection.supportsVideoMaxFrameDuration)
-        videoConnection.videoMaxFrameDuration = maxDuration;
+    if (maxDurationSupported) {
+        if (@available(macOS 10.9, *))
+            videoConnection.videoMaxFrameDuration = maxDuration;
+    }
 }
 
 CMTime qt_adjusted_frame_duration(AVFrameRateRange *range, qreal fps)
@@ -538,8 +546,10 @@
     if (CMTimeCompare(minFrameDuration, kCMTimeInvalid))
         [captureDevice setActiveVideoMinFrameDuration:minFrameDuration];
 
-    if (CMTimeCompare(maxFrameDuration, kCMTimeInvalid))
-        [captureDevice setActiveVideoMaxFrameDuration:maxFrameDuration];
+    if (@available(macOS 10.9, *)) { // no maximum frame duration before 10.9
+        if (CMTimeCompare(maxFrameDuration, kCMTimeInvalid))
+            [captureDevice setActiveVideoMaxFrameDuration:maxFrameDuration];
+    }
 #endif // Q_OS_MACOS
 }
 
@@ -563,10 +573,12 @@
             fps.second = 1. / minSeconds; // Max FPS = 1 / MinDuration.
     }
 
-    const CMTime maxDuration = captureDevice.activeVideoMaxFrameDuration;
-    if (CMTimeCompare(maxDuration, kCMTimeInvalid)) {
-        if (const Float64 maxSeconds = CMTimeGetSeconds(maxDuration))
-            fps.first = 1. / maxSeconds; // Min FPS = 1 / MaxDuration.
+    if (@available(macOS 10.9, *)) { // no maximum frame duration before 10.9
+        const CMTime maxDuration = captureDevice.activeVideoMaxFrameDuration;
+        if (CMTimeCompare(maxDuration, kCMTimeInvalid)) {
+            if (const Float64 maxSeconds = CMTimeGetSeconds(maxDuration))
+                fps.first = 1. / maxSeconds; // Min FPS = 1 / MaxDuration.
+        }
     }
 
     return fps;
