#
# macOS: Negotiate (GSSAPI) authentication below 10.7 (the OS X 10.6 port).
#
# GSS.framework is 10.7. Below that QAuthenticator does not offer Negotiate:
# every function that calls into the framework carries the 10.7
# availability, and its three call sites are guarded, so the compiler checks
# that nothing reaches it on 10.6.
#
# Linking: the framework is weak-linked, as the single token
# -Wl,-weak_framework,GSS (configure.json). Not "-weak_framework GSS": qmake
# merges "-framework X" pairs but does not know -weak_framework, drops the
# bare "GSS" as a duplicate and leaves "-weak_framework" to swallow the next
# library on the link line ("ld: framework not found .../libqttinycanbus.a"
# for canbusutil). So applications that never authenticate do not depend on
# the framework either, and
# GSS_C_NT_HOSTBASED_SERVICE is spelled out as its well-known OID
# (1.2.840.113554.1.2.1.4): it is a data symbol, which availability does not
# weaken, and a strong import of it would stop every QtNetwork application
# from starting on 10.6.
#
# Nothing changes on 10.7 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/network/configure.json b/qtbase/src/network/configure.json
--- a/qtbase/src/network/configure.json
+++ b/qtbase/src/network/configure.json
@@ -122,7 +122,7 @@
                 ]
             },
             "sources": [
-                { "libs": "-framework GSS", "condition": "config.darwin" },
+                { "libs": "-Wl,-weak_framework,GSS", "condition": "config.darwin" },
                 { "type": "pkgConfig", "args": "krb5-gssapi" },
                 "-lgssapi_krb5"
             ]
diff --git a/qtbase/src/network/kernel/qauthenticator.cpp b/qtbase/src/network/kernel/qauthenticator.cpp
--- a/qtbase/src/network/kernel/qauthenticator.cpp
+++ b/qtbase/src/network/kernel/qauthenticator.cpp
@@ -68,6 +68,17 @@
 #endif // Q_OS_DARWIN
 #endif // Q_CONFIG(sspi)
 
+#if QT_CONFIG(gssapi) && defined(Q_OS_MACOS)
+// GSS.framework is 10.7; below that Negotiate is not offered. Every function
+// that calls into it carries the same availability, so the compiler checks
+// that each call site is guarded, and the framework ends up weak-linked.
+#  define QT_GSSAPI_API __attribute__((availability(macos, introduced = 10.7)))
+#  define QT_GSSAPI_AVAILABLE __builtin_available(macOS 10.7, *)
+#else
+#  define QT_GSSAPI_API
+#  define QT_GSSAPI_AVAILABLE true
+#endif
+
 QT_BEGIN_NAMESPACE
 
 Q_DECLARE_LOGGING_CATEGORY(lcAuthenticator);
