# macOS: the Cocoa plugin's coordinates and scale factor below 10.7 (the OS X
# 10.6 port).
#
#   -[NSWindow convertRectToScreen:/FromScreen:]   10.7
#   backingScaleFactor, convertSizeToBacking:      10.7
#   CALayer contentsScale                          10.7
#   NSWindowDidChangeBackingPropertiesNotification 10.7
#
# 10.6 has no backing scale factor. Window and screen coordinates then differ
# only by the window's frame origin: qt_mac_convertRectToScreen() and
# qt_mac_convertRectFromScreen() in qcocoahelpers.h do that below 10.7 and
# replace the seven direct calls. The device pixel ratio is 1, layers are not
# scaled, and nothing observes backing-property changes.
#
# qcocoahelpers.h also gets qt_mac_hasFullScreenStyle(), used by the next
# patch.
#
# Nothing changes on 10.7 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/plugins/platforms/cocoa/qcocoabackingstore.mm b/qtbase/src/plugins/platforms/cocoa/qcocoabackingstore.mm
