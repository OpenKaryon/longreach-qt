diff --git a/qtbase/src/plugins/platforms/cocoa/qcocoahelpers.h b/qtbase/src/plugins/platforms/cocoa/qcocoahelpers.h
--- a/qtbase/src/plugins/platforms/cocoa/qcocoahelpers.h
+++ b/qtbase/src/plugins/platforms/cocoa/qcocoahelpers.h
@@ -61,6 +61,31 @@
 
 #include <objc/runtime.h>
 #include <objc/message.h>
+
+// OS X 10.6: AppKit calls that are 10.7 and have a 10.6 equivalent. 10.6 has
+// no backing scale factor, so window and screen coordinates differ only by
+// the window's frame origin.
+inline NSRect qt_mac_convertRectToScreen(NSWindow *window, NSRect rect)
+{
+    if (@available(macOS 10.7, *))
+        return [window convertRectToScreen:rect];
+    return NSOffsetRect(rect, window.frame.origin.x, window.frame.origin.y);
+}
+
+inline NSRect qt_mac_convertRectFromScreen(NSWindow *window, NSRect rect)
+{
+    if (@available(macOS 10.7, *))
+        return [window convertRectFromScreen:rect];
+    return NSOffsetRect(rect, -window.frame.origin.x, -window.frame.origin.y);
+}
+
+// Native full screen (the window style and toggleFullScreen:) is 10.7.
+inline bool qt_mac_hasFullScreenStyle(NSWindow *window)
+{
+    if (@available(macOS 10.7, *))
+        return window.styleMask & NSWindowStyleMaskFullScreen;
+    return false;
+}
 
 Q_FORWARD_DECLARE_OBJC_CLASS(QT_MANGLE_NAMESPACE(QNSView));
 
