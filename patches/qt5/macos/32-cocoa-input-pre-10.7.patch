#
# macOS: mouse wheel, gestures, touches and drag-and-drop below 10.7 (the OS X
# 10.6 port).
#
#   wheel       precise deltas, scroll phases and natural scrolling are 10.7.
#               Below that every event is a wheel notch: angle delta from
#               deltaX/deltaY as Qt 5.3 computed it, no phase, not inverted.
#   gestures    the begin/end handling already runs on 10.11 and newer only;
#               the check becomes an @available so the compiler sees it.
#   touches     NSTouch is 10.6 API, but the SDK marks the phase constants
#               10.7. They are plain values; the file is exempted.
#   drag source dragging sessions are 10.7. AppKit calls the session methods
#               only there; 10.6 asks the informal NSDraggingSource methods,
#               which QNSView now implements too, and both end through
#               -qt_dragEndedAtPoint:operation:. The multi-item drag
#               (NSDraggingItem) runs on 10.14 and newer only, as before.
#
# Nothing changes on 10.7 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/plugins/platforms/cocoa/qcocoadrag.mm b/qtbase/src/plugins/platforms/cocoa/qcocoadrag.mm
--- a/qtbase/src/plugins/platforms/cocoa/qcocoadrag.mm
+++ b/qtbase/src/plugins/platforms/cocoa/qcocoadrag.mm
@@ -173,6 +173,10 @@
     return m_executed_drop_action;
 }
 
+// NSDraggingItem and dragging sessions are 10.7; this runs on 10.14 and
+// later only, checked at its top.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunguarded-availability"
 bool QCocoaDrag::maybeDragMultipleItems()
 {
     Q_ASSERT(m_drag && m_drag->mimeData());
@@ -260,6 +264,7 @@
     internalDragLoop.exec();
     return true;
 }
+#pragma clang diagnostic pop
 
 void QCocoaDrag::setAcceptedAction(Qt::DropAction act)
 {
diff --git a/qtbase/src/plugins/platforms/cocoa/qmultitouch_mac.mm b/qtbase/src/plugins/platforms/cocoa/qmultitouch_mac.mm
