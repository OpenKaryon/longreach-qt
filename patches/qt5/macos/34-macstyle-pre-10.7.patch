# macOS: the macOS style below 10.7 (the OS X 10.6 port).
#
#   overlay scrollers, scroller and knob styles   10.7
#   -[NSView alignmentRectForFrame:]               10.7
#   +[NSColor colorWithSRGBRed:green:blue:alpha:]  10.7
#   -[NSView layoutSubtreeIfNeeded]                10.7
#
# Small helpers at the top of the file: 10.6 scrollers are always legacy, and
# their width comes from the pre-10.7 scrollerWidthForControlSize:; a
# control's alignment rect is its frame; sRGB colours are made with the sRGB
# colour space and components (10.5). The scroller-style observer is set up
# only where the style can change, and the slider is laid out when drawn.
#
# Nothing changes on 10.7 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm b/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm
--- a/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm
