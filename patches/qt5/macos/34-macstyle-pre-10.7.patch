@@ -47,6 +47,38 @@
 #include "qmacstyle_mac_p.h"
 #include "qmacstyle_mac_p_p.h"
 
+// OS X 10.6: overlay scrollers, alignment rects and sRGB colours are 10.7.
+// 10.6 has only legacy scrollers, and a control's alignment rect is its frame.
+static bool qt_mac_overlayScrollers()
+{
+    if (@available(macOS 10.7, *))
+        return [NSScroller preferredScrollerStyle] == NSScrollerStyleOverlay;
+    return false;
+}
+
+static CGFloat qt_mac_scrollerWidth(NSControlSize size, bool overlay)
+{
+    if (@available(macOS 10.7, *))
+        return [NSScroller scrollerWidthForControlSize:size
+                                         scrollerStyle:overlay ? NSScrollerStyleOverlay : NSScrollerStyleLegacy];
+    return [NSScroller scrollerWidthForControlSize:size];
+}
+
+static NSRect qt_mac_alignmentRectForFrame(NSView *view, NSRect frame)
+{
+    if (@available(macOS 10.7, *))
+        return [view alignmentRectForFrame:frame];
+    return frame;
+}
+
+static NSColor *qt_mac_colorWithSRGB(CGFloat red, CGFloat green, CGFloat blue, CGFloat alpha)
+{
+    if (@available(macOS 10.7, *))
+        return [NSColor colorWithSRGBRed:red green:green blue:blue alpha:alpha];
+    const CGFloat components[] = { red, green, blue, alpha };
+    return [NSColor colorWithColorSpace:[NSColorSpace sRGBColorSpace] components:components count:4];
+}
+
