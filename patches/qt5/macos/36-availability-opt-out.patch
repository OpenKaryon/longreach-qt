# Build system: let a module opt out of the availability errors.
#
# Qt builds itself with -Werror=unguarded-availability. A module whose code
# runs only on systems that have its framework - because its entry point
# refuses to start below that version - can now say so with
#
#     CONFIG += qt_no_availability_errors
#
# instead of guarding every call. Used by the AVFoundation and StoreKit
# backends (the next patches), which are 10.7 frameworks.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/mkspecs/features/qt_common.prf b/qtbase/mkspecs/features/qt_common.prf
--- a/qtbase/mkspecs/features/qt_common.prf
+++ b/qtbase/mkspecs/features/qt_common.prf
@@ -95,11 +95,15 @@
 
         # Clang/LLVM 5.0 and Xcode 9.0 introduced unguarded availability warnings.
         # The same construct has been a hard error in Swift from the very beginning.
-        versionAtLeast(clang_ver, 5.0)|versionAtLeast(apple_ver, 9.0): \
-            QMAKE_CXXFLAGS_WARN_ON += \
-                -Werror=unguarded-availability \
-                -Werror=unguarded-availability-new \
-                -Werror=unsupported-availability-guard
+        # qt_no_availability_errors: for code that runs only on systems that
+        # have its framework, with the check at its entry point instead.
+        !qt_no_availability_errors {
+            versionAtLeast(clang_ver, 5.0)|versionAtLeast(apple_ver, 9.0): \
+                QMAKE_CXXFLAGS_WARN_ON += \
+                    -Werror=unguarded-availability \
+                    -Werror=unguarded-availability-new \
+                    -Werror=unsupported-availability-guard
+        }
     }
 } else: gcc:!intel_icc {
     QMAKE_CXXFLAGS_WARN_ON += -Wvla
