#
# macOS: QtBluetooth below 10.7 (the OS X 10.6 port).
#
# Bluetooth LE already runs on 10.9 and newer only (patch 21). Its remaining
# files and the CBUUID helpers are exempted from the availability errors for
# the CoreBluetooth classes, which are 10.7.
#
# Classic Bluetooth:
#   -performSDPQuery:uuids:   10.7   10.6 queries without UUID filters and
#                                    Qt filters the results as before
#   IOBluetoothDevice RSSI    10.7   10.6 devices report no RSSI
#
# Nothing changes on 10.7 and newer.
#
# Apply: git apply, from the Qt source root
diff --git a/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager_p.h b/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager_p.h
--- a/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager_p.h
+++ b/qtconnectivity/src/bluetooth/osx/osxbtcentralmanager_p.h
@@ -66,6 +66,10 @@
 #include <Foundation/Foundation.h>
 
 @class QT_MANGLE_NAMESPACE(OSXBTCentralManager);
+
+// CoreBluetooth is 10.7; the LE code runs on 10.9 and newer only.
+QT_WARNING_PUSH
+QT_WARNING_DISABLE_CLANG("-Wunguarded-availability")
 
 QT_BEGIN_NAMESPACE
 
@@ -173,4 +177,6 @@
 
 @end
 
+QT_WARNING_POP
+
 #endif
diff --git a/qtconnectivity/src/bluetooth/osx/osxbtsdpinquiry.mm b/qtconnectivity/src/bluetooth/osx/osxbtsdpinquiry.mm
--- a/qtconnectivity/src/bluetooth/osx/osxbtsdpinquiry.mm
+++ b/qtconnectivity/src/bluetooth/osx/osxbtsdpinquiry.mm
@@ -382,9 +382,14 @@
         return result;
     } // Monterey's code path.
 
-    if (qtFilters.size())
-        result = [device performSDPQuery:self uuids:array];
-    else
+    bool filtered = false;
+    if (@available(macOS 10.7, *)) { // 10.6 queries without UUID filters
+        if (qtFilters.size()) {
+            result = [device performSDPQuery:self uuids:array];
+            filtered = true;
+        }
+    }
+    if (!filtered)
         result = [device performSDPQuery:self];
 
     if (result != kIOReturnSuccess) {
diff --git a/qtconnectivity/src/bluetooth/osx/osxbtutility.mm b/qtconnectivity/src/bluetooth/osx/osxbtutility.mm
--- a/qtconnectivity/src/bluetooth/osx/osxbtutility.mm
+++ b/qtconnectivity/src/bluetooth/osx/osxbtutility.mm
@@ -58,6 +58,10 @@
 
 #include <algorithm>
 #include <limits>
+
+// CoreBluetooth is 10.7; the LE code runs on 10.9 and newer only.
+QT_WARNING_PUSH
+QT_WARNING_DISABLE_CLANG("-Wunguarded-availability")
 
 QT_BEGIN_NAMESPACE
 
@@ -409,3 +413,5 @@
 }
 
 QT_END_NAMESPACE
+
+QT_WARNING_POP
diff --git a/qtconnectivity/src/bluetooth/osx/osxbtutility_p.h b/qtconnectivity/src/bluetooth/osx/osxbtutility_p.h
--- a/qtconnectivity/src/bluetooth/osx/osxbtutility_p.h
+++ b/qtconnectivity/src/bluetooth/osx/osxbtutility_p.h
@@ -291,11 +291,16 @@
 
 #endif // !QT_IOS_BLUETOOTH
 
+// CoreBluetooth is 10.7; the LE code that uses these runs on 10.9 and newer
+// only (see QLowEnergyController and the discovery agent).
+QT_WARNING_PUSH
+QT_WARNING_DISABLE_CLANG("-Wunguarded-availability")
 QBluetoothUuid qt_uuid(CBUUID *uuid);
 CFStrongReference<CFUUIDRef> cf_uuid(const QBluetoothUuid &qtUuid);
 ObjCStrongReference<CBUUID> cb_uuid(const QBluetoothUuid &qtUuid);
 bool equal_uuids(const QBluetoothUuid &qtUuid, CBUUID *cbUuid);
 bool equal_uuids(CBUUID *cbUuid, const QBluetoothUuid &qtUuid);
+QT_WARNING_POP
 QByteArray qt_bytearray(NSData *data);
 QByteArray qt_bytearray(NSObject *data);
 
diff --git a/qtconnectivity/src/bluetooth/qbluetoothdevicediscoveryagent_darwin.mm b/qtconnectivity/src/bluetooth/qbluetoothdevicediscoveryagent_darwin.mm
--- a/qtconnectivity/src/bluetooth/qbluetoothdevicediscoveryagent_darwin.mm
+++ b/qtconnectivity/src/bluetooth/qbluetoothdevicediscoveryagent_darwin.mm
@@ -394,7 +394,8 @@
 
     QBluetoothDeviceInfo deviceInfo(deviceAddress, deviceName, classOfDevice);
     deviceInfo.setCoreConfigurations(QBluetoothDeviceInfo::BaseRateCoreConfiguration);
-    deviceInfo.setRssi(device.RSSI);
+    if (@available(macOS 10.7, *)) // 10.6 does not report the RSSI of an inquiry result
+        deviceInfo.setRssi(device.RSSI);
 
     const QVector<QBluetoothUuid> uuids(OSXBluetooth::extract_services_uuids(device));
     deviceInfo.setServiceUuids(uuids);
diff --git a/qtconnectivity/src/bluetooth/qlowenergycontroller_darwin.mm b/qtconnectivity/src/bluetooth/qlowenergycontroller_darwin.mm
