#
# macOS: the macOS style's and QtPrintSupport's Objective-C classes on the
# 32-bit runtime (the i386 port).
#
# The 32-bit (fragile) Objective-C runtime fixes each instance variable's
# offset when the class is compiled, from its @interface, and so accepts
# instance variables only there - not in the @implementation, not in a class
# extension - and synthesizes no property by itself. Qt 5.15 was written for
# the 64-bit runtime only.
#
# The page-layout and print-panel delegates declare their variables in the
# @interface; the style's indeterminate progress indicator gets a variable
# and an @synthesize for its animator count.
#
# Nothing changes in behaviour, on any architecture.
#
# Apply: git apply, from the Qt source root
diff --git a/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm b/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm
--- a/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm
+++ b/qtbase/src/plugins/styles/mac/qmacstyle_mac.mm
@@ -118,6 +118,9 @@
 }
 
 @interface QT_MANGLE_NAMESPACE(QIndeterminateProgressIndicator) : NSProgressIndicator
+{
+    NSInteger _animators;
+}
 
 @property (readonly, nonatomic) NSInteger animators;
 
@@ -134,6 +137,8 @@
 
 @implementation QIndeterminateProgressIndicator
 
+@synthesize animators = _animators;
+
 - (instancetype)init
 {
     if ((self = [super init])) {
