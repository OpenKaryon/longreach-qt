# Test and strip the host-call bit on the raw frame pointer. Clang treats
# the implicit this parameter as aligned and can fold the low-bit operations.
# In the interpreter's return opcode the folded test loses the host return
# path and dispatches from the null return PC of the host call.

--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/interpreter/CallFrame.h
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/interpreter/CallFrame.h
@@ -136,7 +136,13 @@
