#
# Keep the AMD64 Windows jump buffer aligned for the CRT's XMM stores.
# The pointer-sized override reduced its required alignment to 8 bytes.

--- a/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/Collector.cpp
+++ b/qtscript/src/3rdparty/javascriptcore/JavaScriptCore/runtime/Collector.cpp
@@ -834,7 +834,10 @@
     markConservatively(markStack, stackPointer, stackBase);
 }
 
-#if COMPILER(GCC)
+#if OS(WINDOWS) && CPU(X86_64)
+// The AMD64 Windows CRT saves XMM registers in jmp_buf using aligned stores.
+#define REGISTER_BUFFER_ALIGNMENT alignas(16)
+#elif COMPILER(GCC)
 #define REGISTER_BUFFER_ALIGNMENT __attribute__ ((aligned (sizeof(void*))))
 #else
 #define REGISTER_BUFFER_ALIGNMENT
@@ -843,7 +846,7 @@
 void Heap::markCurrentThreadConservatively(MarkStack& markStack)
 {
     // setjmp forces volatile registers onto the stack
-    jmp_buf registers REGISTER_BUFFER_ALIGNMENT;
+    REGISTER_BUFFER_ALIGNMENT jmp_buf registers;
 #if COMPILER(MSVC)
 #pragma warning(push)
 #pragma warning(disable: 4611)
