#
# Windows (all builds): disable the D3D11 RHI backend for MinGW.
#
# The D3D11 RHI backend includes dxgi1_3.h (Windows 8.1), which the MinGW v5
# headers do not ship, so the build fails. The backend is not needed here.
# It is now gated behind an opt-in CONFIG+=qtbackport_d3d11rhi and is off by
# default; removing the .cpp from SOURCES alone is not enough because qrhi.cpp
# instantiates it under Q_OS_WIN.
#
# Not XP-specific: this is a toolchain-level fix needed by every Windows build.
#
# Changes:
#   qtbase/src/gui/rhi/rhi.pri
#       gate the D3D11 backend behind the opt-in flag
#   qtbase/src/gui/rhi/qrhi.cpp
#       guard the D3D11 include/instantiation
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
diff --git a/qtbase/src/gui/rhi/qrhi.cpp b/qtbase/src/gui/rhi/qrhi.cpp
index 83c1e8eaa..271f454b2 100644
--- a/qtbase/src/gui/rhi/qrhi.cpp
+++ b/qtbase/src/gui/rhi/qrhi.cpp
@@ -45,7 +45,7 @@
 #if QT_CONFIG(vulkan)
 #include "qrhivulkan_p_p.h"
 #endif
-#ifdef Q_OS_WIN
+#if defined(Q_OS_WIN) && defined(QT_RHI_D3D11_BACKPORT)
 #include "qrhid3d11_p_p.h"
 #endif
 #if defined(Q_OS_MACOS) || defined(Q_OS_IOS)
@@ -4242,7 +4242,7 @@ QRhi *QRhi::create(Implementation impl, QRhiInitParams *params, Flags flags, QRh
         break;
 #endif
     case D3D11:
-#ifdef Q_OS_WIN
+#if defined(Q_OS_WIN) && defined(QT_RHI_D3D11_BACKPORT)
         r->d = new QRhiD3D11(static_cast<QRhiD3D11InitParams *>(params),
                              static_cast<QRhiD3D11NativeHandles *>(importDevice));
         break;
diff --git a/qtbase/src/gui/rhi/rhi.pri b/qtbase/src/gui/rhi/rhi.pri
index ccd959263..4f12c5d83 100644
--- a/qtbase/src/gui/rhi/rhi.pri
+++ b/qtbase/src/gui/rhi/rhi.pri
@@ -33,7 +33,13 @@ qtConfig(vulkan) {
         rhi/qrhivulkan.cpp
 }
 
-win32 {
+# The D3D11 RHI backend #includes <dxgi1_3.h> (DXGI 1.3 / Windows 8.1), which
+# MinGW's headers lack (v5.x) and which does not exist on XP/Win7 anyway. Nothing
+# in qtbase instantiates QRhiD3D11 (only Qt Quick does, which we do not build), so
+# it is disabled for this backport. Our Windows toolchain is MinGW-only; to build
+# it for an MSVC toolchain that has the DXGI 1.3 headers, configure with
+# CONFIG+=qtbackport_d3d11rhi.
+win32:qtbackport_d3d11rhi {
     HEADERS += \
         rhi/qrhid3d11_p.h \
         rhi/qrhid3d11_p_p.h
@@ -41,6 +47,11 @@ win32 {
         rhi/qrhid3d11.cpp
 
     LIBS += -ld3d11 -ldxgi -ldxguid
+
+    # qrhi.cpp (always built) includes and instantiates the D3D11 backend under
+    # Q_OS_WIN; this define lets it match the opt-in so the backend is fully
+    # compiled out by default (see qrhi.cpp).
+    DEFINES += QT_RHI_D3D11_BACKPORT
 }
 
 macos|ios {
