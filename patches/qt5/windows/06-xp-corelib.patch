 QT_BEGIN_NAMESPACE
 
+#if defined(Q_CC_MINGW) && (_WIN32_WINNT < 0x0600)
+// XP backport: CancelIoEx() is Vista+. Resolve it at runtime so Vista+ keeps the
+// original behaviour; on XP fall back to CancelIo(), which cancels the single
+// outstanding overlapped operation on this handle for the current thread.
+static BOOL qt_cancelIoEx(HANDLE handle, LPOVERLAPPED overlapped)
+{
+    typedef BOOL(WINAPI * PtrCancelIoEx)(HANDLE, LPOVERLAPPED);
+    static PtrCancelIoEx ptrCancelIoEx = reinterpret_cast<PtrCancelIoEx>(
+        reinterpret_cast<QFunctionPointer>(
+            GetProcAddress(GetModuleHandleW(L"kernel32"), "CancelIoEx")));
+    if (ptrCancelIoEx)
+        return ptrCancelIoEx(handle, overlapped);
+    return CancelIo(handle);
+}
+#else
+static inline BOOL qt_cancelIoEx(HANDLE handle, LPOVERLAPPED overlapped)
+{ return CancelIoEx(handle, overlapped); }
+#endif
