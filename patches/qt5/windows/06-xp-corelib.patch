# Windows XP: QtCore fallbacks for post-XP APIs.
#
# Each call is guarded (Q_CC_MINGW && _WIN32_WINNT < 0x0600) so Win7+/MSVC keep the
# original modern path; only XP takes the fallback. Nothing is removed.
#
# Changes:
#   qtbase/src/corelib/kernel/qelapsedtimer_win.cpp
#       GetTickCount64 -> runtime-resolve, else GetTickCount
#   qtbase/src/corelib/io/qwindowspipereader.cpp
#       CancelIoEx -> runtime-resolve, else CancelIo
#   qtbase/src/corelib/io/qwindowspipewriter.cpp
#       CancelIoEx -> runtime-resolve, else CancelIo
#   qtbase/src/corelib/io/qfilesystemengine_win.cpp
#       GetFileInformationByHandleEx(FileIdInfo) -> pre-Vista fileId()
#   qtbase/src/corelib/text/qstring.cpp
#       CompareStringEx -> CompareStringW (LCID)
#   qtbase/src/corelib/text/qlocale_win.cpp
#       GetUserPreferredUILanguages/LOCALE_SSORTLOCALE -> LCID helper
#   qtbase/src/corelib/global/qlogging.cpp
#       RaiseFailFastException (Win7+) -> fall through to TerminateProcess
#   qtbase/src/corelib/global/qglobal.cpp
#       _wgetenv_s (secure CRT, absent on XP) -> _wgetenv
#   qtbase/src/corelib/io/qsettings.cpp
#       SHGetKnownFolderPath -> SHGetFolderPath + CSIDL
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
