     QString buffer;
     _wgetenv_s(&requiredSize, 0, 0, wname.data());
@@ -3557,6 +3567,7 @@ QString qEnvironmentVariable(const char *varName, const QString &defaultValue)
     Q_ASSERT(buffer.endsWith(QLatin1Char('\0')));
     buffer.chop(1);
     return buffer;
+#endif
