         wname[i] = uchar(varName[i]);
+#if defined(Q_CC_MINGW) && (_WIN32_WINNT < 0x0600)
+    // XP backport: the secure _wgetenv_s() is not present in Windows XP's
+    // msvcrt.dll (it becomes a static import that fails to resolve at load
