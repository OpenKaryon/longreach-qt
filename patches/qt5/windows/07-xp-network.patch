#
# Windows XP: QtNetwork interface enumeration without the Vista+ LUID APIs.
#
# The bearer plugin fix matters for loading, not just compiling: qgenericengine is
# linked into every QtNetwork application, so its ConvertInterfaceNameToLuidW import
# alone prevented any networking app from starting on XP.
#
# Changes:
#   qtbase/src/network/kernel/qnetworkinterface_win.cpp
#       ConvertInterface*/NET_LUID and OnLinkPrefixLength are Vista+: use the numeric
#       interface index as the name and skip the prefix length
#   qtbase/src/plugins/bearer/generic/qgenericengine.cpp
#       resolve ConvertInterfaceNameToLuidW dynamically; report BearerUnknown on XP
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
diff --git a/qtbase/src/network/kernel/qnetworkinterface_win.cpp b/qtbase/src/network/kernel/qnetworkinterface_win.cpp
index a8d56a9b1..88894d7f8 100644
--- a/qtbase/src/network/kernel/qnetworkinterface_win.cpp
+++ b/qtbase/src/network/kernel/qnetworkinterface_win.cpp
@@ -90,16 +90,29 @@ static QHostAddress addressFromSockaddr(sockaddr *sa)
 
 uint QNetworkInterfaceManager::interfaceIndexFromName(const QString &name)
 {
+#if defined(Q_CC_MINGW) && (_WIN32_WINNT < 0x0600)
+    // XP backport: the ConvertInterface*/NET_LUID APIs are Vista+. On XP the
+    // interface "name" is its numeric index (see interfaceNameFromIndex), so
+    // parse it back to an index.
+    bool ok = false;
+    const uint id = name.toUInt(&ok);
+    return ok ? id : 0u;
+#else
     NET_IFINDEX id;
     NET_LUID luid;
     if (ConvertInterfaceNameToLuidW(reinterpret_cast<const wchar_t *>(name.constData()), &luid) == NO_ERROR
             && ConvertInterfaceLuidToIndex(&luid, &id) == NO_ERROR)
         return uint(id);
     return 0;
+#endif
 }
 
 QString QNetworkInterfaceManager::interfaceNameFromIndex(uint index)
 {
+#if defined(Q_CC_MINGW) && (_WIN32_WINNT < 0x0600)
+    // XP backport: no LUID-to-name API on XP; use the numeric index as the name.
+    return QString::number(index);
+#else
     NET_LUID luid;
     if (ConvertInterfaceIndexToLuid(index, &luid) == NO_ERROR) {
         WCHAR buf[IF_MAX_STRING_SIZE + 1];
@@ -107,6 +120,7 @@ QString QNetworkInterfaceManager::interfaceNameFromIndex(uint index)
             return QString::fromWCharArray(buf);
     }
     return QString::number(index);
+#endif
 }
 
