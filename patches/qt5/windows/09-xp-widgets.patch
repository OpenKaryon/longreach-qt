#
# Windows XP: QtWidgets fallbacks for the Vista shell and DWM.
#
# QWizard's Aero styling depends on DWM (dwmapi.dll), which does not exist on XP:
# the DWM calls would also be static imports that stop the binary from loading, so
# they are compiled out and the wizard uses its classic look there.
#
# Changes:
#   qtbase/src/widgets/dialogs/qfilesystemmodel.cpp
#       SHCreateItemFromParsingName/IShellItem -> SHGetFileInfo(SHGFI_DISPLAYNAME)
#   qtbase/src/widgets/dialogs/qwizard_win.cpp
#       no Aero glow (SetWindowThemeAttribute/DrawThemeTextEx) and no DWM
#       (DwmIsCompositionEnabled/DwmExtendFrameIntoClientArea/DwmDefWindowProc) on XP
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
diff --git a/qtbase/src/widgets/dialogs/qfilesystemmodel.cpp b/qtbase/src/widgets/dialogs/qfilesystemmodel.cpp
index 8cac500c2..1300f87e5 100644
--- a/qtbase/src/widgets/dialogs/qfilesystemmodel.cpp
+++ b/qtbase/src/widgets/dialogs/qfilesystemmodel.cpp
@@ -1787,8 +1787,19 @@ void QFileSystemModelPrivate::_q_directoryChanged(const QString &directory, cons
 #if defined(Q_OS_WIN) && !defined(Q_OS_WINRT)
 static QString volumeName(const QString &path)
 {
-    IShellItem *item = nullptr;
     const QString native = QDir::toNativeSeparators(path);
+#if defined(Q_CC_MINGW) && (_WIN32_WINNT < 0x0600)
+    // XP backport: SHCreateItemFromParsingName / IShellItem are Vista+. Use the
+    // pre-Vista SHGetFileInfo(SHGFI_DISPLAYNAME) to get the volume display name.
+    SHFILEINFO fi;
+    memset(&fi, 0, sizeof(fi));
+    if (SHGetFileInfo(reinterpret_cast<const wchar_t *>(native.utf16()), 0,
+                      &fi, sizeof(fi), SHGFI_DISPLAYNAME)) {
+        return QString::fromWCharArray(fi.szDisplayName);
+    }
+    return QString();
+#else
+    IShellItem *item = nullptr;
     HRESULT hr = SHCreateItemFromParsingName(reinterpret_cast<const wchar_t *>(native.utf16()),
                                              nullptr, IID_IShellItem,
                                              reinterpret_cast<void **>(&item));
@@ -1802,6 +1813,7 @@ static QString volumeName(const QString &path)
     CoTaskMemFree(name);
     item->Release();
     return result;
+#endif
 }
 #endif // Q_OS_WIN && !Q_OS_WINRT
 
