# Windows XP + universal binary: the Windows platform plugin (libqwindows).
#
# This is the core of the backport. Where a feature exists on both, the modern path
# is selected at RUNTIME (by OS version or by resolving the symbol), so one binary
# runs from Windows XP through Windows 11 without losing anything on modern Windows.
# Where a feature cannot exist on XP, it is guarded and degrades gracefully.
#
# Runtime-selected: file dialog (IFileDialog on Vista+, legacy dialog on XP), touch
# (Win7 WM_TOUCH resolved dynamically), tray icon (NOTIFYICON v4 on Vista+, legacy v3
# callbacks on XP), system fonts/DPI (modern path kept on Win11).
#
# Changes:
#   qtbase/src/plugins/platforms/windows/qwindowsdialoghelpers.cpp
#       compile both dialogs; pick IFileDialog vs legacy at runtime; resolve the Vista
#       shell functions dynamically
#   qtbase/src/plugins/platforms/windows/qwindowscontext.h
#       declare the dynamically resolved Win7 touch functions
#   qtbase/src/plugins/platforms/windows/qwindowscontext.cpp
#       resolve the touch functions; skip Vista+ power notifications; keep modern font
#       metrics on Win11
#   qtbase/src/plugins/platforms/windows/qwindowsmousehandler.cpp
#       WM_TOUCH path via the resolved functions; no touch device on XP
#   qtbase/src/plugins/platforms/windows/qwindowswindow.cpp
#       touch window registration via the resolved functions; DWM blur/composition/dark
#       border compiled out on XP
#   qtbase/src/plugins/platforms/windows/qwindowssystemtrayicon.cpp
#       legacy v3 tray callbacks on XP (modern v4 kept on Vista+); no
#       Shell_NotifyIconGetRect/ChangeWindowMessageFilterEx on XP
#   qtbase/src/plugins/platforms/windows/qwindowstheme.cpp
#       SHGetStockIconInfo (Vista+) -> shell32 resource / LoadIcon fallback
#   qtbase/src/plugins/platforms/windows/qwindowsbackingstore.cpp
#       UpdateLayeredWindowIndirect is unreliable on XP -> classic UpdateLayeredWindow
#       (fixes shaped/translucent windows)
#   qtbase/src/plugins/platforms/direct2d/qwindowsdirect2dwindow.cpp
#       the same for the Direct2D plugin, which only the arm64 toolchain builds
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
