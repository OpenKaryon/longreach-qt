#
# Windows XP: qtscxml builds without the QML dependency.
#
# The static XP build has no QML module, so the QML-dependent part of qtscxml must not
# be built.
#
# Changes:
#   qtscxml/src/scxml/scxml.pro
#       only require QML when it is available
#
# Apply: git apply, from the Qt source root (qt-everywhere-src-5.15.19/)
diff --git a/qtscxml/src/scxml/scxml.pro b/qtscxml/src/scxml/scxml.pro
index fe55769b0..d25ef1238 100644
--- a/qtscxml/src/scxml/scxml.pro
+++ b/qtscxml/src/scxml/scxml.pro
@@ -43,16 +43,18 @@ SOURCES += \
     qscxmltabledata.cpp \
     qscxmlstatemachineinfo.cpp
 
-qtConfig(scxml-ecmascriptdatamodel) {
-    QT += qml-private
+qtHaveModule(qml) {
+    qtConfig(scxml-ecmascriptdatamodel) {
+        QT += qml-private
 
-    HEADERS += \
-        qscxmlecmascriptdatamodel.h \
-        qscxmlecmascriptplatformproperties_p.h
+        HEADERS += \
+            qscxmlecmascriptdatamodel.h \
+            qscxmlecmascriptplatformproperties_p.h
 
-    SOURCES += \
-        qscxmlecmascriptdatamodel.cpp \
-        qscxmlecmascriptplatformproperties.cpp
+        SOURCES += \
+            qscxmlecmascriptdatamodel.cpp \
+            qscxmlecmascriptplatformproperties.cpp
+    }
 }
 
 load(qt_module)
