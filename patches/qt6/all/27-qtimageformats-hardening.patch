#
# Qt Image Formats: hardening of the TIFF and ICNS readers Qt made after
# 6.8.5, from Qt's 6.12 branch (https://github.com/qt/qtimageformats, all
# marked Pick-to: 6.8):
#   8ad2b3812c QTiffHandler: fix nullptr deref on read() after certain failed read()s
#   672cc69be9 Harden the icns handler
#   627c5880c7 Harden tiff handler: only the reading side (planar files rejected
#              on the direct-read path, the image zero-filled before partial
#              scanlines or tiles) and the empty colour table when writing
# Applies to pristine Qt 6.8.5.
diff --git a/qtimageformats/src/plugins/imageformats/icns/qicnshandler.cpp b/qtimageformats/src/plugins/imageformats/icns/qicnshandler.cpp
index 501394dee..425dd2ace 100644
--- a/qtimageformats/src/plugins/imageformats/icns/qicnshandler.cpp
