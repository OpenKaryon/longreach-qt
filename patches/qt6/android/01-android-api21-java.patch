+    private static boolean is64BitProcess()
+    {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M)
+            return Process.is64Bit();
+
+        // API21 already has the VMRuntime implementation used by the later public API.
+        // Device ABIs alone cannot identify a 32-bit process on a 64-bit device.
+        try {
+            Class<?> runtimeClass = Class.forName("dalvik.system.VMRuntime");
+            Object runtime = runtimeClass.getDeclaredMethod("getRuntime").invoke(null);
+            return (Boolean) runtimeClass.getDeclaredMethod("is64Bit").invoke(runtime);
+        } catch (ReflectiveOperationException error) {
+            throw new IllegalStateException("Could not determine Android process ABI", error);
+        }
+    }
