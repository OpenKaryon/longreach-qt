Subject: Preserve effective proxy and PAC queries on Android API21

--- a/qtbase/src/network/android/jar/src/org/qtproject/qt/android/network/QtNetwork.java
+++ b/qtbase/src/network/android/jar/src/org/qtproject/qt/android/network/QtNetwork.java
@@ -57,8 +57,20 @@
 
     static ProxyInfo getProxyInfo(final Context context)
     {
-        if (m_proxyInfo == null)
-            m_proxyInfo = (ProxyInfo)getConnectivityManager(context).getDefaultProxy();
+        if (m_proxyInfo == null) {
+            ConnectivityManager manager = getConnectivityManager(context);
+            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {
+                m_proxyInfo = manager.getDefaultProxy();
+            } else {
+                // API21/22 expose the effective ProxyInfo (including PAC) through
+                // the public runtime method getProxy(), hidden from SDK stubs.
+                try {
+                    m_proxyInfo = (ProxyInfo) ConnectivityManager.class.getMethod("getProxy").invoke(manager);
+                } catch (ReflectiveOperationException error) {
+                    android.util.Log.w(LOG_TAG, "Could not query the legacy Android proxy", error);
+                }
+            }
+        }
         return m_proxyInfo;
     }
 }
