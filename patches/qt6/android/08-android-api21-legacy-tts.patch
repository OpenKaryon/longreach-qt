+    // Old engines such as API21 Pico support language selection but cannot
+    // enumerate Voice objects. Expose one logical default voice per supported
+    // locale, using the same getName/getLocale adapter consumed by C++.
+    private static class LegacyVoice {
+        private final Locale mLocale;
+        LegacyVoice(Locale locale) { mLocale = locale; }
+        public String getName() { return "default:" + mLocale.toString(); }
+        public Locale getLocale() { return mLocale; }
+    }
+
+    private List<Object> legacyVoices()
+    {
+        if (mLegacyVoices == null) {
+            mLegacyVoices = new ArrayList<Object>();
+            for (Locale locale : Locale.getAvailableLocales()) {
+                if (!locale.getVariant().isEmpty())
+                    continue;
+                int support = mTts.isLanguageAvailable(locale);
+                int required = locale.getCountry().isEmpty()
+                        ? TextToSpeech.LANG_AVAILABLE : TextToSpeech.LANG_COUNTRY_AVAILABLE;
+                if (support >= required)
+                    mLegacyVoices.add(new LegacyVoice(locale));
+            }
+        }
+        return new ArrayList<Object>(mLegacyVoices);
+    }
+
+    private List<Locale> legacyLocales()
+    {
+        ArrayList<Locale> locales = new ArrayList<Locale>();
+        for (Object voice : legacyVoices())
+            locales.add(((LegacyVoice) voice).getLocale());
+        return locales;
+    }
