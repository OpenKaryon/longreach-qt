 #include <QtCore/qcoreapplication.h>
 #include <QtCore/qoperatingsystemversion.h>
+#include <QtCore/qmutex.h>
+#include <limits>
 
 QT_BEGIN_NAMESPACE
 
 static jclass g_qtSpeechClass = 0;
 
-typedef QMap<jlong, QTextToSpeechEngineAndroid *> TextToSpeechMap;
-Q_GLOBAL_STATIC(TextToSpeechMap, textToSpeechMap)
+struct TextToSpeechRegistry
+{
+    QMutex mutex;
+    QMap<jlong, QTextToSpeechEngineAndroid *> objects;
+    jlong nextId = 0;
+};
+Q_GLOBAL_STATIC(TextToSpeechRegistry, textToSpeechRegistry)
+
+static jlong registerTextToSpeech(QTextToSpeechEngineAndroid *tts)
+{
+    QMutexLocker locker(&textToSpeechRegistry->mutex);
+    if (textToSpeechRegistry->nextId == std::numeric_limits<jlong>::max())
+        qFatal("Android text-to-speech identifier exhausted");
+    const jlong id = ++textToSpeechRegistry->nextId;
+    textToSpeechRegistry->objects.insert(id, tts);
+    return id;
+}
+
+template <typename Function>
+static void dispatchTextToSpeech(jlong id, Function function)
+{
+    QMutexLocker locker(&textToSpeechRegistry->mutex);
+    auto *tts = textToSpeechRegistry->objects.value(id, nullptr);
+    if (!tts)
+        return;
+
+    // Enqueue while the registry protects the receiver's lifetime. Never run
+    // an initialization callback inline before its Java constructor returns.
+    QMetaObject::invokeMethod(tts, [tts, function] { function(tts); }, Qt::QueuedConnection);
+}
 
