+bool QTextToSpeechEngineAndroid::acceptRequestGeneration(jlong generation, bool terminal)
+{
+    if (generation != m_requestGeneration)
+        return false;
+    if (terminal)
+        nextRequestGeneration();
+    return true;
+}
+
+jlong QTextToSpeechEngineAndroid::nextRequestGeneration()
+{
+    if (m_requestGeneration == std::numeric_limits<jlong>::max())
+        qFatal("Android text-to-speech request generation exhausted");
+    return ++m_requestGeneration;
+}
