#
# macOS before 10.15: camera discovery without AVCaptureDeviceDiscoverySession
# (the default camera first, as the newer path does), and Metal frame capture
# only where it exists.
#
diff --git a/qtmultimedia/src/multimedia/darwin/qavfvideodevices.mm b/qtmultimedia/src/multimedia/darwin/qavfvideodevices.mm
--- a/qtmultimedia/src/multimedia/darwin/qavfvideodevices.mm
+++ b/qtmultimedia/src/multimedia/darwin/qavfvideodevices.mm
@@ -31,6 +31,9 @@
 // Thread-safe
 [[nodiscard]] QList<AVCaptureDevice*> qEnumerateAVCaptureDevices()
 {
+#ifdef Q_OS_MACOS
+    if (@available(macOS 10.15, *)) {
+#endif
     // List of all capture device types that we want to discover. Seems that this is the
     // only way to discover all types. This filter is mandatory and has no "unspecified"
     // option like AVCaptureDevicePosition(Unspecified) has. Order of the list is important
@@ -78,6 +81,21 @@
     for (AVCaptureDevice* device in discoverySession.devices)
         avCaptureDevices.push_back(device);
     return avCaptureDevices;
+#ifdef Q_OS_MACOS
+    } else {
+        // Discovery sessions were introduced on macOS after High Sierra.
+        // Keep the system's default camera first, as the newer path does.
+        QList<AVCaptureDevice *> devices;
+        AVCaptureDevice *defaultDevice = [AVCaptureDevice defaultDeviceWithMediaType:AVMediaTypeVideo];
+        if (defaultDevice)
+            devices.push_back(defaultDevice);
+        for (AVCaptureDevice *device in [AVCaptureDevice devicesWithMediaType:AVMediaTypeVideo]) {
+            if (!defaultDevice || ![device.uniqueID isEqualToString:defaultDevice.uniqueID])
+                devices.push_back(device);
+        }
+        return devices;
+    }
+#endif
 }
 
 // Given a list of AVCaptureDevices, returns a list of all the QCameraDevices
diff --git a/qtmultimedia/src/plugins/multimedia/darwin/camera/qavfcamerabase.mm b/qtmultimedia/src/plugins/multimedia/darwin/camera/qavfcamerabase.mm
--- a/qtmultimedia/src/plugins/multimedia/darwin/camera/qavfcamerabase.mm
+++ b/qtmultimedia/src/plugins/multimedia/darwin/camera/qavfcamerabase.mm
@@ -96,6 +96,28 @@
 }
 
 #endif // defined(Q_OS_IOS)
+
+bool qt_flash_available(AVCaptureDevice *captureDevice)
+{
+#ifdef Q_OS_MACOS
+    if (@available(macOS 10.15, *))
+        return [captureDevice isFlashAvailable];
+    return captureDevice.hasFlash;
+#else
+    return [captureDevice isFlashAvailable];
+#endif
+}
+
+bool qt_torch_available(AVCaptureDevice *captureDevice)
+{
+#ifdef Q_OS_MACOS
+    if (@available(macOS 10.15, *))
+        return [captureDevice isTorchAvailable];
+    return captureDevice.hasTorch;
+#else
+    return [captureDevice isTorchAvailable];
+#endif
+}
 
 } // Unnamed namespace.
 
@@ -631,7 +653,7 @@
     // AVCaptureDevice's docs:
     // "The flash may become unavailable if, for example,
     //  the device overheats and needs to cool off."
-    return [captureDevice isFlashAvailable];
+    return qt_flash_available(captureDevice);
 }
 
