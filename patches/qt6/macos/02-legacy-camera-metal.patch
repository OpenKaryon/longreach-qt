@@ -704,7 +726,15 @@
         return false;
 
     AVCaptureDevice *captureDevice = device();
-    return captureDevice && [captureDevice isExposureModeSupported:AVCaptureExposureModeCustom];
+    if (!captureDevice)
+        return false;
+#ifdef Q_OS_MACOS
+    if (@available(macOS 10.15, *))
+        return [captureDevice isExposureModeSupported:AVCaptureExposureModeCustom];
+    return false;
+#else
+    return [captureDevice isExposureModeSupported:AVCaptureExposureModeCustom];
+#endif
 }
 
