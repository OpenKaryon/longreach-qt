#
# macOS before 10.14: QtCore provides the C++17 aligned operator new/delete
# (the build passes -faligned-allocation), which 10.13's libc++ lacks.
#
diff --git a/qtbase/src/corelib/global/qmalloc.cpp b/qtbase/src/corelib/global/qmalloc.cpp
index d413a35..15994ab 100644
--- a/qtbase/src/corelib/global/qmalloc.cpp
+++ b/qtbase/src/corelib/global/qmalloc.cpp
@@ -6,6 +6,7 @@
 
 #include <stdlib.h>
 #include <string.h>
+#include <new>
 
 /*
     Define the container allocation functions in a separate file, so that our
@@ -77,3 +78,49 @@ void qFreeAligned(void *ptr)
 }
 
 QT_END_NAMESPACE
+
+#if defined(Q_OS_MACOS) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101400
+// macOS before 10.14 has no libc++ aligned new/delete. The build enables
+// -faligned-allocation and provides these C++17 operators in QtCore instead.
+static void *qtMacAlignedAllocate(size_t size, std::align_val_t alignment) noexcept
+{
+    size_t align = static_cast<size_t>(alignment);
+    if (align < sizeof(void *))
+        align = sizeof(void *);
+    void *ptr = nullptr;
+    if (posix_memalign(&ptr, align, size ? size : 1) != 0)
+        return nullptr;
+    return ptr;
+}
+
+void *operator new(size_t size, std::align_val_t alignment)
+{
+    if (void *ptr = qtMacAlignedAllocate(size, alignment))
+        return ptr;
+    throw std::bad_alloc();
+}
+
+void *operator new[](size_t size, std::align_val_t alignment)
+{
+    if (void *ptr = qtMacAlignedAllocate(size, alignment))
+        return ptr;
+    throw std::bad_alloc();
+}
+
+void *operator new(size_t size, std::align_val_t alignment, const std::nothrow_t &) noexcept
+{
+    return qtMacAlignedAllocate(size, alignment);
+}
+
+void *operator new[](size_t size, std::align_val_t alignment, const std::nothrow_t &) noexcept
+{
+    return qtMacAlignedAllocate(size, alignment);
+}
+
+void operator delete(void *ptr, std::align_val_t) noexcept { free(ptr); }
+void operator delete[](void *ptr, std::align_val_t) noexcept { free(ptr); }
+void operator delete(void *ptr, size_t, std::align_val_t) noexcept { free(ptr); }
+void operator delete[](void *ptr, size_t, std::align_val_t) noexcept { free(ptr); }
+void operator delete(void *ptr, std::align_val_t, const std::nothrow_t &) noexcept { free(ptr); }
+void operator delete[](void *ptr, std::align_val_t, const std::nothrow_t &) noexcept { free(ptr); }
+#endif
