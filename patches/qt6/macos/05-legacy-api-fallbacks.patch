diff --git a/qtbase/src/corelib/io/qfilesystemengine_unix.cpp b/qtbase/src/corelib/io/qfilesystemengine_unix.cpp
--- a/qtbase/src/corelib/io/qfilesystemengine_unix.cpp
+++ b/qtbase/src/corelib/io/qfilesystemengine_unix.cpp
@@ -124,9 +124,23 @@
 
     if (suffix.length() > 0) {
         // First step: is it a bundle?
+#ifdef Q_OS_MACOS
+        if (__builtin_available(macOS 11.0, *)) {
+#endif
         const auto *utType = [UTType typeWithFilenameExtension:suffix.toNSString()];
         if ([utType conformsToType:UTTypeBundle])
             return true;
+#ifdef Q_OS_MACOS
+        } else {
+            // UniformTypeIdentifiers is new in macOS 11. CoreServices has
+            // the same bundle-conformance query on older systems.
+            QCFType<CFStringRef> extension = suffix.toCFString();
+            QCFType<CFStringRef> legacyType = UTTypeCreatePreferredIdentifierForTag(
+                    kUTTagClassFilenameExtension, extension, nullptr);
+            if (legacyType && UTTypeConformsTo(legacyType, kUTTypeBundle))
+                return true;
+        }
+#endif
 
         // Second step: check if an application knows the package type
         QCFType<CFStringRef> path = entry.filePath().toCFString();
