#
# macOS before 12: CVBufferGetAttachment with a retain, keeping the result
# contract of CVBufferCopyAttachment (12).
#
diff --git a/qtmultimedia/src/multimedia/darwin/qavfhelpers.mm b/qtmultimedia/src/multimedia/darwin/qavfhelpers.mm
--- a/qtmultimedia/src/multimedia/darwin/qavfhelpers.mm
+++ b/qtmultimedia/src/multimedia/darwin/qavfhelpers.mm
@@ -13,5 +13,16 @@ namespace {
 using PixelFormat = QVideoFrameFormat::PixelFormat;
 using ColorRange = QVideoFrameFormat::ColorRange;
 
+// CVBufferCopyAttachment was introduced in macOS 12. Preserve its retained
+// result contract when using the older CVBufferGetAttachment on macOS 11.
+CFTypeRef copyBufferAttachment(CVBufferRef buffer, CFStringRef key)
+{
+    if (@available(macOS 12.0, *))
+        return CVBufferCopyAttachment(buffer, key, nullptr);
+    if (auto attachment = CVBufferGetAttachment(buffer, key, nullptr))
+        return CFRetain(attachment);
+    return nullptr;
+}
+
 // clang-format off
 constexpr std::tuple<CvPixelFormat, PixelFormat, ColorRange> PixelFormatMap[] = {
@@ -87,5 +98,5 @@ QVideoFrameFormat QAVFHelpers::videoFormatForImageBuffer(CVImageBufferRef buf
     auto colorTransfer = QVideoFrameFormat::ColorTransfer_Unknown;
 
     if (auto cSpace =
-                QCFString(CVBufferCopyAttachment(buffer, kCVImageBufferYCbCrMatrixKey, nullptr))) {
+                QCFString(copyBufferAttachment(buffer, kCVImageBufferYCbCrMatrixKey))) {
         if (CFEqual(cSpace, kCVImageBufferYCbCrMatrix_ITU_R_709_2)) {
@@ -99,6 +110,6 @@ QVideoFrameFormat QAVFHelpers::videoFormatForImageBuffer(CVImageBufferRef buf
     }
 
     if (auto cTransfer = QCFString(
-                CVBufferCopyAttachment(buffer, kCVImageBufferTransferFunctionKey, nullptr))) {
+                copyBufferAttachment(buffer, kCVImageBufferTransferFunctionKey))) {
 
         using QCFNumber = QCFType<CFNumberRef>;
@@ -112,4 +123,4 @@ QVideoFrameFormat QAVFHelpers::videoFormatForImageBuffer(CVImageBufferRef buf
         } else if (CFEqual(cTransfer, kCVImageBufferTransferFunction_UseGamma)) {
             auto gamma =
-                    QCFNumber(CVBufferCopyAttachment(buffer, kCVImageBufferGammaLevelKey, nullptr));
+                    QCFNumber(copyBufferAttachment(buffer, kCVImageBufferGammaLevelKey));
             double g;
