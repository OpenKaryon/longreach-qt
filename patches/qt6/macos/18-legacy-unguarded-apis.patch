#
# macOS: guard the newer APIs that would crash below their macOS version.
#
# With a 10.13 deployment target the build reports 144 uses of APIs newer than
# 10.13 that no @available check guards (-Wunguarded-availability-new). Most
# are harmless: enum values and types that only exist at compile time, a class
# that is already behind an @available check further up, or a property of an
# object that only a guarded call can create. The ones below run on any macOS
# and fail there: a message to a selector the system does not have raises an
# exception, and a weakly linked constant or class is NULL.
#
#   qrhimetal.mm   MTLBinaryArchive (11), which Qt Quick's pipeline cache
#                  sets up on every start; GPUStartTime/GPUEndTime,
#                  MTLDevice.location, supportsFamily: and
#                  maximumPotentialExtendedDynamicRangeColorComponentValue
#                  (10.15); kCGColorSpaceExtendedLinearDisplayP3 (10.14.3),
#                  behind a check that only named iOS
#   qcocoafiledialoghelper.mm
#                  NSButton.hasDestructiveAction (11) in the replace alert
#   qtexttospeech_darwin.mm
#                  AVSpeechSynthesizer (10.14), whose speech rate constants
#                  prepareUtterance reads, and writeUtterance: (10.15)
#
# Below their version the Metal backend reports no GPU time and builds its
# pipelines without the binary archive, the alert's Replace button is an
# ordinary one, and the speech engine reports an error instead of speaking.
diff --git a/qtbase/src/gui/rhi/qrhimetal.mm b/qtbase/src/gui/rhi/qrhimetal.mm
--- a/qtbase/src/gui/rhi/qrhimetal.mm
+++ b/qtbase/src/gui/rhi/qrhimetal.mm
@@ -522,24 +522,38 @@ id<MTLCommandBuffer> QRhiMetalData::newCommandBuffer()
 #endif
 }
 
+// The GPU time of a completed command buffer. GPUStartTime and GPUEndTime are
+// macOS 10.15; below it there is no GPU time to report.
+static inline double qrhimtl_gpuTime(id<MTLCommandBuffer> cb)
+{
+    if (@available(macOS 10.15, *))
+        return cb.GPUEndTime - cb.GPUStartTime;
+    return 0;
+}
+
 bool QRhiMetalData::setupBinaryArchive(NSURL *sourceFileUrl)
 {
 #ifdef QRHI_METAL_DISABLE_BINARY_ARCHIVE
     return false;
 #endif
 
-    [binArch release];
-    MTLBinaryArchiveDescriptor *binArchDesc = [MTLBinaryArchiveDescriptor new];
-    binArchDesc.url = sourceFileUrl;
-    NSError *err = nil;
-    binArch = [dev newBinaryArchiveWithDescriptor: binArchDesc error: &err];
-    [binArchDesc release];
-    if (!binArch) {
-        const QString msg = QString::fromNSString(err.localizedDescription);
-        qWarning("newBinaryArchiveWithDescriptor failed: %s", qPrintable(msg));
-        return false;
+    // MTLBinaryArchive is macOS 11: below it binArch stays nil, which every
+    // user of it checks, and pipelines are built without the cache.
+    if (@available(macOS 11.0, iOS 14.0, *)) {
+        [binArch release];
+        MTLBinaryArchiveDescriptor *binArchDesc = [MTLBinaryArchiveDescriptor new];
+        binArchDesc.url = sourceFileUrl;
+        NSError *err = nil;
+        binArch = [dev newBinaryArchiveWithDescriptor: binArchDesc error: &err];
+        [binArchDesc release];
+        if (!binArch) {
+            const QString msg = QString::fromNSString(err.localizedDescription);
+            qWarning("newBinaryArchiveWithDescriptor failed: %s", qPrintable(msg));
+            return false;
+        }
+        return true;
     }
-    return true;
+    return false;
 }
 
