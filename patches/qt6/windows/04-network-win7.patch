#
# Qt 6.8.5 Windows 7: resolve DnsQueryEx at run time and use DnsQuery_W
# for standard DNS on older Windows. Keep Qt's DNS-over-TLS transport and
# TLSA record decoding unchanged on every supported Windows version.
# The legacy standard-DNS API rejects IPv6 servers and nonstandard ports
# explicitly instead of silently querying a different endpoint.
#
# Legacy API approach derived from crystalidea/qt6windows7, commit
# 3df3aac758177b28843c4d1511a2bd7751fe82b6; adapted around the pristine
# Qt 6.8.5 protocol dispatch rather than replacing the modern backend.
# Applies from the root of qt-everywhere-src-6.8.5 with patch -p1.
#
--- a/qtbase/src/network/kernel/qdnslookup_win.cpp
+++ b/qtbase/src/network/kernel/qdnslookup_win.cpp
@@ -144,9 +144,31 @@
     results.Version = 1;
     DNS_STATUS status = ERROR_INVALID_PARAMETER;
     switch (protocol) {
-    case QDnsLookup::Standard:
-        status = DnsQueryEx(&request, &results, nullptr);
+    case QDnsLookup::Standard: {
+        using DnsQueryExFunction = DNS_STATUS (WINAPI *)(PDNS_QUERY_REQUEST,
+                                                       PDNS_QUERY_RESULT, PDNS_QUERY_CANCEL);
+        static const auto queryEx = reinterpret_cast<DnsQueryExFunction>(
+                GetProcAddress(GetModuleHandleW(L"dnsapi.dll"), "DnsQueryEx"));
+        if (queryEx) {
+            status = queryEx(&request, &results, nullptr);
+        } else {
+            // Windows 7's API accepts only IPv4 nameservers and port 53.
+            // DoT never takes this fallback: it retains sendAlternate() below.
+            if (port != DnsPort || (!nameserver.isNull()
+                    && nameserver.protocol() != QAbstractSocket::IPv4Protocol)) {
+                return reply->makeResolverSystemError(ERROR_NOT_SUPPORTED);
+            }
+            IP4_ARRAY servers = {};
+            if (!nameserver.isNull()) {
+                servers.AddrCount = 1;
+                servers.AddrArray[0] = htonl(nameserver.toIPv4Address());
+            }
+            status = DnsQuery_W(request.QueryName, request.QueryType, DNS_QUERY_STANDARD,
+                                nameserver.isNull() ? nullptr : &servers,
+                                &results.pQueryRecords, nullptr);
+        }
         break;
+    }
     case QDnsLookup::DnsOverTls:
         status = sendAlternate(this, reply, &request, &results);
         break;
