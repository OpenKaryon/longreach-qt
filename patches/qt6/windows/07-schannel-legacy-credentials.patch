#
# Qt 6.8.4 Windows 7: Schannel credentials that Windows 7 accepts.
#
# Qt 6 always passes SCH_CREDENTIALS to AcquireCredentialsHandle. That
# structure arrived with Windows 10 1809; Windows 7 SP1 answers it with
# SEC_E_UNKNOWN_CREDENTIALS ("The credentials were not recognized"), so every
# TLS client and server failed on the first Windows 7 run (2026-10-04). Before build 17763
# this passes the older SCHANNEL_CRED with the same certificate, protocols
# and revocation flags. A restricted cipher list is not applied on that path.
# Applies from the root of qt-everywhere-src-6.8.4 with patch -p1.
diff --git a/qtbase/src/plugins/tls/schannel/qtls_schannel.cpp b/qtbase/src/plugins/tls/schannel/qtls_schannel.cpp
index 9d14ed5..aa7893f 100644
--- a/qtbase/src/plugins/tls/schannel/qtls_schannel.cpp
+++ b/qtbase/src/plugins/tls/schannel/qtls_schannel.cpp
@@ -1152,12 +1152,29 @@ bool TlsCryptographSchannel::acquireCredentialsHandle()
         &tlsParameters
     };
 
+    // Windows 7 backport: SCH_CREDENTIALS exists from Windows 10 1809 (build
+    // 17763) on. Older Schannel rejects it with SEC_E_UNKNOWN_CREDENTIALS, on the
+    // client as on the server. Those versions take SCHANNEL_CRED, which lists the
+    // enabled protocols instead of the disabled ones. It has no counterpart of the
+    // CRYPTO_SETTINGS list above, so a restricted cipher list is not enforced
+    // there, and TLS 1.3 does not exist before Windows 11.
+    SCHANNEL_CRED legacyCredentials = {};
+    legacyCredentials.dwVersion = SCHANNEL_CRED_VERSION;
+    legacyCredentials.cCreds = certsCount;
+    legacyCredentials.paCred = &localCertificate;
+    legacyCredentials.grbitEnabledProtocols = protocols & ~DWORD(SP_PROT_TLS1_3);
+    legacyCredentials.dwFlags = SCH_CRED_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT | defaultCredsFlag();
+    const bool useLegacyCredentials = QOperatingSystemVersion::current()
+            < QOperatingSystemVersion(QOperatingSystemVersion::Windows, 10, 0, 17763);
+
     TimeStamp expiration{};
     auto status = AcquireCredentialsHandle(nullptr, // pszPrincipal (unused)
                                            const_cast<wchar_t *>(UNISP_NAME), // pszPackage
                                            isClient ? SECPKG_CRED_OUTBOUND : SECPKG_CRED_INBOUND, // fCredentialUse
                                            nullptr, // pvLogonID (unused)
-                                           &credentials, // pAuthData
+                                           useLegacyCredentials
+                                                   ? static_cast<void *>(&legacyCredentials)
+                                                   : static_cast<void *>(&credentials), // pAuthData
                                            nullptr, // pGetKeyFn (unused)
                                            nullptr, // pvGetKeyArgument (unused)
                                            &credentialHandle, // phCredential
