#
# Windows 7 headers: MF_MT_VIDEO_ROTATION defined locally; when the attribute
# is absent MFGetAttributeUINT32 returns the default.
#
diff --git a/qtmultimedia/src/plugins/multimedia/windows/evr/evrcustompresenter.cpp b/qtmultimedia/src/plugins/multimedia/windows/evr/evrcustompresenter.cpp
--- a/qtmultimedia/src/plugins/multimedia/windows/evr/evrcustompresenter.cpp
+++ b/qtmultimedia/src/plugins/multimedia/windows/evr/evrcustompresenter.cpp
@@ -24,6 +24,11 @@
 #include <evcode.h>
 
 QT_BEGIN_NAMESPACE
+
+// MF_MT_VIDEO_ROTATION is hidden by Windows 7 headers. Its value is a media
+// type attribute GUID. If absent, MFGetAttributeUINT32 returns the default.
+static const GUID qMfMtVideoRotation = { 0xc380465d, 0x2271, 0x428c,
+                                         { 0x9b, 0x83, 0xec, 0xea, 0x3b, 0x4a, 0x85, 0xc1 } };
 
 static Q_LOGGING_CATEGORY(qLcEvrCustomPresenter, "qt.multimedia.evrcustompresenter")
 
@@ -1785,16 +1790,15 @@
     QtVideo::Rotation rotation = [&] {
         ComPtr<IMFMediaType> inputStreamType;
         if (SUCCEEDED(m_mixer->GetInputCurrentType(0, inputStreamType.GetAddressOf()))) {
-            auto rotation = static_cast<MFVideoRotationFormat>(
-                    MFGetAttributeUINT32(inputStreamType.Get(), MF_MT_VIDEO_ROTATION, 0));
+            const UINT32 rotation = MFGetAttributeUINT32(inputStreamType.Get(), qMfMtVideoRotation, 0);
             switch (rotation) {
-            case MFVideoRotationFormat_90:
+            case 90:
                 return QtVideo::Rotation::Clockwise90;
-            case MFVideoRotationFormat_180:
+            case 180:
                 return QtVideo::Rotation::Clockwise180;
-            case MFVideoRotationFormat_270:
+            case 270:
                 return QtVideo::Rotation::Clockwise270;
-            case MFVideoRotationFormat_0:
+            case 0:
             default:
                 return QtVideo::Rotation::None;
             }
