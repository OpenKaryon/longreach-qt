# Keep the Windows 10 ARM64 headers consistent with the UCRT toolchain.
# The x86/x64 profiles still enforce Windows 7 headers.
--- a/qtbase/cmake/QtBaseConfigureTests.cmake
+++ b/qtbase/cmake/QtBaseConfigureTests.cmake
@@ -161,6 +161,12 @@
     # The strict Windows 7 probe compiles Qt itself against the Windows 7
     # header surface, instead of only lowering the exported SDK definitions.
-    list(APPEND QT_PLATFORM_DEFINITIONS
-        _WIN32_WINNT=0x0601 WINVER=0x0601 _WIN32_IE=0x0800 NTDDI_VERSION=0x06010000)
+    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" qt_target_processor)
+    if(qt_target_processor MATCHES "^(arm64|aarch64)$")
+        list(APPEND QT_PLATFORM_DEFINITIONS
+            _WIN32_WINNT=0x0A00 WINVER=0x0A00 _WIN32_IE=0x0A00 NTDDI_VERSION=0x0A000000)
+    else()
+        list(APPEND QT_PLATFORM_DEFINITIONS
+            _WIN32_WINNT=0x0601 WINVER=0x0601 _WIN32_IE=0x0800 NTDDI_VERSION=0x06010000)
+    endif()
     set(QT_PLATFORM_DEFINITIONS ${QT_PLATFORM_DEFINITIONS}
         CACHE STRING "Qt platform specific pre-processor defines" FORCE)
