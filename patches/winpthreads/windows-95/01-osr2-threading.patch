+/* This internal waiter-count lock is never acquired recursively. Keep
+ * try-lock nonblocking even while another thread holds the gate semaphore. */
+static int try_waiters_lock (volatile LONG *lock)
+{
+  return InterlockedExchange (lock, 1) == 0;
+}
+
+static void take_waiters_lock (volatile LONG *lock)
+{
+  while (!try_waiters_lock (lock))
+    Sleep (0);
+}
+
+static void release_waiters_lock (volatile LONG *lock)
+{
+  InterlockedExchange (lock, 0);
+}
