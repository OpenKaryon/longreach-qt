+static BOOL valid_join_handle (HANDLE handle)
+{
+  /* Win95 exports GetHandleInformation but does not implement it for
+     thread handles. A zero-time wait validates both running and exited
+     threads without changing their state. */
+  if (handle == NULL || handle == INVALID_HANDLE_VALUE)
+    return FALSE;
+  DWORD result = WaitForSingleObject (handle, 0);
+  return result == WAIT_OBJECT_0 || result == WAIT_TIMEOUT;
+}
