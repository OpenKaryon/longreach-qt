get_filename_component(LONGREACH_QT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
if(EXISTS "${LONGREACH_QT_PREFIX}/longreach-target.cmake")
    include("${LONGREACH_QT_PREFIX}/longreach-target.cmake")
else()
    # Retain compatibility with existing x86_64/API21 SDK images.
    set(LONGREACH_ANDROID_API 21)
    set(LONGREACH_ANDROID_RUNTIME /opt/longreach-android-api21)
endif()
if(LONGREACH_ANDROID_API EQUAL 21)
    include("${LONGREACH_ANDROID_RUNTIME}/toolchain.cmake")
else()
    # Version 1 reserves externally managed Android toolchains in CMake.
    set(CMAKE_SYSTEM_NAME Android)
    set(CMAKE_SYSTEM_VERSION 1)
    set(CMAKE_SYSTEM_PROCESSOR i686)
    set(CMAKE_ANDROID_ARCH_ABI "${LONGREACH_ANDROID_ABI}")
    set(CMAKE_ANDROID_API "${LONGREACH_ANDROID_API}")
    set(ANDROID_ABI "${LONGREACH_ANDROID_ABI}")
    set(ANDROID_PLATFORM "android-${LONGREACH_ANDROID_API}")
    set(ANDROID_NDK "${LONGREACH_ANDROID_RUNTIME}/ndk")
    set(CMAKE_C_COMPILER "${LONGREACH_ANDROID_RUNTIME}/bin/cc")
    set(CMAKE_CXX_COMPILER "${LONGREACH_ANDROID_RUNTIME}/bin/cxx")
    set(CMAKE_AR /usr/bin/llvm-ar-21)
    set(CMAKE_RANLIB /usr/bin/llvm-ranlib-21)
    set(CMAKE_STRIP /usr/bin/llvm-strip-21)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    set(THREADS_PREFER_PTHREAD_FLAG TRUE)
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_CXX_FLAGS_INIT} -DQT_NO_SHAREDMEMORY -DQT_NO_SYSTEMSEMAPHORE")
get_filename_component(LONGREACH_QT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(CMAKE_FIND_ROOT_PATH "${LONGREACH_ANDROID_RUNTIME}/sysroot" "${LONGREACH_QT_PREFIX}")
list(PREPEND CMAKE_PREFIX_PATH "${LONGREACH_QT_PREFIX}")
set(QT_QMAKE_EXECUTABLE "${LONGREACH_QT_PREFIX}/bin/qmake" CACHE FILEPATH "Qt4 host qmake")
