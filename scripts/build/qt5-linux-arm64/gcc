# C for Ubuntu 14.04 arm64: Ubuntu 16.04's aarch64 GCC 5 with the 14.04
# sysroot. glibc's aarch64 symbols start at 2.17, so GCC 5's own static
# libstdc++ needs nothing 14.04's glibc 2.19 lacks (prepare checks it).
#
# The cross GCC also searches /usr/aarch64-linux-gnu, Ubuntu 16.04's own
# glibc 2.23 for arm64, ahead of the sysroot, which --sysroot does not change:
# -nostdinc and the sysroot's library directories first keep to 14.04's.
# /usr/local is searched as a native GCC searches it: the static xkbcommon and
# the stub archives are installed there.
sysroot=/work/sysroot
gcc=aarch64-linux-gnu-gcc-5
exec $gcc --sysroot="$sysroot" -nostdinc \
    -isystem "$($gcc -print-file-name=include)" -isystem "$($gcc -print-file-name=include-fixed)" \
    -isystem "$sysroot/usr/local/include" \
    -isystem "$sysroot/usr/include/aarch64-linux-gnu" -isystem "$sysroot/usr/include" \
    -B"$sysroot/usr/lib/aarch64-linux-gnu" \
    -L"$sysroot/usr/local/lib" -L"$sysroot/lib/aarch64-linux-gnu" -L"$sysroot/usr/lib/aarch64-linux-gnu" \
    -Wl,-rpath-link,"$sysroot/lib/aarch64-linux-gnu:$sysroot/usr/lib/aarch64-linux-gnu" "$@"
