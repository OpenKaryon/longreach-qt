set(CMAKE_SYSTEM_NAME Android)
# External LLVM driver, while Android platform metadata stays API21.
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR armv7-a)
set(CMAKE_ANDROID_ARCH_ABI armeabi-v7a)
set(CMAKE_ANDROID_API 21)
set(ANDROID_PLATFORM android-21)
set(ANDROID_NATIVE_API_LEVEL 21)
set(ANDROID_ABI armeabi-v7a)
set(ANDROID_NDK /opt/longreach-android-api21/ndk)
set(CMAKE_ANDROID_NDK "${ANDROID_NDK}")
set(CMAKE_ANDROID_NDK_VERSION 27.0.12077973)
set(ANDROID_NDK_HOST_SYSTEM_NAME linux-x86_64)
set(ANDROID_NDK_ROOT "${ANDROID_NDK}")
set(ANDROID_HOST_TAG linux-x86_64)
set(ANDROID_TOOLCHAIN_ROOT "${ANDROID_NDK}/toolchains/llvm/prebuilt/${ANDROID_HOST_TAG}")
# Publish the real sysroot for dependency discovery and APK metadata. The
# external compiler driver already supplies its compile/link --sysroot flags.
set(CMAKE_SYSROOT /opt/longreach-android-api21/sysroot)
set(CMAKE_SYSROOT_COMPILE "")
set(CMAKE_SYSROOT_LINK "")
set(ANDROID_SDK_ROOT /work/android-sdk CACHE PATH "")
set(ANDROID_SDK "${ANDROID_SDK_ROOT}" CACHE PATH "")
set(ANDROID_MIN_SDK_VERSION 21 CACHE STRING "")
set(ANDROID_TARGET_SDK_VERSION 21 CACHE STRING "")
set(ANDROID_STL c++_shared)
set(CMAKE_C_COMPILER /opt/longreach-android-api21/bin/cc)
set(CMAKE_CXX_COMPILER /opt/longreach-android-api21/bin/cxx)
set(CMAKE_AR /usr/bin/llvm-ar-21)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib-21)
set(CMAKE_STRIP /usr/bin/llvm-strip-21)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(THREADS_PREFER_PTHREAD_FLAG TRUE)
set(CMAKE_FIND_ROOT_PATH /opt/longreach-android-api21/sysroot /opt/qt6-android-armeabi-v7a-llvm)
set(CMAKE_LIBRARY_PATH /opt/longreach-android-api21/sysroot/usr/lib/arm-linux-androideabi/21)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
