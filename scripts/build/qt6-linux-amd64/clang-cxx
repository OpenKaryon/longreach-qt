exec /opt/llvm-19/bin/clang++ -Qunused-arguments --gcc-toolchain=/opt/rh/devtoolset-11/root/usr \
    -stdlib=libc++ -nostdinc++ \
    -isystem /opt/llvm-19/include/x86_64-unknown-linux-gnu/c++/v1 \
    -isystem /opt/llvm-19/include/c++/v1 \
    -L/opt/llvm-19/lib -L/opt/llvm-19/lib/x86_64-unknown-linux-gnu \
    --rtlib=compiler-rt --unwindlib=libunwind -fuse-ld=lld -Wl,--threads=2 "$@"
