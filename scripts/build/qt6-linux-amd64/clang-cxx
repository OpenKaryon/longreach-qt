llvm=${LLVM_ROOT:-/opt/llvm-21}
exec "$llvm/bin/clang++" -Qunused-arguments --gcc-toolchain=/opt/rh/devtoolset-11/root/usr \
    -stdlib=libc++ -nostdinc++ -isystem "$llvm/include/c++/v1" -L"$llvm/lib" \
    --rtlib=compiler-rt --unwindlib=libunwind -fuse-ld=lld -Wl,--threads=2 "$@"
