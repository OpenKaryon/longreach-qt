set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /opt/sysroot-arm64)
set(CMAKE_C_COMPILER /opt/longreach-llvm/bin/target-cc)
set(CMAKE_CXX_COMPILER /opt/longreach-llvm/bin/target-cxx)
set(CMAKE_ASM_COMPILER /opt/longreach-llvm/bin/target-cc)
foreach(language C CXX ASM)
    set(CMAKE_${language}_COMPILER_TARGET aarch64-unknown-linux-gnu)
endforeach()
foreach(tool AR RANLIB STRIP NM OBJCOPY OBJDUMP)
    string(TOLOWER "${tool}" program)
    set(CMAKE_${tool} "/opt/llvm-21/bin/llvm-${program}")
endforeach()
set(CMAKE_LINKER /opt/llvm-21/bin/ld.lld)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/local/lib/pkgconfig:${CMAKE_SYSROOT}/usr/lib64/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT} /opt/llvm-runtime-21 /opt/qt6-linux-arm64-llvm /opt/openssl-3)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
foreach(kind LIBRARY INCLUDE PACKAGE)
    set(CMAKE_FIND_ROOT_PATH_MODE_${kind} ONLY)
endforeach()
set(WaylandScanner_EXECUTABLE /opt/cross/bin/wayland-scanner CACHE FILEPATH "")
set(QT_FORCE_FIND_TOOLS ON)
