set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR @PROCESSOR@)
set(CMAKE_OSX_SYSROOT /opt/osxcross/target/SDK/MacOSX14.0.sdk CACHE PATH "Pinned macOS SDK" FORCE)
set(CMAKE_OSX_ARCHITECTURES @PROCESSOR@ CACHE STRING "Target architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET @VERSION@ CACHE STRING "Supported macOS floor" FORCE)
set(CMAKE_C_COMPILER /opt/longreach-llvm/bin/target-cc)
set(CMAKE_CXX_COMPILER /opt/longreach-llvm/bin/target-cxx)
set(CMAKE_ASM_COMPILER /opt/longreach-llvm/bin/target-cc)
set(CMAKE_OBJC_COMPILER /opt/longreach-llvm/bin/target-cc)
set(CMAKE_OBJCXX_COMPILER /opt/longreach-llvm/bin/target-cxx)
foreach(language C CXX ASM OBJC OBJCXX)
    set(CMAKE_${language}_COMPILER_TARGET @PROCESSOR@-apple-darwin23)
endforeach()
foreach(tool AR RANLIB STRIP NM OBJCOPY OBJDUMP)
    string(TOLOWER "${tool}" program)
    set(CMAKE_${tool} "/opt/llvm-21/bin/llvm-${program}")
endforeach()
set(CMAKE_LINKER /opt/llvm-21/bin/ld64.lld)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_OSX_SYSROOT}/usr/lib/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH ${CMAKE_OSX_SYSROOT} /opt/llvm-runtime-21 /opt/qt6-macos-@ARCH@-llvm)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
foreach(kind LIBRARY INCLUDE PACKAGE)
    set(CMAKE_FIND_ROOT_PATH_MODE_${kind} ONLY)
endforeach()
set(QT_FORCE_FIND_TOOLS ON)
